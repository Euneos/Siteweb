# Copier ce fichier en .env et coller le jeton fourni par Charly.
# Le .env n'est jamais envoye sur GitHub.
NOCODB_TOKEN=nc_pat_xxxxxxxxxxxxxxxxxxxx

# Calendriers de l'espace interne (bun scripts/calendrier.ts).
# Jeton Cloudflare limité à D1 (lecture + écriture), fourni par Charly.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# L'adresse de la personne qui utilise ce poste : elle signe les fiches.
EUNEOS_EMAIL=
# Adresses des responsables (validation des heures), séparées par des virgules.
EUNEOS_RESPONSABLES=
