---
import Brand from '../components/Brand.astro'
import '../styles/global.css'
import { internalEnvironment } from '../lib/internal-context'

interface Props {
  title: string
  current: 'calendrier' | 'suivi' | 'ressources' | 'catalogue' | 'implantations' | 'formulaires'
  identity: { email: string; admin: boolean }
  teamAccess?: boolean
}
const { title, current, identity, teamAccess = true } = Astro.props
const preview = internalEnvironment(Astro.locals).INTERNAL_WORKSPACE_PREVIEW === 'true'
const importPending = internalEnvironment(Astro.locals).INTERNAL_WORKSPACE_IMPORT_PENDING === 'true'
---

<!doctype html>
<html lang="fr" class="iw-document">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — EUNEOS</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#00382d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/OpenSans-latin-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="iw-body">
    <a class="skip-link" href="#main">Aller au contenu</a>
    <header class="iw-header">
      <div class="iw-header__inner">
        <a class="iw-logo" href="/" aria-label="EUNEOS — accueil du site"
          ><Brand name="wordmark" /></a
        >
        <span class="iw-header__label">Espace interne</span>
        <div class="iw-identity">
          <span class="iw-identity__dot" aria-hidden="true"></span><span
            ><span class="iw-identity__caption"
              >{identity.admin ? 'Compte responsable' : 'Compte connecté'}</span
            ><span class="iw-identity__email">{identity.email}</span></span
          >
        </div>
      </div>
    </header>
    <nav class="iw-nav" aria-label="Espace interne">
      <div class="iw-nav__inner">
        {
          teamAccess && (
            <a href="/interne" aria-current={current === 'calendrier' ? 'page' : undefined}>
              Calendriers de l’équipe
            </a>
          )
        }
        {
          teamAccess && (
            <a href="/etat-candidatures" aria-current={current === 'suivi' ? 'page' : undefined}>
              Suivi des établissements
            </a>
          )
        }
        {
          teamAccess && (
            <a
              href="/interne/implantations"
              aria-current={current === 'implantations' ? 'page' : undefined}
            >
              Implantations
            </a>
          )
        }
        {teamAccess && (
          <a href="/interne/formulaires" aria-current={current === 'formulaires' ? 'page' : undefined}>Formulaires</a>
        )}
        <a href="/interne/ressources" aria-current={current === 'ressources' ? 'page' : undefined}
          >Ressources formateurs</a
        >
        {
          identity.admin && (
            <a
              href="/interne/catalogue"
              aria-current={current === 'catalogue' ? 'page' : undefined}
            >
              Gérer les ressources
            </a>
          )
        }
        <a class="iw-nav__public" href="/">Voir le site <span aria-hidden="true">↗</span></a>
      </div>
    </nav>
    <main id="main" class="iw-main" tabindex="-1">
      {
        preview && (
          <aside class="iw-feedback" aria-label="Espace d’essai">
            <strong>Espace d’essai.</strong> Les calendriers et le catalogue sont en préparation.
            Gardez les saisies réelles dans Notion jusqu’à la bascule convenue avec l’équipe. Le
            suivi des établissements et la carte consultent la base EUNEOS en lecture seule.
          </aside>
        )
      }
      {
        !preview && importPending && (
          <aside class="iw-feedback" aria-label="Reprise de l’historique">
            <strong>Historique Notion à reprendre.</strong> Les anciennes fiches et leurs
            commentaires n’ont pas encore été importés. Les nouvelles fiches enregistrées
            dans cet espace sont conservées.
          </aside>
        )
      }
      <slot />
    </main>
    <footer class="iw-footer">
      {!teamAccess && <a href="/interne">Accès équipe EUNEOS</a>}
      <span>EUNEOS · Un espace pour travailler ensemble.</span><span
        >Accès réservé aux comptes autorisés.</span
      >
    </footer>
    <script src="../scripts/internal-workspace-client.ts"></script>
  </body>
</html>

<style is:global>
  /* The internal workspace keeps the brand tokens with a compact reading scale. */
  .iw-document {
    overflow-x: visible;
    background: var(--papier);
  }
  .iw-body {
    --iw-text: var(--t-bio);
    --iw-small: var(--t-note);
    --iw-line: #d1d9d5;
    --iw-muted: #454c49;
    background: var(--papier);
    font-size: var(--iw-text);
    line-height: 1.55;
  }
  .iw-body [hidden] {
    display: none !important;
  }
  .iw-body :is(h1, h2, h3, p) {
    margin: 0;
  }
  .iw-body h1 {
    font-size: var(--t-titre);
    color: var(--noir);
    line-height: 1.15;
  }
  .iw-body h2 {
    font-size: var(--t-carte);
    color: var(--noir);
    line-height: 1.3;
  }
  .iw-body h3 {
    font-size: var(--t-corps);
    color: var(--noir);
    line-height: 1.35;
  }
  .iw-body :is(button, input, select, textarea) {
    font: inherit;
  }
  .iw-body :is(button, a, input, select, textarea, summary):focus-visible {
    outline: 3px solid var(--vert);
    outline-offset: 3px;
  }
  .iw-body :is(button, a) {
    -webkit-tap-highlight-color: transparent;
  }
  .iw-body button {
    cursor: pointer;
  }
  .iw-body button:disabled {
    cursor: default;
    opacity: 0.55;
  }
  .iw-body a {
    text-underline-offset: 0.2em;
  }
  .iw-header {
    background: var(--vert);
    color: var(--blanc);
  }
  .iw-header__inner,
  .iw-nav__inner,
  .iw-main,
  .iw-footer {
    width: min(1440px, 100%);
    margin-inline: auto;
    padding-inline: var(--s-int);
  }
  .iw-header__inner {
    min-height: 96px;
    display: flex;
    align-items: center;
    gap: var(--s-lie);
    padding-block: 1rem;
  }
  .iw-logo {
    display: flex;
    align-items: center;
    width: 150px;
    min-height: 44px;
    flex-shrink: 0;
    color: white;
  }
  .iw-header__label {
    padding-left: var(--s-lie);
    border-left: 1px solid #809b96;
  }
  .iw-identity {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-left: auto;
    min-width: 0;
  }
  .iw-identity__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--jaune);
    flex-shrink: 0;
  }
  .iw-identity__caption {
    display: block;
    font-size: var(--iw-small);
  }
  .iw-identity__email {
    display: block;
    overflow-wrap: anywhere;
  }
  .iw-header a:focus-visible {
    outline-color: var(--jaune);
  }
  .iw-nav {
    background: white;
    border-bottom: 1px solid var(--iw-line);
  }
  .iw-nav__inner {
    display: flex;
    gap: var(--s-titre);
    flex-wrap: wrap;
  }
  .iw-nav a {
    min-height: 60px;
    padding-block: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }
  .iw-nav a[aria-current] {
    border-color: var(--vert);
    font-weight: 600;
  }
  .iw-nav a:hover {
    border-color: var(--jaune);
  }
  .iw-nav .iw-nav__public {
    margin-left: auto;
  }
  .iw-main {
    padding-block: var(--s-titre) var(--s-bloc);
  }
  .iw-intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-lie);
    margin-bottom: var(--s-titre);
  }
  .iw-intro__text {
    max-width: 48rem;
  }
  .iw-eyebrow {
    font-size: var(--iw-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1rem !important;
  }
  .iw-eyebrow::before {
    content: '';
    width: 0.65rem;
    height: 0.65rem;
    background: var(--jaune);
  }
  .iw-intro__text > p:last-child {
    color: var(--iw-muted);
    margin-top: var(--s-lie);
    max-width: 42rem;
  }
  .iw-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    min-width: 44px;
    border: 1px solid var(--iw-line);
    background: white;
    padding: 0.65rem 1rem;
    color: var(--noir);
    text-decoration: none;
    font-weight: 600;
    border-radius: 4px;
    line-height: 1.35;
  }
  .iw-button:hover:not(:disabled) {
    background: var(--papier);
    border-color: var(--vert);
  }
  .iw-button--primary {
    background: var(--vert);
    border-color: var(--vert);
    color: white;
  }
  .iw-button--primary:hover:not(:disabled) {
    background: var(--vert-fold);
    color: white;
  }
  .iw-button--yellow {
    background: var(--jaune);
    border-color: var(--jaune);
  }
  .iw-button--plain {
    background: transparent;
  }
  .iw-button--icon {
    padding: 0.5rem;
    width: 44px;
    flex-shrink: 0;
  }
  .iw-button--new {
    flex-shrink: 0;
    min-height: 52px;
  }
  .iw-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .iw-muted {
    color: var(--iw-muted);
  }
  .iw-small {
    font-size: var(--iw-small);
  }
  .iw-switch {
    display: inline-flex;
    padding: 4px;
    gap: 4px;
    border: 1px solid var(--iw-line);
    background: white;
    border-radius: 6px;
  }
  .iw-switch button {
    border: 0;
    border-radius: 3px;
    background: transparent;
    padding: 0.55rem 1rem;
    min-width: 44px;
    min-height: 44px;
    color: var(--noir);
  }
  .iw-switch button[aria-pressed='true'] {
    background: var(--vert);
    color: white;
    font-weight: 600;
  }
  .iw-kindbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: var(--s-lie);
  }
  .iw-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: var(--s-lie);
  }
  .iw-metric {
    background: white;
    border: 1px solid var(--iw-line);
    border-top: 3px solid var(--vert);
    padding: 1rem 1.3rem;
  }
  .iw-metric:nth-child(2) {
    border-top-color: var(--jaune);
  }
  .iw-metric:nth-child(3) {
    border-top-color: var(--rose);
  }
  .iw-metric dt {
    color: var(--iw-muted);
  }
  .iw-metric dd {
    margin: 0.3rem 0 0;
    font-size: var(--t-h3);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }
  .iw-panel {
    background: white;
    border: 1px solid var(--iw-line);
    border-radius: 6px;
  }
  .iw-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1.25rem;
    border-bottom: 1px solid var(--iw-line);
  }
  .iw-period {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .iw-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }
  .iw-field > label,
  .iw-field > span:first-child {
    font-weight: 600;
  }
  .iw-body :is(input:not([type='checkbox']), select, textarea) {
    min-height: 44px;
    border: 1px solid #78877f;
    border-radius: 3px;
    background: white;
    padding: 0.65rem 0.7rem;
    color: var(--noir);
    min-width: 0;
    max-width: 100%;
    width: 100%;
  }
  .iw-body textarea {
    resize: vertical;
    min-height: 110px;
  }
  .iw-body input[type='month'] {
    width: auto;
    max-width: 100%;
  }
  .iw-filters {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr)) auto;
    gap: 1rem;
    align-items: end;
    padding: 1.25rem;
    border-bottom: 1px solid var(--iw-line);
  }
  .iw-resultsbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0.85rem 1.25rem;
  }
  .iw-state {
    margin: 1.25rem;
    padding: var(--s-titre);
    background: var(--papier);
    text-align: center;
    border-radius: 4px;
  }
  .iw-state h3 {
    margin-bottom: 0.6rem;
  }
  .iw-state .iw-button {
    margin-top: 1rem;
  }
  .iw-loading {
    display: block;
    margin: 0 auto 1rem;
    width: 24px;
    height: 24px;
    border: 3px solid var(--iw-line);
    border-top-color: var(--vert);
    border-radius: 50%;
    animation: iw-spin 1s linear infinite;
  }
  @keyframes iw-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .iw-feedback {
    background: var(--jaune-clair);
    border-left: 3px solid var(--jaune-fold);
    padding: 1rem;
    margin-block: 1rem;
    overflow-wrap: anywhere;
  }
  .iw-feedback[data-tone='error'] {
    background: #fff1ea;
    border-color: var(--orange-fold);
  }
  .iw-feedback:empty {
    display: none;
  }
  .iw-month {
    border-top: 1px solid var(--iw-line);
  }
  .iw-weekdays,
  .iw-days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }
  .iw-weekdays {
    background: #f7f8f6;
  }
  .iw-weekdays span {
    padding: 0.7rem 0.5rem;
    text-align: center;
    font-size: var(--iw-small);
    font-weight: 600;
  }
  .iw-day {
    min-height: 132px;
    border-top: 1px solid var(--iw-line);
    border-right: 1px solid var(--iw-line);
    padding: 0.5rem;
    min-width: 0;
  }
  .iw-day:nth-child(7n) {
    border-right: 0;
  }
  .iw-day--outside {
    background: #f7f8f6;
  }
  .iw-day__date {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    width: 28px;
    font-size: var(--iw-small);
    margin-bottom: 0.4rem;
  }
  .iw-day--today .iw-day__date {
    background: var(--vert);
    color: white;
    border-radius: 50%;
  }
  .iw-day__events {
    display: grid;
    gap: 0.4rem;
  }
  .iw-event {
    display: block;
    min-height: 44px;
    width: 100%;
    min-width: 0;
    text-align: left;
    border: 0;
    border-left: 3px solid var(--vert);
    padding: 0.45rem 0.55rem;
    background: #edf3ef;
    border-radius: 2px;
    color: var(--noir);
    overflow-wrap: anywhere;
  }
  .iw-event:hover {
    background: #dee9e2;
  }
  .iw-event[data-status='a_valider'] {
    border-color: var(--jaune-fold);
    background: #fff7d8;
  }
  .iw-event[data-status='brouillon'] {
    border-color: #78877f;
    background: #f1f1ee;
  }
  .iw-event[data-status='annule'] {
    border-color: #78877f;
    background: #f1f1ee;
  }
  .iw-event[data-status='annule'] .iw-event__title {
    text-decoration: line-through;
  }
  .iw-event__title {
    display: block;
    font-weight: 600;
    font-size: var(--iw-small);
    line-height: 1.35;
  }
  .iw-event__meta {
    display: block;
    font-size: var(--iw-small);
    margin-top: 0.25rem;
    line-height: 1.4;
  }
  .iw-day__count {
    display: none;
  }
  .iw-month-agenda {
    display: none;
  }
  .iw-agenda {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .iw-agenda__item + .iw-agenda__item {
    border-top: 1px solid var(--iw-line);
  }
  .iw-entry {
    display: grid;
    width: 100%;
    grid-template-columns: 115px minmax(0, 1fr) minmax(130px, 0.45fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem 1.25rem;
    min-height: 80px;
    text-align: left;
    background: white;
    border: 0;
    color: var(--noir);
  }
  .iw-entry:hover {
    background: #f7f8f6;
  }
  .iw-entry__date {
    font-weight: 600;
    font-size: var(--iw-small);
  }
  .iw-entry__title {
    display: block;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .iw-entry__details {
    display: block;
    font-size: var(--iw-small);
    color: var(--iw-muted);
    overflow-wrap: anywhere;
    margin-top: 0.25rem;
  }
  .iw-entry__person {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .iw-badge {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.6rem;
    border-radius: 3px;
    background: var(--papier);
    font-size: var(--iw-small);
    white-space: nowrap;
    color: var(--noir);
  }
  .iw-badge[data-status='a_valider'] {
    background: var(--jaune-clair);
  }
  .iw-badge[data-status='valide'],
  .iw-badge[data-status='publie'] {
    background: #dcece3;
  }
  .iw-badge[data-status='annule'] {
    text-decoration: line-through;
  }
  .iw-totals {
    margin-top: var(--s-titre);
    padding: 1.5rem;
  }
  .iw-sectionhead {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
  }
  .iw-sectionhead p {
    margin-top: 0.4rem;
  }
  .iw-table {
    border-collapse: collapse;
    width: 100%;
    table-layout: fixed;
  }
  .iw-table th,
  .iw-table td {
    text-align: left;
    border-bottom: 1px solid var(--iw-line);
    padding: 0.85rem 0.5rem;
    overflow-wrap: anywhere;
  }
  .iw-table th {
    font-weight: 600;
  }
  .iw-table :is(th, td):not(:first-child) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .iw-table tfoot {
    background: #f7f8f6;
    font-weight: 600;
  }
  .iw-footnote {
    margin-top: 1rem !important;
    color: var(--iw-muted);
    font-size: var(--iw-small);
  }
  .iw-dialog {
    color: var(--noir);
    border: 1px solid var(--iw-line);
    padding: 0;
    border-radius: 8px;
    width: min(850px, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    background: white;
  }
  .iw-dialog::backdrop {
    background: #08291fd1;
  }
  .iw-dialog__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem;
    border-bottom: 1px solid var(--iw-line);
  }
  .iw-dialog__header p {
    margin-top: 0.4rem;
  }
  .iw-dialog__body {
    padding: 1.5rem;
  }
  .iw-formgrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }
  .iw-field--wide {
    grid-column: 1/-1;
  }
  .iw-form-fields {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .iw-form-fields:disabled :is(input, select, textarea) {
    color: var(--iw-muted);
    background: #f7f8f6;
    opacity: 1;
  }
  .iw-form-actions {
    margin-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .iw-comments {
    border-top: 1px solid var(--iw-line);
    margin-top: 2rem;
    padding-top: 1.5rem;
  }
  .iw-comment-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
    display: grid;
    gap: 1rem;
  }
  .iw-comment {
    padding: 1rem;
    background: #f7f8f6;
    border-left: 3px solid var(--iw-line);
  }
  .iw-comment__header {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-bottom: 0.5rem;
    font-size: var(--iw-small);
    overflow-wrap: anywhere;
  }
  .iw-comment__content {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .iw-comment-form {
    display: grid;
    gap: 0.8rem;
  }
  .iw-comment-form .iw-button {
    justify-self: start;
  }
  .iw-conflict {
    margin-top: 1.25rem;
    border: 1px solid var(--jaune-fold);
    background: #fffbed;
    padding: 1rem;
  }
  .iw-conflict h3 {
    margin-bottom: 0.5rem;
  }
  .iw-conflict-list {
    display: grid;
    gap: 1rem;
