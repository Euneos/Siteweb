---
/**
 * Page 4 — Nous contacter.
 * Fidele a la maquette v7, page 4 : page entierement verte, photo avec
 * cartouche jaune et picto orange, puis un grand panneau a filet et coin plie
 * dont CHAQUE champ est lui-meme une boite a coin plie.
 */
import Cartouche from '../components/Cartouche.astro'
import Cta from '../components/Cta.astro'
import Paper from '../components/Paper.astro'
import Photo from '../components/Photo.astro'
import PictoBox from '../components/PictoBox.astro'
import Base from '../layouts/Base.astro'

const champs = [
  { id: 'nom', label: 'Nom', type: 'text', autocomplete: 'family-name' },
  { id: 'prenom', label: 'Prénom', type: 'text', autocomplete: 'given-name' },
  { id: 'fonction', label: 'Fonction', type: 'text', autocomplete: 'organization-title' },
  { id: 'email', label: 'Adresse mail', type: 'email', autocomplete: 'email' },
] satisfies { id: string; label: string; type: 'text' | 'email'; autocomplete: string }[]
---

<Base
  title="Nous contacter — EUNEOS"
  description="Une question ou une suggestion ? Écrivez à l’équipe EUNEOS. Association loi 1901, 118 route d’Espagne, 31100 Toulouse."
  heroSurface="vert"
>
  <section slot="hero" class="page ct">
    <div class="ct__media">
      <div class="ct__picto"><PictoBox picto="arche" surface="orange" size="clamp(74px, 8vw, 112px)" /></div>
      <div class="ct__ph"><Photo ratio="16/10" label="photo — équipe" /></div>
      <div class="ct__cartouche"><Cartouche surface="jaune" fig="fig1" /></div>
    </div>

    <Paper outline fold="tr" class="ct__panel">
      <h1>Des questions<br />ou des suggestions ?</h1>

      <form class="ct__form" method="POST" action="/api/contact">
        {
          champs.map((c) => (
            <p class="ct__row">
              <label for={c.id}>{c.label}</label>
              <span class="ct__field paper fold-br">
                <input id={c.id} name={c.id} type={c.type} autocomplete={c.autocomplete} required />
              </span>
            </p>
          ))
        }

        <p class="ct__row">
          <label for="message">Message</label>
          <span class="ct__field ct__field--area paper fold-br">
            <textarea id="message" name="message" rows="5" required></textarea>
          </span>
        </p>

        <div class="ct__submit">
          <Cta type="submit" surface="papier">Envoyer</Cta>
        </div>
      </form>
    </Paper>

    <address class="ct__adr">
      EUNEOS — Association loi 1901<br />
      118 route d’Espagne, 31100 Toulouse<br />
      <a href="mailto:contact@euneos.fr">contact@euneos.fr</a>
    </address>
  </section>
</Base>

<style is:global>
  .ct {
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  .ct__media {
    position: relative;
    width: min(100%, 46rem);
    margin-left: auto;
    margin-right: clamp(0rem, 6vw, 5rem);
    margin-top: clamp(1rem, 3vw, 2.5rem);
  }
  .ct__ph {
    position: relative;
    z-index: 1;
  }
  .ct__picto {
    position: absolute;
    left: -8%;
    top: 38%;
    z-index: 2;
  }
  .ct__cartouche {
    position: absolute;
    right: -9%;
    top: -8%;
    width: 15%;
    min-width: 76px;
    z-index: 2;
  }

  .ct__panel {
    position: relative;
    z-index: 3;
    width: min(100%, 44rem);
    margin: clamp(-3rem, -4vw, -1.5rem) auto 0;
    padding: clamp(1.75rem, 4vw, 3rem);
  }
  .ct__panel h1 {
    text-align: center;
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
    line-height: 1.15;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .ct__form {
    display: grid;
    gap: 1.1rem;
    max-width: 32rem;
    margin-inline: auto;
  }
  .ct__row {
    display: grid;
    gap: 0.4rem;
  }
  .ct__row label {
    font-weight: 600;
  }
  /* chaque champ est une petite feuille a coin plie */
  .ct__field {
    --surface: transparent;
    --fold-color: currentColor;
    --f: 0.85rem;
    border: 1.5px solid currentColor;
    display: block;
  }
  .ct__field input,
  .ct__field textarea {
    width: 100%;
    background: transparent;
    border: 0;
    color: inherit;
    padding: 0.65rem 0.85rem;
    display: block;
    resize: vertical;
  }
  .ct__field input:focus-visible,
  .ct__field textarea:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  .ct__field.paper::before {
    background: currentColor;
    opacity: 0.55;
  }
  .ct__submit {
    display: flex;
    justify-content: center;
    margin-top: 0.5rem;
  }
  .ct__adr {
    position: relative;
    z-index: 3;
    text-align: center;
    font-style: normal;
    margin-top: clamp(2rem, 5vw, 3rem);
    opacity: 0.9;
    line-height: 1.7;
  }
  .ct__adr a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
