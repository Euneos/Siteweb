---
/**
 * Page 4 — Nous contacter.
 * Fidele a la maquette v7, page 4 : page entierement verte, photo avec
 * cartouche jaune et picto orange, puis un grand panneau a filet et coin plie
 * dont CHAQUE champ est lui-meme une boite a coin plie.
 */
import Cartouche from '../components/Cartouche.astro'
import Paper from '../components/Paper.astro'
import Photo from '../components/Photo.astro'
import PictoBox from '../components/PictoBox.astro'
import Base from '../layouts/Base.astro'

export const prerender = false

const params = Astro.url.searchParams
const ok = params.has('ok')
const emailEnvoye = params.has('email')
const erreur = params.get('erreur')
const messages: Record<string, string> = {
  champs: 'Il manque des informations obligatoires.',
  email: 'L’adresse e-mail ne semble pas valide.',
  indisponible: 'Le formulaire est momentanément indisponible. Écrivez-nous directement à contact@euneos.fr.',
  technique: 'Le message n’a pas pu être envoyé. Réessayez dans quelques minutes ou écrivez-nous à contact@euneos.fr.',
}

const champs = [
  { id: 'nom', label: 'Nom', type: 'text', autocomplete: 'family-name' },
  { id: 'prenom', label: 'Prénom', type: 'text', autocomplete: 'given-name' },
  { id: 'fonction', label: 'Fonction', type: 'text', autocomplete: 'organization-title' },
  { id: 'email', label: 'Adresse mail', type: 'email', autocomplete: 'email' },
] satisfies { id: string; label: string; type: 'text' | 'email'; autocomplete: string }[]
---

<Base
  title="Nous contacter — EUNEOS"
  description="Une question ou une suggestion ? Écrivez à l’équipe EUNEOS. Association loi 1901, 118 route d’Espagne, 31100 Toulouse."
  heroSurface="vert"
  heroFold="none"
>
  <section slot="hero" class="page ct">
    <div class="ct__media">
      <!-- releve v4 p.4 : cartouche orange paysage de 148 x 105, contre le
           bord gauche de la photo -->
      <div class="ct__picto"><PictoBox picto="arche" surface="orange" size="clamp(5rem, 10.3vw, 9.25rem)" paysage /></div>
      <div class="ct__ph"><Photo ratio="3/2" label="photo — équipe" /></div>
      <div class="ct__cartouche"><Cartouche surface="jaune" fig="fig1" /></div>
    </div>

    <Paper outline fold="tr" foldSize="clamp(3rem, 7vw, 7rem)" class="ct__panel">
      <h1>Des questions<br />ou des suggestions ?</h1>

      {
        ok && (
          <p class="ct__status ct__status--ok" role="status">
            <strong>Message bien reçu.</strong> {emailEnvoye
              ? 'Un accusé de réception vient de vous être envoyé par e-mail.'
              : 'L’équipe EUNEOS vous répondra dans les meilleurs délais.'}
          </p>
        )
      }
      {
        erreur && (
          <p class="ct__status ct__status--err" role="alert">
            {messages[erreur] ?? 'Une erreur est survenue.'}
          </p>
        )
      }

      {!ok && <form class="ct__form" id="ct-form" method="POST" action="/api/contact">
        <input class="form-trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        {
          champs.map((c) => (
            <p class="ct__row">
              <label for={c.id}>{c.label}</label>
              <span class="champ">
                <input id={c.id} name={c.id} type={c.type} autocomplete={c.autocomplete} maxlength={c.type === 'email' ? 254 : 160} required />
              </span>
            </p>
          ))
        }

        <p class="ct__row">
          <label for="message">Message</label>
          <span class="champ">
            <textarea id="message" name="message" rows="4" maxlength="5000" required></textarea>
          </span>
        </p>

      </form>}
      {
        !ok && (
          <div class="ct__submit">
            <button type="submit" form="ct-form" class="cta s-vert-clair ct__submit-btn">Envoyer</button>
          </div>
        )
      }
    </Paper>

    <address class="ct__adr">
      EUNEOS — Association loi 1901<br />
      118 route d’Espagne, 31100 Toulouse<br />
      <a href="mailto:contact@euneos.fr">contact@euneos.fr</a>
    </address>
  </section>
</Base>

<script>
  const storageKey = 'euneos-contact'
  const form = document.querySelector<HTMLFormElement>('#ct-form')
  const params = new URLSearchParams(window.location.search)

  if (params.has('ok')) sessionStorage.removeItem(storageKey)

  if (form && params.has('erreur')) {
    try {
      const values = JSON.parse(sessionStorage.getItem(storageKey) ?? '{}') as Record<string, string>
      for (const [name, value] of Object.entries(values)) {
        const control = form.elements.namedItem(name)
        if (control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement) control.value = value
      }
    } catch {
      sessionStorage.removeItem(storageKey)
    }
  }

  form?.addEventListener('submit', () => {
    const values = Object.fromEntries(
      [...new FormData(form)].filter((entry): entry is [string, string] => typeof entry[1] === 'string'),
    )
    sessionStorage.setItem(storageKey, JSON.stringify(values))
  })
</script>

<style is:global>
  /* Composition relevee v4 p.4 a 1440 px :
       photo 635 x 426 CENTREE (x 397 -> 1032), ratio 3/2 ;
       cartouche jaune 148 x 206 CONTRE le bord droit de la photo, aligne en
       haut (pas a cheval sur le coin) ;
       cartouche orange 148 x 105 contre le bord gauche, a 48 % de la hauteur ;
       panneau 857 x 1095 (59,5 % de la page) juste SOUS la photo (5 px), pas
       par-dessus ; titre a 70 px du haut ; champs 715 x 65 (83 % du panneau)
       a 72 px du bord ; 40 px entre deux champs ; bouton vert clair a cheval
       sur le bord bas (un quart dedans) ; rien d'autre sous le panneau.
     Avant : photo calee a droite, cartouches a cheval sur les coins, panneau
     mordant sur la photo, champs de 576 x 50, bouton gris. */
  .ct {
    /* enfant d'une colonne flex avec des marges auto : sans largeur
       explicite, il se retrecit sur son contenu et les % des enfants
       s'effondrent avec lui */
    width: 100%;
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  .ct__media {
    position: relative;
    width: min(51.2%, 40rem);
    margin-inline: auto;
    margin-top: clamp(1rem, 3vw, 2.5rem);
  }
  .ct__ph {
    position: relative;
    z-index: 1;
  }
  .ct__picto {
    position: absolute;
    right: 100%;
    top: 48%;
    z-index: 2;
  }
  .ct__cartouche {
    position: absolute;
    left: 100%;
    top: 0;
    width: 23.3%;
    min-width: 76px;
    z-index: 2;
  }
  .ct__panel {
    position: relative;
    z-index: 3;
    width: min(100%, 69.1%);
    margin: 0.3rem auto 0;
    padding: clamp(2rem, 4.9vw, 4.4rem) clamp(1.5rem, 5vw, 4.5rem) clamp(3rem, 6vw, 5.5rem);
  }
  .ct__panel h1 {
    text-align: center;
    margin-bottom: var(--s-int);
  }
  .ct__form {
    display: grid;
    gap: clamp(1.25rem, 2.8vw, 2.5rem);
    width: min(100%, 44.7rem);
    margin-inline: auto;
  }
  .ct__status {
    max-width: 36rem;
    margin: 0 auto 1.5rem;
    padding: 0.85rem 1rem;
    border: 1.5px solid currentColor;
  }
  .ct__status--ok {
    background: color-mix(in srgb, var(--vert-clair) 24%, transparent);
  }
  .ct__status--err {
    background: color-mix(in srgb, var(--orange) 18%, transparent);
  }
  .ct__row {
    display: grid;
    gap: 0.5rem;
  }
  .ct__row label {
    font-weight: 600;
  }
  /* les champs sont des .champ (global.css) : la geometrie de la maquette,
     partagee avec /newsletter et le portail de candidature */
  .ct__submit {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translate(-50%, 75%);
    z-index: 4;
  }
  /* pas dans la maquette : l'adresse reste, discrete, sous le panneau */
  .ct__adr {
    position: relative;
    z-index: 3;
    text-align: center;
    font-style: normal;
    margin-top: clamp(3rem, 6vw, 5rem);
    opacity: 0.9;
    line-height: 1.7;
  }
  @media (max-width: 860px) {
    .ct__media {
      width: 100%;
    }
    /* plus de marge autour de la photo : les cartouches rentrent dessus */
    .ct__picto {
      right: auto;
      left: 0;
    }
    .ct__cartouche {
      left: auto;
      right: 0;
      width: 26%;
    }
    .ct__panel {
      width: 100%;
      margin-top: 1rem;
    }
  }
  @media (max-width: 480px) {
    .ct__panel {
      padding-top: max(2rem, calc(var(--f) + 1rem));
    }
  }
  .ct__adr a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
