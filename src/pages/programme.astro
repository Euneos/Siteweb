---
/**
 * Page 2 — Notre Programme.
 * Fidele a la maquette v7, page 2. Hero BLEU : c'est la couleur reservee
 * au Programme cle (« Le bleu est reserve pour le Programme cle d'Euneos »).
 */
import Brand from '../components/Brand.astro'
import Cartouche from '../components/Cartouche.astro'
import Cta from '../components/Cta.astro'
import Paper from '../components/Paper.astro'
import Photo from '../components/Photo.astro'
import PictoBox from '../components/PictoBox.astro'
import Base from '../layouts/Base.astro'

/* Maquette : les pictos sont NUS, colores, poses sur le fond papier — pas dans
   un cartouche. Chaque colonne se termine par une fleche de depliage. */
const methodo = [
  { picto: 'main', couleur: 'var(--bleu)', titre: 'À REDIGER', texte: 'Texte attendu de Pauline (retour le 26/08).' },
  { picto: 'asterisque', couleur: 'var(--rose)', titre: 'À REDIGER', texte: 'Texte attendu de Pauline (retour le 26/08).' },
  { picto: 'oiseau', couleur: 'var(--orange)', titre: 'À REDIGER', texte: 'Texte attendu de Pauline (retour le 26/08).' },
] as const

/* Les 6 etapes, avec une couleur par etape (maquette p.2) */
const etapes = [
  { n: 1, titre: 'Sélection', surface: 'blanc' },
  { n: 2, titre: 'Rencontre de lancement & mobilisation de l’équipe', surface: 'bleu' },
  { n: 3, titre: 'Formation des équipes', surface: 'rose' },
  { n: 4, titre: 'Ateliers jeunes', surface: 'orange' },
  { n: 5, titre: 'Intégration en classe et accompagnement', surface: 'jaune' },
  { n: 6, titre: 'Évaluation & restitution', surface: 'blanc' },
] as const

const impact = [
  { valeur: '16', legende: 'établissements pilotes engagés en 2025/2026' },
  { valeur: '6', legende: 'pays ont adhéré au Programme' },
  { valeur: '12', legende: 'organisations partenaires' },
  { valeur: '100 %', legende: 'des frais pris en charge par le Programme' },
]

const faq = [
  {
    q: 'Combien coûte le programme pour notre établissement ?',
    r: 'Aucun frais : le programme 2026-2027 est intégralement financé.',
  },
  {
    q: 'Quelle charge de travail pour notre équipe ?',
    r: '16 h de formation initiale, puis 4 à 8 ateliers jeunes répartis sur l’année.',
  },
  {
    q: 'Le programme est-il scientifiquement fondé ?',
    r: 'Oui : approches pédagogiques évaluées, avec questionnaires avant/après et restitution dans le cadre du consortium européen Erasmus+.',
  },
  {
    q: 'Qui peut candidater ?',
    r: 'Collèges et lycées publics ou privés, en France hexagonale ou dans les DOM.',
  },
  {
    q: 'Comment le Programme s’articule-t-il avec les dispositifs existants de l’Éducation nationale ?',
    r: 'L’EVAR (Éducation à la Vie Émotionnelle, Affective et Relationnelle) est une directive récente de l’Éducation nationale dont les objectifs recoupent directement ce que le Programme développe. Les compétences psychosociales sont un terme scientifiquement reconnu, déjà présent dans les référentiels de l’Éducation nationale : les formations internes y consacrent 6 h, le Programme en propose 16 : il approfondit un cadre existant plutôt que d’en ajouter un nouveau.',
  },
]
---

<Base
  title="Notre Programme — WISE-UP | EUNEOS"
  description="Le Programme EUNEOS : 16 h de formation pour les équipes éducatives, 4 à 8 ateliers jeunes, une évaluation scientifique. Aucun frais pour l’établissement. Candidatez pour la rentrée 2026."
  heroSurface="bleu"
  heroFold="bl"
>
  <!-- HERO bleu -->
  <section slot="hero" class="hz hz--mirror">
    <div class="hz__grid">
      <div class="hz__side">
        <div class="hz__cartouche"><Cartouche surface="rose" fig="fig3" /></div>

        <div class="hz__bubblewrap">
          <Paper outline fold="br" class="hz__bubble">
            <h1>
            Le Programme Euneos,
            <span class="hz__soft">caractéristiques caractéristiques caractéristiques</span>
          </h1>
          </Paper>
          <div class="hz__cta"><Cta href="#candidater" surface="bleu-fonce">En savoir +</Cta></div>
        </div>
      </div>

      <div class="hz__media">
        <Photo ratio="5/4" label="photo — atelier en situation" />
      </div>

    </div>
  </section>

  <!-- WHY / WHAT -->
  <section class="section why has-silo">
    <div class="silo silo--right why__fig" aria-hidden="true"><Brand name="fig4" height="100%" /></div>
    <div class="page g16 why__in">
      <h2 style="grid-column: 3 / 8">À REDIGER</h2>
      <div style="grid-column: 9 / 14" class="why__txt">
        <p>
          Bloc « pourquoi / quoi » — caractéristiques précises attendues : durée, outils,
          nombre d’animateurs, adaptations possibles. Texte à fournir par Pauline.
        </p>
        <Cta href="/qui-sommes-nous" surface="bleu-fonce">Qui sommes-nous ?</Cta>
      </div>
    </div>
  </section>

  <!-- METHODOLOGIE -->
  <section class="section">
    <div class="page">
      <h2 class="c-t">Notre méthodologie</h2>
      <ul class="methodo">
        {
          methodo.map((m) => (
            <li>
              <div class="methodo__head">
                <div class="methodo__picto" style={`color:${m.couleur}`}>
                  <Brand name={m.picto} />
                </div>
                <h3>{m.titre}</h3>
              </div>
              <p>{m.texte}</p>
              <span class="methodo__more" aria-hidden="true">
                <svg viewBox="0 0 24 32" fill="currentColor"
                  ><path d="M9 0h6v20l6-6 2 2-11 11L1 16l2-2 6 6z"></path></svg
                >
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- DEROULEMENT : 6 etapes en quinconce, une couleur par etape -->
  <section class="section">
    <div class="page">
      <h2 class="c-t">Comment se déroule notre programme ?</h2>
      <ol class="etapes">
        {
          etapes.map((e, i) => (
            <li class:list={['etapes__item', i % 2 === 1 && 'is-right']}>
              <Paper surface={e.surface} fold="tr" class="etapes__card">
                <p class="etapes__n">
                  <span>{e.n}</span> {e.titre}
                </p>
                <p class="etapes__txt">Descriptif de l’étape — à fournir par Pauline.</p>
              </Paper>
            </li>
          ))
        }
      </ol>
      <div class="c-cta">
        <Cta href="#candidater" surface="bleu-fonce">Candidatez pour la rentrée 2026</Cta>
      </div>
    </div>
  </section>

  <!-- IMPACT — releve au vecteur : bloc encadre (marges de 6,2 %), ratio 2,04,
       coin haut-droit coupe par un pli APLATI (69,2 x 22,7 pt). -->
  <section class="section">
    <div class="page">
      <Paper surface="bleu" fold="tr" class="impact2">
        <div class="filigrane" aria-hidden="true">
          <div class="impact2__fig"><Brand name="fig3" height="100%" /></div>
        </div>
        <div class="impact2__in">
          <h2 class="impact2__t">Notre impact</h2>
          <ul class="impact2__list">
            {
              impact.map((s) => (
                <li>
                  <span class="impact2__n">{s.valeur}</span>
                  <p>{s.legende}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </Paper>
    </div>
  </section>

  <!-- TEMOIGNAGES -->
  <section class="section">
    <div class="page">
      <h2 class="c-t">Ils nous ont fait confiance</h2>
      <ul class="temoins">
        {
          [1, 2].map(() => (
            <li class="temoin">
              <Paper surface="ocre" fold="none" class="temoin__name">Nom Prénom</Paper>
              <div class="temoin__ph">
                <Photo ratio="3/4" label="portrait" />
              </div>
              <Paper surface="blanc" fold="br" class="temoin__card">
                <blockquote>« Témoignage à recueillir auprès d’un établissement pilote. »</blockquote>
                <p class="temoin__role">Fonction, Établissement</p>
              </Paper>
            </li>
          ))
        }
      </ul>
      <div class="c-cta">
        <Cta href="#candidater" surface="bleu-fonce">Candidatez pour la rentrée 2026</Cta>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="page faq">
      <div class="faq__col">
        <h2 class="faq__t">Questions fréquentes</h2>
        <dl class="faq__list">
          {
            faq.map((item) => (
              <details class="faq__item">
                <summary>{item.q}</summary>
                <p>{item.r}</p>
              </details>
            ))
          }
        </dl>
      </div>
      <div class="faq__media">
        <div class="faq__picto"><PictoBox picto="confettis" surface="orange" size="clamp(74px, 8vw, 112px)" /></div>
        <Photo ratio="4/3" label="photo — équipe" />
        <div class="faq__cartouche"><Cartouche surface="jaune" fig="fig1" /></div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL — releve au vecteur : bloc encadre en bleu clair, recouvert par
       un eclat en bleu fonce (extrait du PDF), silhouette par-dessus, CTA blanc
       plein occupant 29,7 % de la largeur. -->
  <section id="candidater" class="section">
    <div class="page">
      <div class="final s-bleu">
        <div class="final__eclat" aria-hidden="true"><Brand name="eclat" /></div>
        <div class="final__fig" aria-hidden="true"><Brand name="fig3" height="100%" /></div>
        <div class="final__in">
          <h2>Candidatez pour rejoindre le Programme à la rentrée 2026</h2>
          <Cta href="/contact" surface="blanc" class="final__cta">Infos et candidature</Cta>
        </div>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* WHY */
  .why__fig {
    color: var(--bleu);
  }
  .why__in {
    align-items: center;
  }
  .why__txt {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  @media (max-width: 860px) {
    .why__fig {
      display: none;
    }
  }


  /* METHODOLOGIE */
  .methodo {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  .methodo__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .methodo__picto {
    width: clamp(2.5rem, 4vw, 3.5rem);
    flex: none;
  }
  .methodo__head h3 {
    color: var(--vert);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
  }
  .methodo li p {
    max-width: 34ch;
  }
  /* fleche de depliage, comme sur la maquette */
  .methodo__more {
    display: block;
    width: 1rem;
    margin-top: clamp(1rem, 2.5vw, 1.75rem);
    color: color-mix(in srgb, var(--noir) 28%, transparent);
  }
  @media (max-width: 860px) {
    .methodo {
      grid-template-columns: 1fr;
    }
  }

  /* ETAPES */
  .etapes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }
  .etapes__item {
    width: min(100%, 41rem);
  }
  .etapes__item.is-right {
    margin-left: auto;
  }
  .etapes__card {
    padding: clamp(1.1rem, 2.4vw, 1.75rem);
    --f: clamp(1.75rem, 3vw, 2.75rem);
  }
  .etapes__n {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--vert);
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }
  .etapes__n span {
    font-size: 2.25rem;
    line-height: 1;
  }
  .etapes__txt {
    margin-top: 0.75rem;
    opacity: 0.9;
  }

  /* IMPACT — bloc encadre, ratio et pli releves au vecteur */
  .impact2 {
    position: relative;
    overflow: hidden;
    aspect-ratio: 520.3 / 254.5;
    display: grid;
    place-items: center;
    /* pli aplati : 69,2 x 22,7 pt sur un bloc de 520,3 de large */
    --fx: 13.3%;
    --fy: 8.9%;
  }
  .impact2__fig {
    left: 26%;
    color: var(--bleu-clair);
  }
  .impact2 .filigrane {
    opacity: 0.22;
  }
  .impact2__in {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .impact2__t {
    text-align: center;
    color: var(--blanc);
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .impact2__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.75rem, 2.5vw, 2rem);
    text-align: center;
    color: var(--blanc);
  }
  .impact2__n {
    display: block;
    font-size: clamp(1.75rem, 4.4vw, 3rem);
    font-weight: 600;
    line-height: 1;
  }
  .impact2__list p {
    margin: 0.5rem auto 0;
    font-size: 0.92rem;
    line-height: 1.3;
    max-width: 15ch;
  }
  @media (max-width: 860px) {
    .impact2 {
      aspect-ratio: auto;
    }
    .impact2__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  /* TEMOIGNAGES */
  .temoins {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .temoin {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
  }
  .temoin__name {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
    padding: 0.7rem 1.2rem;
    font-weight: 600;
    z-index: 3;
    position: relative;
    margin-bottom: -0.4rem;
  }
  .temoin__ph {
    grid-column: 1;
    grid-row: 2;
    z-index: 2;
    position: relative;
  }
  .temoin__card {
    grid-column: 2;
    grid-row: 2;
    align-self: center;
    margin-left: -10%;
    padding: clamp(1.1rem, 2.2vw, 1.75rem);
    padding-left: clamp(2rem, 4vw, 3.25rem);
    z-index: 1;
    display: grid;
    gap: 0.9rem;
  }
  .temoin__card blockquote {
    margin: 0;
    font-style: italic;
  }
  .temoin__role {
    font-style: italic;
    font-size: 0.9rem;
    opacity: 0.8;
  }
  @media (max-width: 860px) {
    .temoins {
      grid-template-columns: 1fr;
    }
    .temoin {
      grid-template-columns: 1fr;
    }
    .temoin__name,
    .temoin__ph,
    .temoin__card {
      grid-column: 1;
      grid-row: auto;
      margin-left: 0;
    }
  }

  /* FAQ */
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .faq__t {
    text-align: left;
    color: var(--vert);
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .faq__list {
    margin: 0;
  }
  .faq__item {
    border-bottom: 1px solid color-mix(in srgb, var(--noir) 14%, transparent);
    padding: 1rem 0;
  }
  .faq__item summary {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary::after {
    content: '+';
    font-size: 1.4rem;
    line-height: 1;
    color: var(--vert);
  }
  .faq__item[open] summary::after {
    content: '–';
  }
  .faq__item p {
    margin-top: 0.75rem;
    max-width: 60ch;
  }
  .faq__media {
    position: relative;
  }
  .faq__picto {
    position: absolute;
    left: -12%;
    top: -10%;
    z-index: 1;
  }
  .faq__cartouche {
    position: absolute;
    right: -8%;
    bottom: -14%;
    width: 26%;
    min-width: 90px;
    z-index: 1;
  }
  @media (max-width: 860px) {
    .faq {
      grid-template-columns: 1fr;
    }
  }

  /* CTA FINAL — bloc encadre + eclat vectoriel du PDF */
  .final {
    position: relative;
    overflow: hidden;
    aspect-ratio: 519.6 / 257;
    background: var(--surface);
    color: var(--on-surface);
    display: grid;
    place-items: center;
  }
  .final__eclat {
    position: absolute;
    inset: 0;
    color: var(--bleu-fold);
  }
  .final__eclat :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .final__fig {
    position: absolute;
    left: -2%;
    top: 8%;
    height: 84%;
    color: var(--bleu-clair);
    z-index: 1;
  }
  .final__in {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: clamp(1.25rem, 3.5vw, 2.25rem);
    text-align: center;
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .final__in h2 {
    max-width: 30ch;
    color: var(--blanc);
  }
  /* releve : 154,5 pt sur 519,6 -> 29,7 % */
  .final__cta {
    min-width: 29.7%;
    text-align: center;
    --on-surface: var(--bleu-fold);
    --fold-color: var(--bleu-clair);
  }
  @media (max-width: 860px) {
    .final {
      aspect-ratio: auto;
    }
  }
</style>
