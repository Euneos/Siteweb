---
/**
 * Page 2 — Notre Programme.
 * Fidele a la maquette v7, page 2. Hero BLEU : c'est la couleur reservee
 * au Programme cle (« Le bleu est reserve pour le Programme cle d'Euneos »).
 */
import Brand from '../components/Brand.astro'
import Cartouche from '../components/Cartouche.astro'
import Cta from '../components/Cta.astro'
import CtaFinal from '../components/CtaFinal.astro'
import Paper from '../components/Paper.astro'
import Photo from '../components/Photo.astro'
import PictoBox from '../components/PictoBox.astro'
import Base from '../layouts/Base.astro'

/* Maquette : les pictos sont NUS, colores, poses sur le fond papier — pas dans
   un cartouche. Les principes reprennent le comportement des cartes de
   l'accueil : un apercu estompe, puis une fleche qui deroule le texte restant. */
const methodo = [
  {
    picto: 'main',
    couleur: 'var(--bleu)',
    titre: '2 pôles de compétences',
    intro: 'Une formation conçue pour transmettre de manière complémentaire :',
    points: [
      'Des compétences psychosociales : attention, régulation émotionnelle, coopération, empathie.',
      'Des pratiques équilibrées et régulées du numérique : clarifier les habitudes, comprendre les usages.',
    ],
  },
  {
    picto: 'asterisque',
    couleur: 'var(--rose)',
    titre: 'Personnel formés',
    intro: 'Un accompagnement qui renforce la coopération, l’attention et soutient le climat éducatif :',
    points: [
      'Avec une pratique de l’attention intégrée au quotidien professionnel ;',
      'et des outils concrets pour réguler le stress numérique et la surcharge informationnelle.',
    ],
  },
  {
    picto: 'oiseau',
    couleur: 'var(--orange)',
    titre: 'Jeunes régulés',
    intro: 'Des jeunes qui développent des compétences fondamentales :',
    points: [
      'Concentration et stabilisation de leur attention.',
      'Régulation émotionnelle et une estime de soi plus solide.',
      'Des usages numériques plus conscients.',
    ],
  },
] as const

/* Les 8 modules de la formation (maquette v4 p.2). */
const modules = [
  { n: 1, titre: 'Santé mentale, bien-être numérique et attention' },
  { n: 2, titre: 'Du pilote automatique à la présence : corps, attention et centration' },
  { n: 3, titre: 'Du réseau par défaut à la régulation : attention, cerveau et choix' },
  { n: 4, titre: 'Sortir du biais négatif : automatismes et reconnexion aux ressources' },
  { n: 5, titre: 'Comprendre le stress pour mieux se réguler dans un monde connecté' },
  { n: 6, titre: 'Créer un collectif attentif : écouter, communiquer, réguler' },
  { n: 7, titre: 'Émotions et comportements : sortir des réactions automatiques' },
  { n: 8, titre: 'Applications concrètes & soutien à la mise en œuvre' },
] as const

/* Les 5 etapes et leurs descriptifs, fournis le 20/08 (maquette v2 p.2).
   La v7 en comptait 6 avec des descriptifs en lorem : « Sélection » a disparu. */
const etapes = [
  {
    n: 1,
    titre: 'Rencontre de lancement',
    surface: 'papier',
    texte:
      'Candidature étudiée et validée. Réunion d’information en ligne (replay disponible). Présentation du programme à l’équipe pour lancer une dynamique commune. Référent désigné et formateur attribué. Choix optionnel d’une classe participante à l’évaluation scientifique.',
  },
  {
    n: 2,
    titre: 'Formation des équipes (16 h)',
    surface: 'bleu-clair',
    texte:
      'Format présentiel ou hybride. Les éducateurs s’approprient d’abord les outils, puis les transmettent aux élèves. Session supplémentaire pour animer la série d’ateliers plus longs.',
  },
  {
    n: 3,
    titre: 'Atelier élèves',
    surface: 'rose',
    texte:
      '4 à 8 ateliers interactifs répartis sur l’année : usages numériques, émotions, équilibre en ligne/hors ligne, pour aider les élèves à mieux comprendre leurs habitudes numériques, leurs besoins émotionnels, et à trouver des réponses plus conscientes par eux-mêmes.',
  },
  {
    n: 4,
    titre: 'Intégration dans l’établissement',
    surface: 'orange',
    texte:
      'Après la formation, les participants mettent progressivement en place des pratiques, routines et échanges entre collègues ou envers les familles : pauses attentionnelles, coopération, autorégulation émotionnelle. Moments thématiques avec familles possibles. Objectif : favoriser une intégration durable, adaptée au rythme et au contexte de l’établissement.',
  },
  {
    n: 5,
    titre: 'Évaluation & restitution européenne',
    surface: 'jaune-clair',
    texte:
      'Questionnaires avant/après élèves, collaboration avec la recherche européenne. Questionnaires pré et post formation et suivi à + 45 jours pour les équipes. Objectif : contribuer à une amélioration continue, et inscrire l’établissement dans un réseau européen engagé.',
  },
] as const

const impact = [
  { valeur: '16', legende: 'établissements pilotes engagés en 2025/2026 dans 6 pays européens' },
  { valeur: '+145', legende: 'enseignants en formation et + de 800 élèves sensibilisés et évalués' },
  { valeur: '12', legende: 'organisations partenaires' },
  { valeur: '100 %', legende: 'des frais pris en charge' },
]

/* Les prenoms ne sont pas publies tant qu'ils ne sont pas confirmes. */
const temoins = [
  {
    nom: 'Témoignage',
    citation:
      '« L’importance de s’arrêter et prendre conscience de soi et de ce que l’on ressent, accepter et accueillir nos émotions pour pouvoir guider les élèves. »',
    role: 'Enseignant·e, Collège Alexander Fleming (Orsay)',
  },
  {
    nom: 'Témoignage',
    citation:
      '« Formation essentielle pour que notre posture puisse accueillir le mal-être des élèves — ouvrir le débat, libérer la parole dans un emploi du temps très chargé. »',
    role: 'Enseignant·e, Lycée Jean d’Ormesson (Châteaurenard)',
  },
] as const

const faq = [
  /* Les 5 questions sont celles de la maquette v4 p.2. Seule la derniere y a
     une reponse : les autres attendent le texte de Candice. On affiche les
     5 questions (comme la maquette), en signalant celles sans reponse. */
  {
    q: 'À partir de combien de personnes pouvons-nous envisager de rejoindre le Programme EUNEOS ?',
    r: 'Réponse à venir.',
    brouillon: true,
  },
  {
    q: 'Quel est le format de la formation ?',
    r: 'Réponse à venir.',
    brouillon: true,
  },
  {
    q: 'Quels élèves et combien peuvent participer aux ateliers et éventuels questionnaires d’évaluation ?',
    r: 'Réponse à venir.',
    brouillon: true,
  },
  {
    q: 'Quelles sont les personnes clés du projet ?',
    r: 'Réponse à venir.',
    brouillon: true,
  },
  {
    q: 'À partir de quel moment peut-on appliquer les activités du Programme ?',
    r: 'Tout personnel formé peut commencer à mettre en place des activités issues du Programme avec des élèves, que ces derniers participent ou non aux ateliers. La mise en place peut être progressive et les activités assez libres pour autant qu’elles soient issues du programme et des ressources mises à disposition. On peut aussi appliquer les activités en dehors de la classe, dans des contextes de suivi individuel.',
    brouillon: false,
  },
]
---

<Base
  title="Notre Programme — WISE-UP | EUNEOS"
  description="Le Programme EUNEOS : 16 h de formation pour les équipes éducatives, 4 à 8 ateliers jeunes, une évaluation scientifique. Aucun frais pour l’établissement. Candidatez pour la rentrée 2026."
  heroSurface="bleu"
  heroFold="bl"
>
  <!-- HERO bleu -->
  <section slot="hero" class="hz hz--mirror">
    <div class="hz__grid">
      <div class="hz__side">
        <div class="hz__cartouche"><Cartouche surface="rose" fig="fig3" /></div>

        <div class="hz__bubblewrap">
          <Paper outline fold="br" class="hz__bubble">
            <h1>
              <span class="hz__strong">Le Programme EUNEOS&nbsp;:</span>
              <span class="hz__soft">Des éducateurs outillés. Des jeunes soutenus.</span>
            </h1>
          </Paper>
          <div class="hz__cta"><Cta href="#candidater" surface="bleu-fonce">En savoir +</Cta></div>
        </div>
      </div>

      <div class="hz__media">
        <Photo ratio="5/4" label="photo — atelier en situation" />
      </div>

    </div>
  </section>

  <!-- WHY / WHAT -->
  <section class="section why has-silo">
    <div class="silo silo--right why__fig" aria-hidden="true"><Brand name="fig4" height="100%" /></div>
    <div class="page g16 why__in">
      <h2 style="grid-column: 2 / 8">
        Nous formons les équipes éducatives à la prévention de la santé mentale et au
        stress numérique
      </h2>
      <div style="grid-column: 9 / 16" class="why__txt">
        <p>
          Les jeunes d’aujourd’hui grandissent dans un monde saturé d’écrans que le milieu
          éducatif n’a pas encore été outillé pour accompagner. Au collège et au lycée, cela
          se traduit par : de l’attention fragmentée, du stress et de la fatigue numérique,
          des émotions intenses, des tensions relationnelles…
        </p>
        <p>
          EUNEOS agit pour que chaque adulte en établissement devienne un appui réel, et
          qu’aucun jeune ne reste seul face à ces enjeux.
        </p>
        <Cta href="/qui-sommes-nous" surface="bleu-fonce">Qui sommes-nous ?</Cta>
      </div>
    </div>
  </section>

  <!-- BLOC ERASMUS+ — maquette v4 p.2 : photo a gauche (30 %) + carte bleue
       (70 %), pli corne bleu clair en haut a droite, titre blanc au corps des
       titres puis un paragraphe. Texte complet de la maquette. -->
  <section class="section">
    <div class="page erasmus">
      <div class="erasmus__media"><Photo ratio="2/3" label="photo — formation" /></div>
      <Paper surface="bleu" fold="tr" class="erasmus__card">
        <p class="erasmus__l1">
          Le Programme européen porté par Euneos a été développé et financé dans le cadre des
          projets favorisant la prévention en santé mentale et les bons usages numériques
          (Erasmus+ 2025–2027)
        </p>
        <p class="erasmus__l2">
          Ce programme, à destination en priorité des collèges et lycées publics ou privés
          (de la 6ème à la Terminale) en France hexagonale ou dans les DOMS, est développé
          dans 6 pays et compte des collaborations entre 12 partenaires. Sa dissémination est
          soutenue par le Fonds de Dotation Nouveau Monde.
        </p>
      </Paper>
    </div>
  </section>

  <!-- LES 3 PRINCIPES DU PROGRAMME -->
  <section class="section">
    <div class="page">
      <h2 class="c-t">Les 3 principes du Programme Euneos</h2>
      <ul class="methodo">
        {
          methodo.map((m) => (
            <li>
              <details class="methodo__card">
                <summary class="methodo__summary">
                  <span class="methodo__head">
                    <span class="methodo__picto" style={`color:${m.couleur}`}>
                      <Brand name={m.picto} />
                    </span>
                    <span class="methodo__title">{m.titre}</span>
                  </span>
                  <span class="methodo__intro">{m.intro}</span>
                  <span class="methodo__point-preview">
                    <span class="methodo__point">{m.points[0]}</span>
                    <span class="methodo__voile" aria-hidden="true" />
                  </span>
                  <span class="methodo__fleche" aria-hidden="true">
                    <svg viewBox="0 0 24 32" fill="currentColor"><path d="M9 0h6v20l6-6 2 2-11 11L1 16l2-2 6 6z" /></svg>
                  </span>
                </summary>
                <div class="methodo__body">
                  {m.points.slice(1).map((pt) => (
                    <p class="methodo__point">{pt}</p>
                  ))}
                </div>
              </details>
            </li>
          ))
        }
      </ul>
      <div class="c-cta">
        <Cta href="/candidater/etablissement" surface="bleu-fonce">Candidatez pour la rentrée 2026-2027</Cta>
      </div>
    </div>
  </section>

  <!-- NOTRE IMPACT — bloc de texte (maquette v4 p.2), juste avant les chiffres -->
  <section class="section resultat">
    <div class="page">
      <h2 class="c-t">Notre impact</h2>
      <p class="resultat__p">
        Des professionnels de l’éducation reconnus, formés et outillés ; des établissements où
        ces apprentissages se transmettent et s’évaluent dans la durée ; et des jeunes qui
        trouvent les ressources pour traverser leur parcours scolaire et identitaire avec
        équilibre.
      </p>
    </div>
  </section>

  <!-- IMPACT CHIFFRE — bloc encadre bleu, pli aplati haut-droit. -->
  <section class="section">
    <div class="page">
      <Paper surface="bleu" fold="tr" class="impact2">
        <div class="filigrane" aria-hidden="true">
          <div class="impact2__fig"><Brand name="fig3" height="100%" /></div>
        </div>
        <div class="impact2__in">
          <h2 class="impact2__t">Notre impact chiffré</h2>
          <ul class="impact2__list">
            {
              impact.map((s) => (
                <li>
                  <span class="chiffre chiffre--xl">{s.valeur}</span>
                  <p>{s.legende}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </Paper>
    </div>
  </section>

  <!-- 16H / 8 MODULES — section ajoutee dans la maquette v4 p.2 -->
  <section class="section">
    <div class="page">
      <h2 class="c-t">Une formation pratique en 16 h et 8 modules</h2>
      <ol class="modules">
        {
          modules.map((m) => (
            <li class="module">
              <span class="module__n">{m.n}</span>
              <span class="module__t">{m.titre}</span>
            </li>
          ))
        }
      </ol>
      <div class="c-cta">
        <Cta href="/candidater/etablissement" surface="bleu-fonce">Candidatez pour la rentrée 2026-2027</Cta>
      </div>
    </div>
  </section>

  <!-- DEROULEMENT : 5 etapes en quinconce, une couleur par etape -->
  <section class="section">
    <div class="page">
      <h2 class="c-t">Comment se déroule notre programme ?</h2>
      <p class="deroule__lead">
        De la candidature de l’établissement à l’implémentation des activités auprès des jeunes
        (en passant par l’évaluation et la formation des équipes éducatives), notre programme se
        déploie par étapes concrètes, pensées pour ancrer durablement les pratiques dans le
        quotidien scolaire.
      </p>
      <ol class="etapes">
        {
          etapes.map((e, i) => (
            <li class:list={['etapes__item', i % 2 === 1 && 'is-right']}>
              <Paper surface={e.surface} fold="tr" class="etapes__card">
                <p class="etapes__n">
                  <span>{e.n}</span> {e.titre}
                </p>
                <p class="etapes__txt">{e.texte}</p>
              </Paper>
            </li>
          ))
        }
      </ol>
      <div class="c-cta">
        <Cta href="/candidater/etablissement" surface="bleu-fonce">Téléchargez la brochure complète</Cta>
      </div>
    </div>
  </section>

  <CtaFinal id="candidater" />

  <!-- TEMOIGNAGES -->
  <section class="section">
    <div class="page">
      <h2 class="c-t">Ils ont vécu l’expérience</h2>
      <ul class="temoins">
        {
          temoins.map((t) => (
            <li class="temoin">
              <Paper surface="ocre" fold="none" class="etiquette temoin__name">{t.nom}</Paper>
              <div class="temoin__ph temoin__ph--symbol" aria-hidden="true">
                <Brand name="fig2" />
              </div>
              <Paper surface="papier" fold="br" class="temoin__card">
                <blockquote>{t.citation}</blockquote>
                <p class="temoin__role">{t.role}</p>
              </Paper>
            </li>
          ))
        }
      </ul>
      <div class="c-cta">
        <Cta href="/candidater/etablissement" surface="bleu-fonce">Candidatez pour les prochaines éditions</Cta>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="page faq">
      <div class="faq__col">
        <h2 class="faq__t">Questions fréquentes</h2>
        <dl class="faq__list">
          {
            faq.map((item) => (
              <details class="faq__item">
                <summary>{item.q}</summary>
                <p class:list={[item.brouillon && 'is-brouillon']}>{item.r}</p>
              </details>
            ))
          }
        </dl>
      </div>
      <div class="faq__media">
        <div class="faq__picto"><PictoBox picto="confettis" surface="orange" size="lg" paysage /></div>
        <Photo ratio="4/3" label="photo — équipe" />
        <div class="faq__cartouche"><Cartouche surface="jaune" fig="fig1" /></div>
      </div>
    </div>
  </section>

  <!-- BLOC FORMATEUR — grand bloc jaune (maquette v4 p.2, bas de page) -->
  <section class="section">
    <div class="page">
      <div class="formateur s-jaune">
        <h2>Vous souhaitez devenir formateur·rice ?</h2>
        <Cta href="/candidater/formateur" surface="bleu-fonce" class="formateur__cta">En savoir plus</Cta>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* HERO PROGRAMME : l'en-tete reste blanc sur le bleu, seul le lien courant
     passe en bleu fonce. Le cartouche rose s'aligne sur le haut de la photo. */
  .hero-zone.s-bleu .hdr {
    color: var(--blanc);
  }
  .hero-zone.s-bleu .hdr__link.is-active {
    color: #3e63cb;
  }
  .s-bleu .hz--mirror .hz__cartouche {
    top: 0;
  }

  @media (max-width: 860px) {
    /* La page Programme reprend la composition liee de l'accueil : cartouche
       contre la bulle, photo bornee, puis CTA a cheval. */
    .s-bleu .hz--mirror .hz__side {
      grid-template-columns: 20.45% 79.55% !important;
      align-items: end;
      margin-top: 3rem;
    }
    .s-bleu .hz--mirror .hz__cartouche {
      position: static;
      width: 100%;
      order: initial !important;
      margin: 0;
    }
    .s-bleu .hz--mirror .hz__media {
      order: initial;
      max-width: 100%;
      overflow: hidden;
      padding-left: 0;
    }
    .s-bleu .hz--mirror .hz__bubble {
      padding-bottom: calc(3rem + var(--t-bouton) * 0.71);
    }
    .s-bleu .hz--mirror .hz__cta {
      position: absolute;
      left: 0;
      right: 0;
      transform: translateY(29%);
      margin-top: 0;
      justify-content: center;
    }
  }

  /* BLOC ERASMUS — releve v4 p.2 a 1440 px : photo 381 x 568 de 88 a 469,
     carte bleue 890 x 568 de 469 a 1359, pli aplati 168 x 105 en bleu clair,
     texte blanc a 71 px du bord gauche et 39 px du haut. */
  .erasmus {
    display: grid;
    grid-template-columns: 30% 70%;
    align-items: stretch;
  }
  .erasmus__media {
    min-width: 0;
  }
  .erasmus__media > * {
    height: 100%;
    aspect-ratio: auto !important;
  }
  /* .s-bleu en plus : meme specificite que la surface, sinon l'encre verte
     de .s-bleu reprend le dessus sur le blanc */
  .erasmus__card.s-bleu {
    --fx: clamp(4rem, 11.7vw, 10.5rem);
    --fy: clamp(2.5rem, 7.3vw, 6.6rem);
    --fold-color: var(--bleu-clair);
    /* texte blanc sur le bleu, comme les cartes bleues de l'accueil */
    --on-surface: var(--blanc);
    min-height: clamp(12rem, 24vw, 22rem);
    padding: var(--s-int) clamp(2rem, 5vw, 4.5rem);
    padding-right: max(clamp(2rem, 5vw, 4.5rem), calc(var(--fx) + 0.5rem));
    display: grid;
    align-content: center;
    gap: 1rem;
  }
  .erasmus__l1 {
    font-size: var(--t-titre);
    font-weight: 600;
    line-height: var(--lh-titre);
  }
  .erasmus__l2 {
    font-size: var(--t-corps);
    line-height: var(--lh-corps);
  }
  @media (max-width: 860px) {
    .erasmus {
      grid-template-columns: 1fr;
    }
    .erasmus__media > * {
      height: auto;
      aspect-ratio: 3 / 2 !important;
    }
    .erasmus__card {
      min-height: 0;
      padding-top: max(var(--s-int), calc(var(--fy) + 0.5rem));
      padding-bottom: calc(var(--s-int) + 2.5rem);
      position: relative;
      z-index: 1;
      margin-top: -3.5rem;
    }
  }

  /* NOTRE IMPACT (texte) */
  .resultat__p {
    max-width: 64ch;
    margin: 0 auto;
    text-align: center;
  }

  /* intro « Comment se deroule » */
  .deroule__lead {
    max-width: 74ch;
    margin: 0 auto var(--s-titre);
    text-align: center;
  }

  /* 16H / 8 MODULES — deux colonnes, numero + titre (maquette v4 p.2) */
  .modules {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3.5vw, 3rem) clamp(2rem, 6vw, 5rem);
  }
  .module {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
    align-items: center;
  }
  .module__n {
    display: grid;
    place-items: center;
    width: clamp(2.6rem, 3.6vw, 3.25rem);
    aspect-ratio: 1;
    flex: none;
    background: var(--bleu-fold);
    color: var(--blanc);
    font-size: var(--t-h3);
    font-weight: 600;
    line-height: 1;
  }
  .module__t {
    font-size: max(1.05rem, 1.05vw);
    line-height: 1.35;
  }
  @media (max-width: 860px) {
    .modules {
      grid-template-columns: 1fr;
    }
  }

  /* BLOC FORMATEUR — grand bloc jaune, titre vert, CTA (maquette v4 p.2) */
  .formateur {
    background: var(--surface);
    color: var(--on-surface);
    display: grid;
    justify-items: center;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    text-align: center;
    padding: clamp(3rem, 7vw, 6rem) clamp(1.5rem, 5vw, 4rem);
  }
  .formateur h2 {
    max-width: 20ch;
  }

  /* WHY */
  .why__fig {
    color: var(--bleu);
  }
  /* maquette p.2 : le haut du titre est aligne avec le haut du paragraphe */
  .why__in {
    align-items: start;
  }
  .why {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .why__in h2 {
    margin-top: -0.12em;
  }
  .why__txt {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
