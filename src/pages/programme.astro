---
/**
 * Page 2 — Notre Programme.
 * Fidele a la maquette v7, page 2. Hero BLEU : c'est la couleur reservee
 * au Programme cle (« Le bleu est reserve pour le Programme cle d'Euneos »).
 */
import Brand from '../components/Brand.astro'
import Cartouche from '../components/Cartouche.astro'
import Cta from '../components/Cta.astro'
import CtaFinal from '../components/CtaFinal.astro'
import Paper from '../components/Paper.astro'
import Photo from '../components/Photo.astro'
import PictoBox from '../components/PictoBox.astro'
import Base from '../layouts/Base.astro'

/* Maquette : les pictos sont NUS, colores, poses sur le fond papier — pas dans
   un cartouche. Chaque colonne se termine par une fleche de depliage. */
const methodo = [
  {
    picto: 'main',
    couleur: 'var(--bleu)',
    titre: '2 pôles de compétences',
    intro: 'Une formation pensée pour transmettre de manière complémentaire :',
    points: [
      'Des compétences psychosociales : attention, régulation émotionnelle, coopération, empathie.',
      'Des pratiques équilibrées et régulées du numérique : clarifier les habitudes, comprendre les usages.',
    ],
  },
  {
    picto: 'asterisque',
    couleur: 'var(--rose)',
    titre: 'Enseignants formés',
    intro: 'Un accompagnement qui renforce la coopération, l’attention et apaise les climats de classe :',
    points: [
      'Avec une pratique de présence attentive intégrée au quotidien professionnel ;',
      'et des outils concrets pour réguler le stress numérique et la surcharge informationnelle.',
    ],
  },
  {
    picto: 'oiseau',
    couleur: 'var(--orange)',
    titre: 'Jeunes équilibrés',
    intro: 'Des jeunes qui développent des compétences fondamentales :',
    points: [
      'Concentration et stabilisation de leur attention.',
      'Régulation émotionnelle et une estime de soi plus solide.',
      'Des usages numériques plus conscients.',
    ],
  },
] as const

/* Les 5 etapes et leurs descriptifs, fournis le 20/08 (maquette v2 p.2).
   La v7 en comptait 6 avec des descriptifs en lorem : « Sélection » a disparu. */
const etapes = [
  {
    n: 1,
    titre: 'Rencontre de lancement',
    surface: 'papier',
    texte:
      'Présentation du programme à l’équipe éducative, identification du personnel volontaire (min. 5) et de la classe participante à l’évaluation scientifique.',
  },
  {
    n: 2,
    titre: 'Formation (16 h)',
    surface: 'bleu-clair',
    texte:
      'Formation structurée en présentiel ou hybride : attention, stress numérique, émotions, communication.',
  },
  {
    n: 3,
    titre: 'Atelier élèves',
    surface: 'rose',
    texte:
      '4 à 8 ateliers interactifs sur l’année : usages numériques, émotions, équilibre en ligne/hors ligne. Dès octobre, questionnaire T1 pour la classe participante à l’évaluation et la classe contrôle.',
  },
  {
    n: 4,
    titre: 'Intégration dans l’établissement',
    surface: 'orange',
    texte:
      'Pauses attentionnelles, coopération, autorégulation émotionnelle. Moments thématiques avec les familles possibles.',
  },
  {
    n: 5,
    titre: 'Évaluation & restitution',
    surface: 'jaune-clair',
    texte:
      'Questionnaires avant/après élèves, collaboration avec la recherche européenne. Questionnaires pré et post formation et suivi à + 45 jours.',
  },
] as const

const impact = [
  { valeur: '16', legende: 'établissements pilotes engagés en 2025/2026 dans 6 pays européens' },
  { valeur: '+145', legende: 'enseignants en formation et + de 800 élèves sensibilisés' },
  { valeur: '12', legende: 'organisations partenaires' },
  { valeur: '100 %', legende: 'des frais pris en charge par le Programme' },
]

/* Temoignages fournis le 20/08. Les prenoms portent un « ? » dans la maquette :
   Candice ne les a pas confirmes — on garde la marque pour ne pas l'oublier. */
const temoins = [
  {
    nom: 'Marie ?',
    citation:
      '« L’importance de s’arrêter et prendre conscience de soi et de ce que l’on ressent, accepter et accueillir nos émotions pour pouvoir guider les élèves. »',
    role: 'Enseignant·e, Collège Alexander Fleming (Orsay)',
  },
  {
    nom: 'Romain ?',
    citation:
      '« Formation essentielle pour que notre posture puisse accueillir le mal-être des élèves — ouvrir le débat, libérer la parole dans un emploi du temps très chargé. »',
    role: 'Enseignant·e, Lycée Jean d’Ormesson (Châteaurenard)',
  },
] as const

const faq = [
  /* Les 5 questions viennent de la maquette v2. Seule la derniere reponse y
     figure ; les 4 autres sont des propositions redigees a partir des donnees
     du meme document (etapes, format, financement) — A VALIDER par Candice. */
  {
    q: 'À partir de combien de personnes pouvons-nous envisager de rejoindre le Programme EUNEOS ?',
    r: 'À partir de 5 membres volontaires de l’équipe éducative. C’est le seuil qui permet à la dynamique de s’installer dans l’établissement plutôt que de reposer sur une seule personne. [proposition à valider]',
    brouillon: true,
  },
  {
    q: 'Quel est le format de la formation ?',
    r: '16 h de formation structurée, en présentiel ou en hybride, autour de quatre axes : attention, stress numérique, émotions, communication. [proposition à valider]',
    brouillon: true,
  },
  {
    q: 'Quelle typologie d’élèves peuvent participer aux ateliers et éventuels questionnaires d’évaluation ?',
    r: '[réponse à fournir]',
    brouillon: true,
  },
  {
    q: 'Avec quelle équipe se déroule l’accompagnement ?',
    r: '[réponse à fournir]',
    brouillon: true,
  },
  {
    q: 'À partir de quel moment peut-on appliquer les activités du Programme ?',
    r: 'Tout personnel formé peut commencer à mettre en place des activités issues du Programme avec des élèves, que ces derniers participent ou non aux ateliers. La mise en place peut être progressive et les activités assez libres pour autant qu’elles soient issues du programme et des ressources mises à disposition. On peut aussi appliquer les activités en dehors de la classe, dans des contextes de suivi individuel.',
  },
]
---

<Base
  title="Notre Programme — WISE-UP | EUNEOS"
  description="Le Programme EUNEOS : 16 h de formation pour les équipes éducatives, 4 à 8 ateliers jeunes, une évaluation scientifique. Aucun frais pour l’établissement. Candidatez pour la rentrée 2026."
  heroSurface="bleu"
  heroFold="bl"
>
  <!-- HERO bleu -->
  <section slot="hero" class="hz hz--mirror">
    <div class="hz__grid">
      <div class="hz__side">
        <div class="hz__cartouche"><Cartouche surface="rose" fig="fig3" /></div>

        <div class="hz__bubblewrap">
          <Paper outline fold="br" class="hz__bubble">
            <h1>
              <span class="hz__strong">Le Programme EUNEOS&nbsp;:</span>
              <span class="hz__soft">Des éducateurs outillés. Des jeunes soutenus.</span>
            </h1>
          </Paper>
          <div class="hz__cta"><Cta href="#candidater" surface="bleu-fonce">En savoir +</Cta></div>
        </div>
      </div>

      <div class="hz__media">
        <Photo ratio="5/4" label="photo — atelier en situation" />
      </div>

    </div>
  </section>

  <!-- WHY / WHAT -->
  <section class="section why has-silo">
    <div class="silo silo--right why__fig" aria-hidden="true"><Brand name="fig4" height="100%" /></div>
    <div class="page g16 why__in">
      <h2 style="grid-column: 3 / 8">
        Nous formons les équipes éducatives à la prévention de la santé mentale et au
        stress numérique
      </h2>
      <div style="grid-column: 9 / 14" class="why__txt">
        <p>
          Les jeunes d’aujourd’hui grandissent dans un monde saturé d’écrans que le milieu
          éducatif n’a pas encore été outillé pour accompagner. Au collège et au lycée, cela
          se traduit par : de l’attention fragmentée, du stress et de la fatigue numérique,
          des émotions intenses, des tensions relationnelles…
        </p>
        <p>
          EUNEOS agit pour que chaque adulte en établissement devienne un appui réel, et
          qu’aucun jeune ne reste seul face à ces enjeux.
        </p>
        <Cta href="/qui-sommes-nous" surface="bleu-fonce">Qui sommes-nous ?</Cta>
      </div>
    </div>
  </section>

  <!-- BANDEAU ERASMUS+ — ajoute dans la maquette v2 -->
  <section class="erasmus">
    <div class="page erasmus__in">
      <p class="erasmus__l1">Un Programme européen Erasmus+ (2025-2027)</p>
      <p class="erasmus__l2">100 % financé par le fond de dotation Nouveau Monde</p>
    </div>
  </section>

  <!-- METHODOLOGIE -->
  <section class="section">
    <div class="page">
      <h2 class="c-t">Notre méthodologie</h2>
      <ul class="methodo">
        {
          methodo.map((m) => (
            <li>
              <div class="methodo__head">
                <div class="methodo__picto" style={`color:${m.couleur}`}>
                  <Brand name={m.picto} />
                </div>
                <h3>{m.titre}</h3>
              </div>
              <p class="methodo__intro">{m.intro}</p>
              {m.points.map((pt) => (
                <p class="methodo__point">{pt}</p>
              ))}
              <span class="methodo__more" aria-hidden="true">
                <svg viewBox="0 0 24 32" fill="currentColor"
                  ><path d="M9 0h6v20l6-6 2 2-11 11L1 16l2-2 6 6z"></path></svg
                >
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- DEROULEMENT : 6 etapes en quinconce, une couleur par etape -->
  <section class="section">
    <div class="page">
      <h2 class="c-t">Comment se déroule notre programme ?</h2>
      <ol class="etapes">
        {
          etapes.map((e, i) => (
            <li class:list={['etapes__item', i % 2 === 1 && 'is-right']}>
              <Paper surface={e.surface} fold="tr" class="etapes__card">
                <p class="etapes__n">
                  <span>{e.n}</span> {e.titre}
                </p>
                <p class="etapes__txt">{e.texte}</p>
              </Paper>
            </li>
          ))
        }
      </ol>
      <div class="c-cta">
        <Cta href="/candidater/etablissement" surface="bleu-fonce">Candidatez pour la rentrée 2026</Cta>
      </div>
    </div>
  </section>

  <!-- LE RESULTAT — bloc de texte ajoute dans la maquette v2, juste avant les chiffres -->
  <section class="section resultat">
    <div class="page">
      <h2 class="c-t">Le résultat ?</h2>
      <p class="resultat__p">
        Des professionnels de l’éducation reconnus, formés et équipés, des établissements où
        ces apprentissages se transmettent et se mesurent, et des jeunes qui développent de
        quoi traverser leur parcours scolaire et identitaire avec équilibre.
      </p>
    </div>
  </section>

  <!-- IMPACT — releve au vecteur : bloc encadre (marges de 6,2 %), ratio 2,04,
       coin haut-droit coupe par un pli APLATI (69,2 x 22,7 pt). -->
  <section class="section">
    <div class="page">
      <Paper surface="bleu" fold="tr" class="impact2">
        <div class="filigrane" aria-hidden="true">
          <div class="impact2__fig"><Brand name="fig3" height="100%" /></div>
        </div>
        <div class="impact2__in">
          <h2 class="impact2__t">Notre impact chiffré</h2>
          <ul class="impact2__list">
            {
              impact.map((s) => (
                <li>
                  <span class="impact2__n">{s.valeur}</span>
                  <p>{s.legende}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </Paper>
    </div>
  </section>

  <!-- TEMOIGNAGES -->
  <section class="section">
    <div class="page">
      <h2 class="c-t">Ils ont vécu l’expérience</h2>
      <ul class="temoins">
        {
          temoins.map((t) => (
            <li class="temoin">
              <Paper surface="ocre" fold="none" class="temoin__name">{t.nom}</Paper>
              <div class="temoin__ph">
                <Photo ratio="3/4" label="portrait" />
              </div>
              <Paper surface="papier" fold="br" class="temoin__card">
                <blockquote>{t.citation}</blockquote>
                <p class="temoin__role">{t.role}</p>
              </Paper>
            </li>
          ))
        }
      </ul>
      <div class="c-cta">
        <Cta href="/candidater/etablissement" surface="bleu-fonce">Candidatez pour les prochaines éditions</Cta>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="page faq">
      <div class="faq__col">
        <h2 class="faq__t">Questions fréquentes</h2>
        <dl class="faq__list">
          {
            faq.map((item) => (
              <details class="faq__item">
                <summary>{item.q}</summary>
                <p class:list={[item.brouillon && 'is-brouillon']}>{item.r}</p>
              </details>
            ))
          }
        </dl>
      </div>
      <div class="faq__media">
        <div class="faq__picto"><PictoBox picto="confettis" surface="orange" size="clamp(74px, 8vw, 112px)" /></div>
        <Photo ratio="4/3" label="photo — équipe" />
        <div class="faq__cartouche"><Cartouche surface="jaune" fig="fig1" /></div>
      </div>
    </div>
  </section>

  <CtaFinal id="candidater" />
</Base>

<style is:global>
  /* BANDEAU ERASMUS — mesure au vecteur (maquette v2 p.2) :
     ligne 1 = 1,98 x le corps de texte, ligne 2 = exactement le corps
     (bbox identique a celle d'un mot de paragraphe : 13,08 pt). Vert #00382d. */
  .erasmus {
    padding-block: clamp(2rem, 5vw, 3.5rem) 0;
  }
  .erasmus__in {
    text-align: center;
    color: var(--vert);
  }
  .erasmus__l1 {
    font-size: 1.88em;
    font-weight: 700;
    line-height: 1.15;
  }
  .erasmus__l2 {
    font-size: 1em;
    margin-top: 0.35rem;
  }

  /* LE RESULTAT (v2) */
  .resultat__p {
    max-width: 64ch;
    margin: 0 auto;
    text-align: center;
  }

  /* WHY */
  .why__fig {
    color: var(--bleu);
  }
  .why__in {
    align-items: center;
  }
  .why__txt {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  @media (max-width: 860px) {
    .why__fig {
      display: none;
    }
  }


  /* METHODOLOGIE */
  .methodo {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  .methodo__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .methodo__picto {
    width: clamp(2.5rem, 4vw, 3.5rem);
    flex: none;
  }
  .methodo__head h3 {
    color: var(--vert);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
  }
  .methodo li p {
    max-width: 34ch;
  }
  /* La maquette n'utilise pas de puces : les points s'enchainent en
     paragraphes. */
  .methodo__point {
    max-width: 34ch;
    margin-top: 0.5rem;
    font-size: max(0.95rem, 0.95em);
    line-height: 1.45;
  }
  /* fleche de depliage, comme sur la maquette */
  .methodo__more {
    display: block;
    width: 1rem;
    margin-top: clamp(1rem, 2.5vw, 1.75rem);
    color: color-mix(in srgb, var(--noir) 28%, transparent);
  }
  @media (max-width: 860px) {
    .methodo {
      grid-template-columns: 1fr;
    }
  }

  /* reponse de FAQ encore a valider par le client */
  .faq__item p.is-brouillon {
    border-left: 3px solid var(--jaune);
    padding-left: 0.75rem;
  }

  /* ETAPES */
  .etapes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }
  .etapes__item {
    width: min(100%, 41rem);
  }
  .etapes__item.is-right {
    margin-left: auto;
  }
  .etapes__card {
    padding: clamp(1.1rem, 2.4vw, 1.75rem);
    --f: var(--fold-md);
  }
  .etapes__n {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--vert);
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }
  .etapes__n span {
    font-size: 2.25rem;
    line-height: 1;
  }
  .etapes__txt {
    margin-top: 0.75rem;
    opacity: 0.9;
  }

  /* IMPACT — bloc encadre, ratio et pli releves au vecteur */
  .impact2 {
    position: relative;
    overflow: hidden;
    aspect-ratio: 520.3 / 254.5;
    display: grid;
    place-items: center;
    /* pli aplati : 69,2 x 22,7 pt sur un bloc de 520,3 de large */
    --fx: 13.3%;
    --fy: 8.9%;
  }
  .impact2__fig {
    left: 26%;
    color: var(--bleu-clair);
  }
  .impact2 .filigrane {
    opacity: 0.22;
  }
  .impact2__in {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .impact2__t {
    text-align: center;
    color: var(--blanc);
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .impact2__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.75rem, 2.5vw, 2rem);
    text-align: center;
    color: var(--blanc);
  }
  .impact2__n {
    display: block;
    font-size: clamp(1.75rem, 4.4vw, 3rem);
    font-weight: 600;
    line-height: 1;
  }
  .impact2__list p {
    margin: 0.5rem auto 0;
    font-size: 0.92rem;
    line-height: 1.3;
    max-width: 15ch;
  }
  @media (max-width: 860px) {
    .impact2 {
      aspect-ratio: auto;
    }
    .impact2__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  /* TEMOIGNAGES */
  .temoins {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .temoin {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
  }
  .temoin__name {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
    padding: 0.7rem 1.2rem;
    font-weight: 600;
    z-index: 3;
    position: relative;
    margin-bottom: -0.4rem;
  }
  .temoin__ph {
    grid-column: 1;
    grid-row: 2;
    z-index: 2;
    position: relative;
  }
  .temoin__card {
    /* releve : pli aplati 60,3 x 25,2 pt sur un bloc de 205,9 x 175,9 */
    --fx: clamp(2.5rem, 10.1vw, 9.5rem);
    --fy: clamp(1.1rem, 4.2vw, 4rem);
    grid-column: 2;
    grid-row: 2;
    align-self: center;
    margin-left: -10%;
    padding: clamp(1.1rem, 2.2vw, 1.75rem);
    padding-left: clamp(2rem, 4vw, 3.25rem);
    z-index: 1;
    display: grid;
    gap: 0.9rem;
  }
  .temoin__card blockquote {
    margin: 0;
    font-style: italic;
  }
  .temoin__role {
    font-style: italic;
    font-size: 0.9rem;
    opacity: 0.8;
  }
  @media (max-width: 860px) {
    .temoins {
      grid-template-columns: 1fr;
    }
    .temoin {
      grid-template-columns: 1fr;
    }
    .temoin__name,
    .temoin__ph,
    .temoin__card {
      grid-column: 1;
      grid-row: auto;
      margin-left: 0;
    }
  }

  /* FAQ */
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .faq__t {
    text-align: left;
    color: var(--vert);
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .faq__list {
    margin: 0;
  }
  .faq__item {
    border-bottom: 1px solid color-mix(in srgb, var(--noir) 14%, transparent);
    padding: 1rem 0;
  }
  .faq__item summary {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary::after {
    content: '+';
    font-size: 1.4rem;
    line-height: 1;
    color: var(--vert);
  }
  .faq__item[open] summary::after {
    content: '–';
  }
  .faq__item p {
    margin-top: 0.75rem;
    max-width: 60ch;
  }
  .faq__media {
    position: relative;
  }
  .faq__picto {
    position: absolute;
    left: -12%;
    top: -10%;
    z-index: 1;
  }
  .faq__cartouche {
    position: absolute;
    right: -8%;
    bottom: -14%;
    width: 26%;
    min-width: 90px;
    z-index: 1;
  }
  @media (max-width: 860px) {
    .faq {
      grid-template-columns: 1fr;
    }
  }

</style>
