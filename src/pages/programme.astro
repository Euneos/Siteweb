  /* ETAPES — releve v4 (page 2, a 1440 px) : deux colonnes de cartes de
     611 x 409 px, gouttiere de 37 px, 41 px entre deux cartes d'une meme
     colonne, la colonne de droite decalee d'un quart de carte (104 px) vers
     le bas. Numero 94 px, titre 39 px, texte 24 px, pli de carte en haut a
     droite. Avant : une carte par ligne, chacune sur la moitie de la
     largeur — la moitie de chaque ligne restait vide (« trop d'espace »). */
  .etapes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2.9%;
    row-gap: clamp(1.25rem, 2.85vw, 2.6rem);
  }
  .etapes__item {
    min-width: 0;
  }
  /* quinconce : la colonne de droite descend d'un quart de carte. Le
     decalage est un transform, il ne modifie pas la grille : les cartes de
     gauche gardent leur espacement de 41 px. */
  .etapes__item.is-right {
    transform: translateY(25%);
  }
  /* si le nombre d'etapes est pair, la derniere carte (a droite) deborde du
     bas de la grille de ce quart : on le lui rend */
  .etapes__item.is-right:last-child {
    margin-bottom: 17%;
  }
  .etapes__card {
    --f: var(--fold-md);
    height: 100%;
    /* la maquette fait 409 px avec ses textes longs ; les textes actuels
       sont plus courts, on garde une hauteur mini un peu sous la maquette
       (22 vw = 317 px) pour ne pas laisser de vide — la carte grandit avec
       le texte */
    min-height: clamp(12rem, 22vw, 20rem);
    padding: var(--s-int);
    padding-right: max(var(--s-int), calc(var(--f) + 0.5rem));
    display: grid;
    align-content: start;
    gap: 0.5rem;
    /* les titres des etapes sont verts sur toutes les teintes, orange compris */
    --ink-titre: var(--vert);
  }
  .etapes__n {
    font-size: var(--t-h3);
    font-weight: 600;
    line-height: 1.15;
    color: var(--vert);
    display: flex;
    gap: 0.3em;
    align-items: flex-start;
  }
  .etapes__n span {
    font-size: var(--t-chiffre-xl);
    line-height: 0.82;
    flex: none;
  }
