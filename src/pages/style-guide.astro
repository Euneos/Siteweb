---
/**
 * /style-guide — le guide de style vivant du site.
 *
 * Ce n'est pas une page du site public : c'est l'outil de passation. Il montre
 * la charte telle qu'elle est REELLEMENT codee (les carres de couleur affichent
 * les variables CSS du site, pas des captures), et il explique a l'equipe
 * d'EUNEOS ou intervenir pour changer quelque chose.
 *
 * Ne pas indexer : `noindex` est pose dans le head via la prop `noindex`.
 */
import Brand from '../components/Brand.astro'
import Cartouche from '../components/Cartouche.astro'
import Cta from '../components/Cta.astro'
import Paper from '../components/Paper.astro'
import Photo from '../components/Photo.astro'
import PictoBox from '../components/PictoBox.astro'
import Base from '../layouts/Base.astro'

const teintes = [
  {
    nom: 'Vert',
    role: 'Couleur principale',
    regle: '« La couleur principale d’Euneos est le vert. » Fond des sections fortes, couleur des titres sur fond clair.',
    niveaux: [
      { var: '--vert-clair', hex: '#809B96' },
      { var: '--vert', hex: '#00382D', base: true },
      { var: '--vert-fold', hex: '#003229', pli: true },
    ],
  },
  {
    nom: 'Jaune',
    role: 'Couleur principale',
    regle: '« Le jaune est une couleur principale également. »',
    niveaux: [
      { var: '--jaune-clair', hex: '#FBE380' },
      { var: '--jaune', hex: '#F8C702', base: true },
      { var: '--jaune-fold', hex: '#B5913D', pli: true },
    ],
  },
  {
    nom: 'Bleu',
    role: 'Réservé au Programme',
    regle: '« Le bleu est réservé pour le Programme clé d’Euneos. » Donc WISE-UP, et nulle part ailleurs.',
    niveaux: [
      { var: '--bleu-clair', hex: '#C5D4FF' },
      { var: '--bleu', hex: '#8AA9FF', base: true },
      { var: '--bleu-fold', hex: '#3E63CB', pli: true },
    ],
  },
  {
    nom: 'Orange',
    role: 'Secondaire',
    regle: '« À utiliser par touches. » Un accent, jamais un fond de section entier.',
    niveaux: [
      { var: '--orange-clair', hex: '#F78858' },
      { var: '--orange', hex: '#FC5E27', base: true },
      { var: '--orange-fold', hex: '#C3471C', pli: true },
    ],
  },
  {
    nom: 'Rose',
    role: 'Secondaire',
    regle: '« À utiliser par touches. »',
    niveaux: [
      { var: '--rose-clair', hex: '#F9D9F7' },
      { var: '--rose', hex: '#F2B3F0', base: true },
      { var: '--rose-fold', hex: '#DD83DA', pli: true },
    ],
  },
]

const neutres = [
  { var: '--noir', hex: '#101312', label: 'Texte' },
  { var: '--papier', hex: '#F1EEEE', label: 'Fond de page — pas du blanc pur' },
  { var: '--blanc', hex: '#FFFFFF', label: 'Cartes, lettrage sur cartouche' },
]

/* L'echelle REELLE du site : les variables --t-* de global.css, relevees dans
   la maquette v4 a 1440 px. La charte donnait H1 56 / H2 40 / H3 20 / body 16 ;
   la maquette validee n'utilise pas ces valeurs, le site suit la maquette.
   Les exemples ci-dessous sont rendus avec les variables du site : ce que
   vous voyez ici est ce que le site affiche. */
const typo = [
  { n: 'Titre', px: '47 px', lh: '120 %', poids: 'SemiBold', ex: 'Titre de page et de section — H1 et H2 ont la même taille', cls: 'is-titre' },
  { n: 'Sous-titre', px: '39 px', lh: '120 %', poids: 'SemiBold', ex: 'Titre d’une étape du parcours', cls: 'is-h3' },
  { n: 'Bouton / étiquette', px: '36 px', lh: '110 %', poids: 'SemiBold', ex: 'Libellé d’un bouton, nom sur une étiquette', cls: 'is-cta' },
  { n: 'Titre de carte', px: '27 px', lh: '120 %', poids: 'SemiBold', ex: 'Titre des cartes bleues de l’accueil', cls: 'is-carte' },
  { n: 'Texte', px: '24 px', lh: '130 %', poids: 'Regular', ex: 'Texte courant, labels de formulaire, surtitres', cls: 'is-corps' },
  { n: 'Navigation', px: '21 px', lh: '130 %', poids: 'SemiBold', ex: 'Menu de l’en-tête', cls: 'is-nav' },
  { n: 'Note', px: '17 px', lh: '135 %', poids: 'Italique', ex: 'Note de source en bas de bloc', cls: 'is-note' },
  { n: 'Chiffre', px: '62 px · 94 px', lh: '100 %', poids: 'SemiBold', ex: '92 %', cls: 'is-chiffre' },
]

const pictos = [
  'papillon',
  'coeur',
  'main',
  'asterisque',
  'oiseau',
  'plante',
  'etoile',
  'galet',
  'confettis',
  'arche',
] as const

const coins = [
  { f: 'tl', label: 'haut-gauche' },
  { f: 'tr', label: 'haut-droit' },
  { f: 'bl', label: 'bas-gauche' },
  { f: 'br', label: 'bas-droit' },
] as const

const calibres = [
  { v: 'xl', label: 'Section', usage: 'le coin d’un grand bandeau de couleur' },
  { v: 'lg', label: 'Bloc', usage: 'une bulle de titre, un grand encart' },
  { v: 'md', label: 'Carte', usage: 'les cartes d’une grille' },
  { v: 'sm', label: 'Étiquette', usage: 'un CTA, un champ de formulaire' },
] as const

const demandes = [
  {
    quoi: 'Corriger un texte',
    exemple:
      '« Sur la page d’accueil, remplace “Apaisons l’environnement éducatif” par “Apaisons le climat scolaire”. »',
    delai: 'immédiat',
  },
  {
    quoi: 'Ajouter les textes manquants',
    exemple:
      '« Voici les trois paragraphes du bloc Programme de l’accueil : … Mets-les à la place des “À rédiger”. »',
    delai: 'immédiat',
  },
  {
    quoi: 'Changer une photo',
    exemple:
      '« Utilise la photo que je viens de déposer dans le Drive, dossier SITE WEB, pour le bandeau de la page Programme. »',
    delai: 'immédiat',
  },
  {
    quoi: 'Ajouter un témoignage d’établissement',
    exemple:
      '« Ajoute un témoignage sur la page Programme : “…”, signé Mme Untel, principale du collège X. »',
    delai: 'immédiat',
  },
  {
    quoi: 'Mettre à jour les chiffres',
    exemple: '« On est passés à 21 établissements engagés, mets à jour partout où le chiffre apparaît. »',
    delai: 'immédiat',
  },
  {
    quoi: 'Ajouter une page',
    exemple: '« Crée une page “Ressources” avec la même mise en page que “Qui sommes-nous”, et ajoute-la au menu. »',
    delai: 'à cadrer ensemble',
  },
  {
    quoi: 'Changer une couleur de la charte',
    exemple: '« Le vert doit être un peu plus clair : #004A3B au lieu de #00382D. »',
    delai: 'à cadrer ensemble',
  },
]

const seule = [
  {
    quoi: 'Voir les demandes reçues',
    ou: 'La boîte contact@euneos.fr et la base opérationnelle',
    detail:
      'Les candidatures alimentent la base opérationnelle. Les messages de contact arrivent par e-mail et la newsletter distingue établissement / partenaire / curieux dans Brevo.',
  },
  {
    quoi: 'Relire avant publication',
    ou: 'Un lien de prévisualisation',
    detail:
      'Chaque modification produit une adresse de test avant d’être publiée. Vous validez, puis ça part en ligne.',
  },
  {
    quoi: 'Revenir en arrière',
    ou: 'Demander à l’agent',
    detail:
      'Chaque version du site est conservée. « Reviens à la version d’avant-hier » suffit. Rien n’est jamais perdu.',
  },
]
---

<Base
  title="Guide de style — EUNEOS"
  description="Le guide de style vivant du site EUNEOS : couleurs, typographie, logo, pictogrammes, composants et mode d’emploi pour l’équipe."
  heroSurface="vert"
  heroFold="br"
  noindex
>
  <section slot="hero" class="page sg-hero">
    <p class="sg-hero__sur">Document de travail — non publié</p>
    <h1>Guide de style</h1>
    <p class="sg-hero__lead">
      Ce que la charte impose, tel que le site l’applique réellement. Les couleurs affichées
      ici sont celles du code : si l’une change, cette page change avec.
    </p>
  </section>

  <!-- LE CONCEPT -->
  <section class="section page sg">
    <h2 class="sg__t">1. Le concept</h2>
    <blockquote class="sg__cite">
      « Le logo Euneos, volontairement sobre, incarne la solidité institutionnelle et
      scientifique de la structure, tout en conservant un twist graphique sur deux lettres
      centrales. L’idée derrière cette mise en forme reprend le concept général de la charte :
      <strong>Euneos fait du format papier la symbolique de son ancrage dans le réel.</strong>
      On retrouve ainsi tout au long de cette charte des références à cet univers : le format A
      spécifique à l’impression papier, des effets de pliage… »
      <cite>Charte de l’identité visuelle, V3 — juillet 2026</cite>
    </blockquote>
    <p class="sg__p">
      Conséquence directe : <strong>chaque bloc du site est une feuille de papier avec un coin
      plié</strong>. Le triangle du pli prend la variante foncée de la couleur du bloc — ce que
      la charte appelle la « couleur + ». Tout est dessiné en CSS, aucune image : le pli
      s’adapte donc à n’importe quelle taille de bloc et de texte.
    </p>
  </section>

  <!-- COULEURS -->
  <section class="section page sg">
    <h2 class="sg__t">2. Couleurs</h2>
    <p class="sg__p">
      Cinq teintes, trois niveaux chacune. Le niveau du milieu est la couleur de référence, le
      plus foncé sert au pli. Les hexadécimaux sont ceux de la page 10 de la charte.
    </p>

    {
      teintes.map((t) => (
        <div class="sg-teinte">
          <div class="sg-teinte__head">
            <h3>{t.nom}</h3>
            <span class="sg-teinte__role">{t.role}</span>
          </div>
          <p class="sg-teinte__regle">{t.regle}</p>
          <ul class="sg-swatches">
            {t.niveaux.map((n) => (
              <li>
                <span class="sg-swatch" style={`background:var(${n.var})`} />
                <code>{n.hex}</code>
                <code class="sg-var">{n.var}</code>
                {n.base && <span class="sg-tag">référence</span>}
                {n.pli && <span class="sg-tag">couleur du pli</span>}
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <h3 class="sg__st">Neutres</h3>
    <ul class="sg-swatches sg-swatches--neutres">
      {
        neutres.map((n) => (
          <li>
            <span class="sg-swatch sg-swatch--bord" style={`background:var(${n.var})`} />
            <code>{n.hex}</code>
            <code class="sg-var">{n.var}</code>
            <span class="sg-tag">{n.label}</span>
          </li>
        ))
      }
    </ul>

    <h3 class="sg__st">Contraste — la seule liberté prise avec la charte</h3>
    <p class="sg__p">
      La charte demande que « les textes ne s’utilisent qu’en noir ou blanc ». Appliqué à la
      lettre sur le rose ou le bleu clair, le blanc donne un contraste de 1,7:1 et 2,2:1, très
      en dessous du minimum légal d’accessibilité (4,5:1). Le site met donc du vert foncé sur
      les teintes claires — ce que fait déjà la maquette de la page Programme, dont le titre est
      en vert sur fond bleu.
    </p>
    <ul class="sg-contrastes">
      <li class="s-vert"><span>Blanc sur vert</span> <b>13:1 — conforme</b></li>
      <li class="s-jaune"><span>Noir sur jaune</span> <b>11:1 — conforme</b></li>
      <li class="s-orange"><span>Blanc sur orange</span> <b>3,2:1 — gros titres seulement</b></li>
      <li class="s-bleu"><span>Vert foncé sur bleu</span> <b>7:1 — conforme</b></li>
      <li class="s-rose"><span>Vert foncé sur rose</span> <b>8:1 — conforme</b></li>
    </ul>
  </section>

  <!-- TYPOGRAPHIE -->
  <section class="section page sg">
    <h2 class="sg__t">3. Typographie</h2>
    <p class="sg__p">
      <strong>Open Sans SemiCondensed</strong>, deux graisses seulement : SemiBold et Regular.
      Police libre (licence OFL), hébergée sur le site — aucune dépendance à Google.
      L’interlettrage est à zéro partout.
    </p>
    <p class="sg__p">
      Une seule taille par rôle, sur toutes les pages : tous les titres ont la même taille, tout
      le texte courant aussi. Les valeurs ci-dessous sont celles de la maquette v4 sur un écran de
      1440 px ; elles diminuent d’elles-mêmes sur un écran plus petit. Pour changer une taille,
      demandez-le à l’agent : elle change partout d’un coup.
    </p>
    <ul class="sg-typo">
      {
        typo.map((t) => (
          <li>
            <span class="sg-typo__meta">
              <b>{t.n}</b> {t.px} · {t.lh} · {t.poids}
            </span>
            <span class:list={['sg-typo__ex', t.cls]}>{t.ex}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- LOGO -->
  <section class="section page sg">
    <h2 class="sg__t">4. Logo</h2>
    <p class="sg__p">
      Règle absolue de la charte : <strong>« les lettres du logo ne sont jamais colorisées,
      elles restent en noir et blanc »</strong>. C’est le cartouche qui prend la couleur. La zone
      de protection autour du logo vaut la largeur du glyphe « u » et doit rester vide.
    </p>
    <div class="sg-logos">
      <div class="sg-logo">
        <div class="sg-logo__box s-papier"><Brand name="wordmark" /></div>
        <p>Mot seul, sur fond clair</p>
      </div>
      <div class="sg-logo">
        <div class="sg-logo__box s-vert"><Brand name="wordmark" /></div>
        <p>Mot seul, sur fond foncé</p>
      </div>
      <div class="sg-logo">
        <div class="sg-logo__cart"><Cartouche surface="vert" fig="fig1" /></div>
        <p>Cartouche portrait, avec silhouette</p>
      </div>
      <div class="sg-logo">
        <div class="sg-logo__cart"><Cartouche surface="jaune" orientation="paysage" /></div>
        <p>Cartouche paysage, logo seul</p>
      </div>
    </div>
  </section>

  <!-- ICONOGRAPHIE -->
  <section class="section page sg">
    <h2 class="sg__t">5. Pictogrammes</h2>
    <p class="sg__p">
      Quinze figures en papier découpé, extraites de la charte. Cinq silhouettes humaines et dix
      symboles. Ils s’emploient en blanc dans un petit cartouche de couleur, ou en grand comme
      silhouette de débord.
    </p>
    <h3 class="sg__st">Les cinq silhouettes</h3>
    <ul class="sg-figs">
      {
        (['fig1', 'fig2', 'fig3', 'fig4', 'fig5'] as const).map((f) => (
          <li>
            <div class="sg-fig"><Brand name={f} /></div>
            <code>{f}</code>
          </li>
        ))
      }
    </ul>
    <h3 class="sg__st">Les dix symboles</h3>
    <ul class="sg-figs sg-figs--pictos">
      {
        pictos.map((p) => (
          <li>
            <div class="sg-fig"><Brand name={p} /></div>
            <code>{p}</code>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- LE PLI -->
  <section class="section page sg">
    <h2 class="sg__t">6. Le pli</h2>
    <p class="sg__p">
      Quatre coins possibles, quatre calibres. La charte prévient : <strong>« attention à ne pas
      en abuser, 1 ou 2 par composition maximum »</strong>.
    </p>

    <h3 class="sg__st">Les quatre coins</h3>
    <ul class="sg-grid4">
      {
        coins.map((c) => (
          <li>
            <Paper surface="vert" fold={c.f} foldSize="md" class="sg-demo">
              <span>{c.label}</span>
            </Paper>
            <code>fold="{c.f}"</code>
          </li>
        ))
      }
    </ul>

    <h3 class="sg__st">Les quatre calibres</h3>
    <ul class="sg-grid4">
      {
        calibres.map((c) => (
          <li>
            <Paper surface="jaune" fold="br" foldSize={c.v} class="sg-demo">
              <span>{c.label}</span>
            </Paper>
            <code>foldSize="{c.v}"</code>
            <p class="sg-usage">{c.usage}</p>
          </li>
        ))
      }
    </ul>

    <h3 class="sg__st">Version à filet</h3>
    <p class="sg__p">
      Sur un fond de couleur, le bloc peut n’être qu’un contour : le rabat se dessine alors en
      trois traits, comme une feuille dont on a corné le coin. C’est la bulle de titre des
      pages.
    </p>
    <div class="sg-outline s-vert">
      <Paper outline fold="tr" class="sg-demo sg-demo--lg"><span>Bloc à filet, coin plié</span></Paper>
    </div>
  </section>

  <!-- COMPOSANTS -->
  <section class="section page sg">
    <h2 class="sg__t">7. Composants</h2>

    <h3 class="sg__st">Étiquettes et boutons</h3>
    <div class="sg-row">
      <Cta href="#">Vert (défaut)</Cta>
      <Cta href="#" surface="bleu">Bleu — Programme</Cta>
      <Cta href="#" surface="jaune">Jaune</Cta>
      <Cta href="#" surface="rose">Rose</Cta>
      <Cta href="#" surface="ocre">Ocre</Cta>
    </div>
    <div class="sg-row s-vert sg-row--fonce">
      <Cta href="#" surface="papier">Sur fond foncé</Cta>
      <Cta href="#" outline>Contour</Cta>
    </div>

    <h3 class="sg__st">Cartouches à pictogramme</h3>
    <div class="sg-row">
      <PictoBox picto="main" surface="bleu" size="84px" />
      <PictoBox picto="asterisque" surface="jaune" size="84px" />
      <PictoBox picto="coeur" surface="rose" size="84px" />
      <PictoBox picto="oiseau" surface="orange" size="84px" />
      <PictoBox picto="etoile" surface="vert" size="84px" />
    </div>

    <h3 class="sg__st">Photo</h3>
    <p class="sg__p">
      Le cadre impose le format, l’image se recadre dedans. À gauche une photo, à droite
      l’emplacement vide qui sert à marquer « photo à fournir ».
    </p>
    <div class="sg-photos">
      <Photo ratio="4/3" />
      <Photo ratio="4/3" empty label="photo à fournir" />
    </div>

    <h3 class="sg__st">Les bonshommes : deux usages à ne pas confondre</h3>
    <div class="sg-silos">
      <div>
        <div class="sg-silo-demo s-papier">
          <div class="silo silo--left" style="color:var(--vert)"><Brand name="fig2" /></div>
          <p>Texte de la section, qui commence après la silhouette.</p>
        </div>
        <p class="sg-usage">
          <b>Silhouette de débord</b> — pleine, opaque, elle sort du cadre par un bord de page.
          Elle occupe la marge et <strong>jamais la zone de texte</strong>.
        </p>
      </div>
      <div>
        <div class="sg-silo-demo s-vert">
          <div class="filigrane"><div style="left:30%"><Brand name="fig3" /></div></div>
          <p class="sg-silo-demo__txt">Texte du bandeau, lisible par-dessus.</p>
        </div>
        <p class="sg-usage">
          <b>Filigrane</b> — très estompée (8 %), derrière le contenu d’un bandeau de couleur.
          Au-delà de cette valeur le texte devient sale.
        </p>
      </div>
    </div>
  </section>

  <!-- MODE D'EMPLOI -->
  <section class="section page sg">
    <h2 class="sg__t">8. Comment l’équipe fait vivre le site</h2>
    <p class="sg__p">
      Le site n’a pas d’interface d’administration à apprendre, et c’est volontaire : vous
      passez par l’agent, en français. Vous lui dites ce que vous voulez changer, il modifie le
      site, vous relisez, il publie. C’est exactement le fonctionnement prévu au départ du
      projet : <strong>une demande en langage naturel devient du code, versionné, puis mis en
      ligne automatiquement.</strong>
    </p>
    <p class="sg__p">
      Aucune de ces demandes ne peut casser le site : chaque version est conservée, et un
      retour en arrière est toujours possible.
    </p>

    <h3 class="sg__st">Ce que vous demandez à l’agent</h3>
    <div class="sg-modifs">
      {
        demandes.map((d) => (
          <Paper surface="blanc" fold="br" foldSize="md" class="sg-modif">
            <h3>{d.quoi}</h3>
            <p class="sg-modif__ex">{d.exemple}</p>
            <span class="sg-tag">{d.delai}</span>
          </Paper>
        ))
      }
    </div>

    <h3 class="sg__st">Ce que vous gardez la main dessus</h3>
    <ul class="sg-seule">
      {
        seule.map((x) => (
          <li>
            <b>{x.quoi}</b>
            <span class="sg-seule__ou">{x.ou}</span>
            <p>{x.detail}</p>
          </li>
        ))
      }
    </ul>

    <h3 class="sg__st">Les deux règles à retenir</h3>
    <ol class="sg-regles">
      <li>
        <b>Le bleu appartient au Programme.</b> Si une nouvelle page parle de WISE-UP, elle peut
        être bleue. Sinon, non — c’est le repère visuel qui permet de reconnaître le Programme
        d’un coup d’œil.
      </li>
      <li>
        <b>Le pli, une ou deux fois par composition.</b> C’est la charte qui le dit. Au-delà, le
        motif se banalise et la page devient bruyante.
      </li>
    </ol>

    <p class="sg__p sg__note">
      Les chemins de fichiers et le détail technique ne sont pas ici : ils sont dans le
      <code>AGENTS.md</code> du projet, à destination de qui intervient dans le code.
    </p>
  </section>
</Base>

<style is:global>
  .sg-hero {
    padding-bottom: clamp(2.5rem, 7vw, 5rem);
    max-width: 60ch;
  }
  .sg-hero__sur {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    color: var(--vert-clair);
    margin-bottom: 0.75rem;
  }
  .sg-hero__lead {
    margin-top: 1.25rem;
    font-size: 1.25rem;
    line-height: 1.4;
    color: color-mix(in srgb, currentColor 75%, transparent);
  }

  .sg {
    max-width: 78ch;
  }
  .sg__t {
    color: var(--vert);
    margin-bottom: 1.25rem;
  }
  .sg__st {
    margin: clamp(2rem, 5vw, 3rem) 0 1rem;
    color: var(--vert);
  }
