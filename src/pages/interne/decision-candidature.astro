---
import InternalLayout from '../../layouts/InternalLayout.astro'
import { getInternalContext, privateHeaders } from '../../lib/internal-context'
import { modeApercu } from '../../lib/forms'
export const prerender = false
for (const [key,value] of Object.entries(privateHeaders)) Astro.response.headers.set(key,value)
// Preview hosts never render a private identity, dossier or email payload.
if(modeApercu(Astro.request)) return new Response('Cet écran privé est indisponible dans un aperçu public.',{status:403,headers:privateHeaders})
const auth=await getInternalContext(Astro.request,Astro.locals)
if(auth instanceof Response)return auth
const dossier=Number(Astro.url.searchParams.get('dossier'))
if(!Number.isSafeInteger(dossier)||dossier<=0)return new Response('Choisissez un dossier exact depuis le suivi.',{status:400,headers:privateHeaders})
---
<InternalLayout title="Décision et emails" current="suivi" identity={auth.identity}>
  <div class="dm" id="decision-app" data-dossier={dossier} data-admin={auth.identity.admin}>
    <a class="dm-back" href={`/etat-candidatures#dossier-${dossier}`}>← Suivi des établissements</a>
    <header class="dm-header">
      <div><p class="iw-eyebrow">Candidature établissement</p><h1>Décision et emails</h1></div>
      <button class="iw-button" id="dm-refresh" type="button">Actualiser le dossier</button>
    </header>
    <p id="dm-feedback" class="dm-feedback" role="status" aria-live="polite">Chargement du dossier…</p>
    <section class="dm-card" aria-labelledby="dm-school"><h2 id="dm-school">Dossier {dossier}</h2>
      <p id="dm-context"></p><dl class="dm-facts"><div><dt>Statut actuel</dt><dd id="dm-status">À vérifier</dd></div>
      <div><dt>Email du référent</dt><dd id="dm-recipient">À vérifier</dd></div></dl>
    </section>
    <section class="dm-card" aria-labelledby="dm-choice-title">
      <h2 id="dm-choice-title">Choisir une décision</h2>
      <p id="dm-availability">Lecture en cours.</p>
      <form id="dm-form">
        <label for="dm-kind">Décision proposée</label>
        <select id="dm-kind" required disabled><option value="">Choisir…</option><option value="accepted">Candidature acceptée</option><option value="refused">Refus</option></select>
        <button class="iw-button iw-button--primary" id="dm-prepare" type="submit" disabled>Préparer la décision</button>
      </form>
    </section>
    <section class="dm-card" id="dm-preview" aria-labelledby="dm-preview-title" hidden>
      <h2 id="dm-preview-title" tabindex="-1">Vérifier avant de confirmer</h2>
      <p id="dm-transition" class="dm-transition"></p>
      <dl class="dm-facts"><div><dt>Destinataire</dt><dd id="dm-preview-to"></dd></div><div><dt>Objet</dt><dd id="dm-preview-subject"></dd></div></dl>
      <div id="dm-preview-text" class="dm-message"></div>
      <p id="dm-template-note" class="dm-note"></p>
      <label class="dm-confirm"><input type="checkbox" id="dm-consent" /> Je confirme cette décision pour cet établissement et cette cohorte.</label>
      <div class="dm-actions">
        <button class="iw-button" id="dm-save-only" type="button" disabled>Enregistrer sans email</button>
        <button class="iw-button iw-button--primary" id="dm-send" type="button" disabled>Enregistrer et envoyer</button>
        <button class="iw-button" id="dm-cancel" type="button">Annuler la préparation</button>
      </div>
    </section>
    <section class="dm-card" aria-labelledby="dm-journal-title"><h2 id="dm-journal-title">Historique des décisions et emails</h2>
      <p>Un email accepté par Brevo n’est pas encore une preuve de livraison. Un résultat incertain doit être vérifié avant tout nouvel envoi.</p>
      <ul id="dm-journal" class="dm-journal"><li>Aucun historique chargé.</li></ul>
    </section>
    <noscript><p>Activez JavaScript pour préparer une décision. Aucune modification n’a été faite.</p></noscript>
  </div>
</InternalLayout>
<script>import '../../scripts/candidature-decision-client'</script>
<style is:global>
  .dm{max-width:1080px;margin:0 auto}.dm-back{display:inline-block;margin-bottom:1.5rem}.dm-header{display:flex;gap:1rem;align-items:center;justify-content:space-between;margin-bottom:1.5rem}.dm-header h1{font-size:clamp(1.8rem,4vw,2.6rem);line-height:1.2}.dm-card{padding:clamp(1rem,3vw,2rem);background:#fff;border:1px solid #b5c5bd;margin:1.25rem 0}.dm-card h2{font-size:1.35rem;line-height:1.3;margin:0 0 1rem}.dm-card p{font-size:1rem;line-height:1.55}.dm-facts{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:1rem 0}.dm-facts dt{font-size:.85rem;font-weight:600}.dm-facts dd{margin:.3rem 0 0;overflow-wrap:anywhere;font-size:1rem}.dm form{display:grid;gap:.8rem;max-width:35rem}.dm label,.dm select{font-size:1rem}.dm select{padding:.7rem;min-height:44px;border:1px solid #708b7e;background:white;max-width:100%;width:100%}.dm-message{white-space:pre-wrap;overflow-wrap:anywhere;font-size:1rem;line-height:1.6;border-left:3px solid #f8c702;padding:1rem;background:#faf9f6}.dm-note,.dm-feedback{padding:1rem;background:#f5f0d8;font-size:1rem;overflow-wrap:anywhere}.dm-transition{font-weight:600}.dm-confirm{display:flex;gap:.8rem;align-items:flex-start;margin:1.5rem 0;line-height:1.5}.dm-confirm input{width:1.3rem;height:1.3rem;flex-shrink:0;margin-top:.15rem}.dm-actions{display:flex;gap:.8rem;flex-wrap:wrap}.dm .iw-button{white-space:normal;text-align:center;font-size:1rem;min-height:44px;max-width:100%}.dm button:disabled{opacity:.5;cursor:not-allowed}.dm-journal{padding-left:1.2rem}.dm-journal li{font-size:1rem;line-height:1.6;margin:.8rem 0;overflow-wrap:anywhere}.dm-journal button{display:block;margin-top:.5rem}.dm [hidden]{display:none!important}@media(max-width:600px){.dm-header{display:block}.dm-header button{margin-top:1rem}.dm-facts{grid-template-columns:1fr}.dm-actions{display:grid;grid-template-columns:1fr}.dm .iw-button{width:100%}.dm-card{margin:1rem 0}}
</style>
