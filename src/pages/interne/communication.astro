---
export const prerender = false
import InternalLayout from '../../layouts/InternalLayout.astro'
import { getInternalContext, privateHeaders } from '../../lib/internal-context'
const context = await getInternalContext(Astro.request, Astro.locals)
if (context instanceof Response) return context
for (const [key, value] of Object.entries(privateHeaders)) Astro.response.headers.set(key, value)
const links = [["Calendrier éditorial", "/interne/communication/calendriereditorial"], ["Suivi médias", "/interne/communication/suivimedias"], ["Partenariats", "/interne/communication/partenariats"], ["Veille", "/interne/communication/veille"]]
---
<InternalLayout title="Espace Communication" current="accueil" identity={context.identity} space="communication">
<section><p class="iw-eyebrow">EUNEOS · Espace interne</p><h1>Espace Communication</h1><div class="iw-space-grid">{links.map(([label,href]) => <a class="iw-space-card" href={href}><strong>{label}</strong><span aria-hidden="true">Ouvrir →</span></a>)}</div></section></InternalLayout>
