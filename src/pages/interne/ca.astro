---
export const prerender = false
import InternalLayout from '../../layouts/InternalLayout.astro'
import { readBoardIdentity } from '../../lib/board-access'
import { privateHeaders } from '../../lib/internal-context'
const access = await readBoardIdentity(Astro.request, Astro.locals)
if (access instanceof Response) return access
for (const [name, value] of Object.entries(privateHeaders)) Astro.response.headers.set(name, value)
---
<InternalLayout title="Espace CA — WISE-UP en un regard" current="ca" identity={{ email: access.email, admin: false }} teamAccess={false} boardView wide>
  <div id="ca-app">
    <section class="iw-panel ca-panel"><h2>Présenter EUNEOS</h2><div class="ca-resources"><article class="ca-resource"><h3>Notre programme</h3><p>Les objectifs, les modules et le parcours proposé aux établissements.</p><a href="https://drive.google.com/file/d/1KBJpL8AoUKOPbmT4LTsE_txrhWs1WER3/view" target="_blank" rel="noopener noreferrer">Ouvrir la brochure ↗</a></article><article class="ca-resource"><h3>Ressources & partenariats</h3><p>Nos ressources et les façons concrètes d’agir aux côtés d’EUNEOS.</p><a href="https://drive.google.com/file/d/1cuIUMvPAyvnWZgIuj4EM2A66aJbNx9Ta/view" target="_blank" rel="noopener noreferrer">Ouvrir le dossier partenariats ↗</a></article></div></section>
    <header class="ca-hero" id="ca-overview">
      <div><p class="iw-eyebrow">Conseil d’administration · Lecture seule</p><h1>WISE-UP<br />en un regard.</h1><p>Le point d’étape de la campagne et le réseau construit depuis 2025.</p></div>
      <div class="ca-goal"><span>Notre cap 2026–2027</span><strong>30</strong><span>établissements · 240 professionnels formés</span></div>
    </header>
    <div class="iw-resultsbar"><p id="ca-updated" class="iw-small">Lecture de la base en cours…</p><button id="ca-refresh" class="iw-button" type="button">Actualiser</button></div>
    <noscript><p class="iw-feedback">Activez JavaScript pour charger cette synthèse privée.</p></noscript>
    <p id="ca-state" class="iw-feedback" role="status">Chargement de la synthèse…</p>
    <div id="ca-data" hidden aria-busy="true">
      <section id="ca-project" aria-labelledby="ca-project-title">
        <h2 id="ca-project-title">Le suivi du projet 2026–2027</h2>
        <p class="iw-small">40 candidatures reçues : 33 dossiers rattachés à 2026–2027 et 7 dont l’année reste à confirmer, abandons compris. Doublons archivés exclus. Total retenu par la direction le 5 novembre 2026.</p>
        <dl class="ca-metrics">
          <div class="ca-metric"><dt>Candidatures reçues</dt><dd>40</dd><p>33 rattachées à 2026–2027 + 7 dont l’année reste à confirmer · abandons compris</p></div>
          <div class="ca-metric ca-metric--primary"><dt>Établissements candidats</dt><dd>30</dd><p>Suivi de projet confirmé par la direction</p></div>
          <div class="ca-metric"><dt>Établissements validés</dt><dd>23</dd></div>
          <div class="ca-metric"><dt>Détails à confirmer</dt><dd>7</dd></div>
        </dl>
      </section>
      <section class="iw-panel ca-panel" aria-labelledby="ca-deployment-note-title">
        <h2 id="ca-deployment-note-title">Déploiement WISE UP - ce que cela implique</h2>
        <p>30 équipes pédagogiques à former : rendre visible tout le travail qui permet le déploiement.</p>
        <div class="ca-visuals">
          <figure><a href="/api/interne/ca?visual=1" target="_blank" rel="noopener noreferrer" aria-label="Agrandir le visuel 1 : les parcours et le travail de coordination"><img src="/api/interne/ca?visual=1" alt="Déploiement 2026–2027 : objectif de 30 équipes, 23 créneaux confirmés sur 30, plus de 85 candidatures de formateurs et 16 heures par équipe. Les parcours établissements et formateurs nécessitent mobilisation, organisation, pédagogie et suivi." width="2646" height="1871" loading="lazy" /></a><figcaption>1 · Les parcours et le travail de coordination — cliquer pour agrandir.</figcaption></figure>
          <figure><a href="/api/interne/ca?visual=2" target="_blank" rel="noopener noreferrer" aria-label="Agrandir le visuel 2 : les situations de terrain et l’accompagnement dans la durée"><img src="/api/interne/ca?visual=2" alt="Des situations variables : formatrice interne ou externe, désistements et réaffectations. Accompagnement des équipes, familles, élèves et formateurs. Quatre établissements de l’année 1 souhaitent former de nouvelles équipes ; deux ont bénéficié d’un cofinancement avec l’EAFC de Créteil." width="2646" height="1871" loading="lazy" /></a><figcaption>2 · Les situations de terrain et l’accompagnement dans la durée — cliquer pour agrandir.</figcaption></figure>
        </div>
        <p class="iw-small">Point d’étape du 7 novembre 2026 : les 23 créneaux confirmés ne sont pas des formations déjà réalisées.</p>
        <p class="iw-small">Note de compréhension opérationnelle à destination du Fonds Nouveau Monde · PDF, 5 pages.</p>
        <a href="https://drive.google.com/file/d/1dE3Wk7EfIaAn0w_BMTfsw8O9S5IoDYa2/view" target="_blank" rel="noopener noreferrer">Consulter le document PDF ↗</a>
      </section>
      <section id="ca-report" hidden aria-labelledby="ca-report-title">
        <div class="ca-section-head"><h2 id="ca-report-title">Le déploiement en cours</h2><span id="ca-report-date" class="iw-badge"></span></div>
        <p class="iw-small">Source : point d’étape transmis par la direction au Fonds de dotation Nouveau Monde.</p>
        <dl class="ca-metrics ca-report-metrics">
          <div class="ca-metric"><dt>Professionnels recensés ou prévus</dt><dd id="ca-report-professionals">—</dd><p id="ca-report-professional-scope"></p></div>
          <div class="ca-metric"><dt>Démarrés ou programmés avant fin décembre</dt><dd id="ca-report-december">—</dd><p id="ca-report-started"></p></div>
          <div class="ca-metric"><dt>Régions représentées</dt><dd id="ca-report-regions">—</dd><p>Métropole et Guadeloupe</p></div>
        </dl>
        <details id="ca-review" hidden><summary>Vérification des candidatures et des effectifs</summary><p id="ca-review-applications"></p><p id="ca-review-people"></p></details>
        <div class="ca-next-step"><strong>Prochain cap</strong><p id="ca-report-next"></p></div>
        <details><summary>Voir le calendrier de déploiement · point d’étape validé</summary><p class="iw-small">Cibles conventionnelles : 15 établissements de septembre à décembre 2026, puis 15 de janvier à juin 2027. Les jours encore à préciser restent indiqués comme tels.</p><div id="ca-report-schedule" class="ca-report-schedule"></div></details>
      </section>
      <section class="ca-base-heading"><h2>Le réseau et le déploiement</h2><p class="iw-small">Le suivi de formation concerne uniquement la campagne actuelle. Le réseau de formateurs conserve toutes les promotions.</p></section>
      <dl class="ca-metrics">
        <div class="ca-metric"><dt>Formateurs validés</dt><dd id="ca-people">—</dd><p>Toutes promotions · personnes distinctes</p></div>
        <div class="ca-metric"><dt>Formateurs en parcours</dt><dd id="ca-evaluation">—</dd><p>Formation ou validation en cours</p></div>
      </dl>
      <details><summary>Consulter le suivi administratif détaillé et les points à vérifier</summary><div class="ca-columns">
        <section class="iw-panel ca-panel" aria-labelledby="ca-pipeline-title"><p class="iw-eyebrow">Recrutement</p><h2 id="ca-pipeline-title">Du premier contact à l’engagement</h2><div id="ca-pipeline" class="ca-bars"></div><p id="ca-unqualified" class="iw-small"></p></section>
        <section class="iw-panel ca-panel ca-attention" aria-labelledby="ca-attention-title"><p class="iw-eyebrow">À suivre avec l’équipe</p><h2 id="ca-attention-title">Points d’attention</h2><ul id="ca-attention"></ul><p class="iw-small iw-muted">Signaux issus de la base, à qualifier avec l’équipe. Une candidature ancienne ne prouve pas une absence de suivi.</p></section>
      </div></details>
      <section class="iw-panel ca-panel" id="ca-territories" aria-labelledby="ca-map-title">
        <div class="ca-section-head"><div><p class="iw-eyebrow">Déploiement territorial</p><h2 id="ca-map-title">Les établissements engagés, sur la carte</h2></div><span class="iw-badge">Précision : commune</span></div>
        <div class="iw-field"><label for="ca-period">Années affichées sur la carte uniquement</label><select id="ca-period"><option value="all">2025–2026 et 2026–2027</option></select></div><p id="ca-scope-note" class="iw-small"></p>
        <div id="ca-map-tabs" class="ca-map-tabs" role="group" aria-label="Territoire affiché"></div>
        <div class="ca-map-grid"><div><div class="ca-map"><img id="ca-map-image" src="/maps/metropole.svg" alt="" width="1000" height="650" /><div id="ca-markers"></div></div><p class="iw-small iw-muted">Chaque repère indique le nombre d’établissements dans une commune. Choisissez-le pour afficher leurs noms ; la liste complète reste disponible ci-contre.</p></div><aside><h3 id="ca-map-selection" tabindex="-1">Établissements du territoire</h3><p id="ca-map-count" class="iw-small"></p><ul id="ca-map-schools" class="ca-school-list"></ul><button id="ca-map-all" type="button" class="iw-button" hidden>Tout le territoire</button></aside></div>
        <details><summary id="ca-unlocated-title">Localisations à préciser</summary><ul id="ca-unlocated"></ul></details>
      </section>
      <div class="ca-columns" id="ca-training">
        <section class="iw-panel ca-panel"><p class="iw-eyebrow">Mise en œuvre</p><h2>Où en sont les formations ?</h2><div id="ca-training-statuses" class="ca-bars"></div><h3>Calendrier renseigné</h3><div id="ca-schedule" class="ca-pills"></div><p class="iw-small iw-muted">Dates de début enregistrées, pas une preuve de réalisation. Les états ci-dessus reprennent le suivi de formation saisi dans la base.</p></section>
        <section class="iw-panel ca-panel"><p class="iw-eyebrow">Prochaines étapes</p><h2>Les prochains démarrages</h2><ol id="ca-upcoming" class="ca-timeline"></ol><p class="iw-small iw-muted">Six prochaines dates de début renseignées pour les dossiers engagés. Calendriers susceptibles d’évoluer.</p></section>
      </div>
      <div class="ca-columns">
        <section class="iw-panel ca-panel" id="ca-trainers"><p class="iw-eyebrow">Collectif de formateurs · Toutes promotions</p><h2>Le réseau de formateurs</h2><div id="ca-trainer-summary" class="ca-pills"></div><h3>Formateurs validés par promotion</h3><div id="ca-trainer-promotions" class="ca-bars"></div><p id="ca-trainer-scope" class="iw-small iw-muted"></p><p class="iw-small">Personnes dédoublonnées par identifiant. Les candidatures, refus et abandons ne sont pas comptés comme formateurs validés. La disponibilité n’est pas déduite de la validation.</p></section>
        <section class="iw-panel ca-panel" id="ca-science"><h2>Comité scientifique et évaluation</h2><p>Clémence Gayet est recrutée en novembre 2026 pour lancer la phase 1 : constituer et installer le comité scientifique. Celui-ci réunira des chercheurs et des experts de terrain pour éclairer l’évolution de WISE UP et préparer les orientations d’une future évaluation scientifique.</p><details><summary>Suivi de l’évaluation 2026–2027</summary><p id="ca-evaluation-detail" class="ca-callout"></p><a href="https://drive.google.com/file/d/1taQsrq99GBaHqdQlvaZFVXyS0IbqOh8N/view" target="_blank" rel="noopener noreferrer">Lire le guide d’évaluation ↗</a></details><h3>Publication : Étude européenne</h3><p>4 700 élèves de six pays interrogés entre décembre 2025 et mars 2026. Ces résultats décrivent les usages numériques avant intervention ; ils ne mesurent pas encore l’efficacité du programme.</p><a href="https://drive.google.com/file/d/1guC2NUHHhTqDCkq-BMIQmgci7_wP000H/view" target="_blank" rel="noopener noreferrer">Lire l’Étude européenne ↗</a></section>
      </div>
      <section class="iw-panel ca-panel" id="ca-trainer-map"><h2>La carte des formateurs</h2><p>Toutes promotions de formateurs validés. Repères par commune ; les effectifs et promotions sont affichés sans coordonnées personnelles.</p><div id="ct-map-tabs" class="ca-map-tabs" role="group" aria-label="Territoire des formateurs"></div><div class="ca-map-grid"><div class="ca-map"><img id="ct-map-image" src="/maps/metropole.svg" alt="" width="1000" height="650" /><div id="ct-markers"></div></div><aside><h3 id="ct-map-selection">Formateurs du territoire</h3><p id="ct-map-count" class="iw-small"></p><ul id="ct-map-schools" class="ca-school-list"></ul><button id="ct-map-all" type="button" class="iw-button" hidden>Tout le territoire</button></aside></div><details><summary id="ct-unlocated-title">Localisations à préciser</summary><ul id="ct-unlocated"></ul></details></section>
      <section id="ca-involvement" class="iw-panel ca-panel"><p class="iw-eyebrow">Le CA, une force d’appui</p><h2>Vous investir dans EUNEOS</h2><p>Quelques exemples d’actions à choisir selon vos envies, vos compétences et votre réseau.</p><div class="ca-resources">
        <article class="ca-resource"><h3>Ouvrir une porte</h3><p>Présenter EUNEOS à une direction d’établissement, un réseau éducatif ou une collectivité et proposer une mise en relation avec l’équipe.</p></article>
        <article class="ca-resource"><h3>Contribuer au futur comité</h3><p>Proposer des chercheurs et des experts de terrain susceptibles de contribuer à la conception et à l’évaluation scientifique du programme.</p></article>
        <article class="ca-resource"><h3>Proposer des parrainages</h3><p>Suggérer de nouveaux parrains ou marraines et des contacts pour les approcher, en complément des pistes déjà recensées.</p><a href="https://docs.google.com/spreadsheets/d/1sP-tXKcYjOqnLyox4QPa8vAcEUcsTtlO/edit" target="_blank" rel="noopener noreferrer">Listes parrains et partenaires ↗</a></article>
        <article class="ca-resource"><h3>Faire connaître le programme</h3><p>Partager les communications validées d’EUNEOS et les prochaines campagnes auprès de vos réseaux professionnels.</p></article>
        <article class="ca-resource"><h3>Repérer des soutiens</h3><p>Identifier une fondation, une entreprise ou un mécène pertinent et faciliter un premier contact avec la direction.</p></article>
        <article class="ca-resource"><h3>Apporter votre regard</h3><p>Relire un support, participer à un groupe de travail ou partager une expertise utile aux ateliers, à la stratégie ou à l’évaluation.</p></article>
      </div><p class="ca-next-step"><strong>Une idée concrète ?</strong> Proposez à Candice une action, un contact ou un créneau de disponibilité, pour convenir ensemble de la suite.</p></section>
      <section class="iw-panel ca-panel"><h2>Actus récentes</h2>
        <h3>Novembre 2026 · Comité scientifique et évaluation</h3>
        <p>Recrutement de Clémence Gayet pour lancer la phase 1 du développement du comité scientifique : constitution et installation du comité, en lien avec la direction et les membres du CA mobilisés.</p>
        <p>La fiche de mission est synthétisée en quatre axes de travail :</p>
        <ol class="ca-science-axes">
          <li><strong>Constituer et animer le comité :</strong> mobiliser un premier noyau pluridisciplinaire, définir son fonctionnement et préparer les réunions.</li>
          <li><strong>Porter un regard scientifique sur WISE UP :</strong> examiner ses fondements et sa cohérence pédagogique, puis formuler des recommandations d’adaptation.</li>
          <li><strong>Préparer la reconnaissance institutionnelle :</strong> étudier les exigences de ReperPrev, des agréments académiques et de la démarche Édusanté.</li>
          <li><strong>Préparer une future évaluation scientifique :</strong> identifier les questions de recherche, les partenariats et une feuille de route 2027–2028.</li>
        </ol>
        <p class="iw-small">La mission prépare les conditions de l’évaluation ; elle ne comprend pas la réalisation d’une évaluation scientifique indépendante.</p>
        <p><a href="https://shs.cairn.info/publications-de-clemence-gayet--795352?lang=fr" target="_blank" rel="noopener noreferrer">Clémence Gayet · Profil et publications sur Cairn ↗</a></p>
        <h3>17 novembre 2026 · Parcours BeFree</h3>
        <p>Discussion prévue avec Parcours BeFree.</p>
        <h3>Parrainages et mises en relation</h3>
        <p>Parrainage et rencontre avec Jean-Lou Fourquet ; échanges avec Wake Up Prod et Gilles Vernet.</p><p>Le CA peut suggérer de nouveaux parrainages et faciliter une mise en relation avec un établissement identifié. Vous pouvez aussi consulter le fichier de prospection que nous avons commencé :</p><p><a href="https://docs.google.com/spreadsheets/d/1sP-tXKcYjOqnLyox4QPa8vAcEUcsTtlO/edit" target="_blank" rel="noopener noreferrer">Consulter les onglets Parrainage et Partenaires ↗</a></p><p class="iw-small">Ces listes sont des pistes de prospection, pas une liste de soutiens acquis.</p></section>
      <section class="iw-panel ca-panel" id="ca-resources"><p class="iw-eyebrow">Comprendre le programme</p><h2>Les ressources pédagogiques</h2><p class="iw-small iw-muted">Guides et documents de référence. Les droits des documents externes restent ceux définis dans leur outil d’origine.</p><div id="ca-resource-list" class="ca-resources"></div></section>
      <section class="iw-panel ca-panel" id="ca-internal-pages"><h2>Pages internes créées pour le suivi du projet</h2><p>Les onglets utilisés par l’équipe pour le suivi opérationnel :</p><ul><li>Calendriers de l’équipe</li><li>Organisation équipe</li><li>Suivi des établissements</li><li>Suivi des formateurs</li><li>Implantations</li><li>Formulaires</li><li>Réponses à vérifier</li><li>Ressources formateurs</li><li>Gérer les ressources</li></ul><p class="iw-small">Présentation des outils uniquement : ces pages restent réservées à leurs utilisateurs autorisés.</p></section>
      <details class="ca-method"><summary>Sources et règles de lecture</summary><p>Le point d’étape est daté et validé par la direction ; il reste présenté à sa date de référence, même après une date de démarrage annoncée. Les compteurs complémentaires et la carte sont lus dans NocoDB pour 2025–2026 et 2026–2027. Les anciens doublons archivés sont exclus. Un même établissement sur deux cohortes est dédoublonné dans le total, mais reste présent dans chaque année.</p><p>Les sites du point d’étape et les établissements de la base sont deux unités distinctes : un établissement peut regrouper plusieurs sites. Aucune fusion ou création de dossier n’est déduite de ce rapprochement. Les professionnels recensés ne sont pas présentés comme déjà formés.</p><p>Les formateurs sont comptés selon leur statut explicite et leur promotion, y compris sans lien à une cohorte d’établissements. Le compteur d’évaluation reprend uniquement les demandes affirmatives ; les données absentes ne sont pas assimilées à des refus.</p><p>Cartes locales : référentiel des communes du 17 septembre 2026, fonds régionaux Etalab / IGN 2026, Licence Ouverte. Aucun contact ni adresse d’école n’est transmis à un service cartographique.</p><p>Accès nominatif en lecture seule. Cette vue ne donne accès ni aux dossiers individuels, ni aux conventions, ni aux heures de l’équipe.</p></details>
    </div>
  </div>
  <script src="../../scripts/board-dashboard-client.ts"></script>
</InternalLayout>
<style is:global>
  #ca-app { display: grid; gap: var(--s-lie); --ca-tint: var(--jaune-clair); --ca-accent: var(--jaune); --ca-fold: var(--jaune-fold); }
  #ca-data { display: grid; gap: var(--s-lie); }
  #ca-app section, #ca-app header { scroll-margin-top: 1rem; }
  .ca-hero { display: flex; justify-content: space-between; align-items: center; gap: var(--s-grille); background: var(--ca-tint); border-bottom: 5px solid var(--ca-accent); padding: var(--s-int); position: relative; }
  .ca-hero::after { content: ''; position: absolute; top: 0; right: 0; width: 2rem; height: 2rem; background: var(--ca-fold); clip-path: polygon(0 0,100% 100%,0 100%); }
  .ca-hero h1 { margin-block: 1rem !important; }
  .ca-goal { display: grid; text-align: center; flex: 0 0 12rem; }
  .ca-goal strong { font-size: var(--t-chiffre-xl); line-height: 1.1; }
  .ca-goal span { font-size: var(--iw-small); }
  .ca-metrics { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 1rem; margin: 0; }
  .ca-metric { padding: 1.25rem; background: white; border-top: 4px solid var(--ca-accent); }
  .ca-metric--primary { background: var(--vert); color: white; border-color: var(--jaune); }
  .ca-metric dt, .ca-metric p { font-size: var(--iw-small); }
  .ca-metric dd { font-size: var(--t-chiffre); font-weight: 600; line-height: 1.2; margin: .5rem 0; }
  .ca-metric progress { width: 100%; height: .7rem; accent-color: var(--jaune); margin-top: 1rem; }
  .ca-columns { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--s-lie); }
  .ca-report-metrics { margin-top: 1.25rem; grid-template-columns: repeat(3,minmax(0,1fr)); }
  .ca-report-schedule { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; margin-block: 1rem; }
  .ca-report-group { background: white; border-top: 4px solid var(--ca-accent); padding: 1rem; }
  .ca-report-group h3 { font-size: var(--t-carte); }
  .ca-report-group ul { padding-left: 1.1rem; }
  .ca-report-group li { margin-top: .6rem; }
  .ca-report-group small { display: block; font-size: var(--iw-small); color: var(--iw-muted); }
  .ca-next-step { padding: 1.25rem; background: var(--ca-tint); margin-top: 1rem; }
  .ca-base-heading { border-top: 3px solid var(--vert); padding-top: 1.5rem; }
  .ca-base-heading .iw-field { margin-block: 1rem; max-width: 32rem; }
  .ca-panel { padding: 1.5rem; min-width: 0; }
  .ca-panel h2 { margin-block: .4rem 1.25rem !important; }
  .ca-panel h3 { font-size: var(--iw-text); margin-block: 1rem .5rem !important; }
  .ca-panel p + p { margin-top: .75rem !important; }
  .ca-science-axes { padding-left: 1.5rem; display: grid; gap: .75rem; margin-block: 1rem; }
  .ca-visuals { display: grid; gap: var(--s-lie); margin-block: var(--s-lie); }
  .ca-visuals figure { margin: 0; min-width: 0; }
  .ca-visuals a { display: block; }
  .ca-visuals img { display: block; width: 100%; height: auto; }
  .ca-visuals figcaption { font-size: var(--iw-small); margin-top: .5rem; }
  .ca-section-head { display: flex; align-items: start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .ca-bars { display: grid; gap: .9rem; margin-block: 1rem; }
  .ca-bar-label { display: flex; justify-content: space-between; gap: 1rem; font-size: var(--iw-small); }
  .ca-bar-track { height: .6rem; background: var(--papier); margin-top: .35rem; }
  .ca-bar-fill { height: 100%; background: var(--vert); }
  .ca-bar:nth-child(3) .ca-bar-fill { background: var(--ca-fold); }
  .ca-attention { background: var(--ca-tint); }
  .ca-attention ul { padding-left: 1.2rem; display: grid; gap: .8rem; }
  .ca-map-tabs { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1rem; }
  .ca-map-tabs button[aria-pressed='true'] { background: var(--vert); color: white; }
  .ca-map-grid { display: grid; grid-template-columns: minmax(0,2fr) minmax(0,1fr); gap: 1.5rem; }
  .ca-map { position: relative; aspect-ratio: 1000 / 650; background: #fafbf8; border: 1px solid var(--iw-line); }
