---
export const prerender = false
import InternalLayout from '../../layouts/InternalLayout.astro'
import { getInternalContext, privateHeaders } from '../../lib/internal-context'
const context = await getInternalContext(Astro.request, Astro.locals)
if (context instanceof Response) return context
for (const [key, value] of Object.entries(privateHeaders)) Astro.response.headers.set(key, value)
const links = [["Équipe & heures", "/interne/equipeheures"], ["Organisation équipe", "/interne/organisation-equipe"]]
---
<InternalLayout title="Espace Équipe" current="accueil" identity={context.identity} space="equipe">
<section><p class="iw-eyebrow">EUNEOS · Espace interne</p><h1>Espace Équipe</h1><div class="iw-space-grid">{links.map(([label,href]) => <a class="iw-space-card" href={href}><strong>{label}</strong><span aria-hidden="true">Ouvrir →</span></a>)}</div></section></InternalLayout>
