---
export const prerender = false
import { topicClass } from '../../../lib/topic-tags'
import InternalLayout from '../../../layouts/InternalLayout.astro'
import { getInternalContext, privateHeaders } from '../../../lib/internal-context'
import { watchThemes, watchSources, watchOrigins, watchUsages } from '../../../lib/thematic-watch'
import '../../../styles/thematic-watch.css'
const c = await getInternalContext(Astro.request, Astro.locals)
if (c instanceof Response) return c
for (const [k, v] of Object.entries(privateHeaders)) Astro.response.headers.set(k, v)
const filters = [
  ['themes', 'Thème', watchThemes],
  ['usages', 'Usage', watchUsages],
  ['provenance', 'Provenance', watchOrigins],
  ['source_type', 'Source', watchSources],
] as const
---

<InternalLayout
  title="Veille thématique"
  current="veille"
  space="communication"
  identity={c.identity}
  wide
>
  <div id="thematic-watch">
    <header class="vw-hero">
      <div>
        <p class="vw-eyebrow">Espace Communication</p><h1>Veille thématique</h1><p
          id="vw-week-label"
        >
        </p><p class="vw-lead">
          Des sujets pour nourrir nos publications, préparer des rencontres et ouvrir des échanges
          avec les établissements et les partenaires.
        </p><p id="vw-summary"></p>
      </div>
      <label class="vw-week"
        >Semaine<select id="vw-week" aria-label="Semaine de veille"></select></label
      >
    </header>
    <section class="vw-filters" aria-label="Filtres de la veille">
      {
        filters.map(([key, label, values]) => (
          <div class="vw-filter">
            <>
              <strong>{label}</strong>
              <div role="group" aria-label={label}>
                <button type="button" data-filter={key} data-value="" aria-pressed="true">
                  Tous
                </button>
                {values.map((v) => (
                  <button
                    type="button"
                    class={key === 'themes' ? topicClass(v) : undefined}
                    data-topic={key === 'themes' ? v : undefined}
                    data-filter={key}
                    data-value={v}
                    aria-pressed="false"
                  >
                    {v}
                  </button>
                ))}
              </div>
            </>
          </div>
        ))
      }
      <div class="vw-filter">
        <strong>Statut</strong><div role="group" aria-label="Statut d’usage">
          {
            ['Tous', 'à faire', 'brouillon', 'fait', 'abandonné'].map((v) => (
              <button
                type="button"
                data-filter="status"
                data-value={v === 'Tous' ? '' : v}
                aria-pressed={v === 'Tous'}
              >
                {v}
              </button>
            ))
          }
        </div>
      </div>
      <div class="vw-tools">
        <label class="iw-field"
          >Rechercher<input
            id="vw-search"
            type="search"
            placeholder="Un sujet, une source…"
          /></label
        ><button id="vw-reset" class="iw-button">Effacer les filtres</button><button
          id="vw-research"
          class="iw-button">Lancer une recherche</button
        ><button id="vw-add" class="iw-button iw-button--primary" disabled
          >+ Ajouter une fiche</button
        >
      </div>
    </section>
    <p id="vw-feedback" class="iw-feedback" role="status" aria-live="polite">
      Chargement de la veille…
    </p>
    <section class="vw-group" aria-labelledby="vw-todo-title">
      <h2 id="vw-todo-title">Les sujets <span id="vw-todo-count"></span></h2><div id="vw-todo">
      </div>
    </section>
    <noscript><p>Activez JavaScript pour lire et modifier les fiches.</p></noscript>
  </div>
  <dialog id="vw-editor" class="vw-dialog" aria-labelledby="vw-editor-title">
    <form id="vw-form">
      <div class="vw-dialog-head">
        <h2 id="vw-editor-title">Ajouter une fiche</h2><button
          type="button"
          id="vw-close"
          class="iw-button">Fermer</button
        >
      </div>
      <p class="iw-small">
        La provenance et l’auteur des fiches ajoutées à la main sont renseignés avec votre compte
        connecté. Les modifications restent protégées des imports.
      </p>
      <div id="vw-fields" class="vw-form-grid"></div>
      <fieldset>
        <legend>Thèmes</legend><div id="vw-form-themes" class="vw-checks">
          {
            watchThemes.map((t) => (
              <label>
                <input type="checkbox" name="theme" value={t} />
                {t}
              </label>
            ))
          }
        </div>
      </fieldset>
      <fieldset>
        <legend>Usages et brouillons</legend><p class="iw-small">
          Chaque usage a son propre statut et son texte de travail. Enregistrer ne publie rien.
        </p><div id="vw-form-usages"></div><label class="iw-field"
          >+ usage<select id="vw-usage-add"
            ><option value="">Choisir un usage</option>{
              watchUsages.map((u) => <option>{u}</option>)
            }</select
          ></label
        >
      </fieldset>
      <p id="vw-save-feedback" class="iw-feedback" role="status"></p><button
        type="submit"
        id="vw-save"
        class="iw-button iw-button--primary">Enregistrer le brouillon</button
      >
    </form>
  </dialog>
  <dialog id="vw-research-dialog" class="vw-dialog" aria-labelledby="vw-research-title">
    <h2 id="vw-research-title">Recherche à la demande</h2><p>
      Pour lancer la recherche maintenant, copiez cette demande et envoyez-la à l’agent dans votre
      conversation EUNEOS. Ce bouton ne lance aucune recherche en arrière-plan.
    </p><label class="iw-field"
      >Demande à envoyer<textarea id="vw-research-prompt" readonly rows="5"
        >Prépare la veille thématique EUNEOS de cette semaine en suivant docs/veille-thematique.md :
        6 à 10 sujets réellement lus, quinze derniers jours, sources et périmètres vérifiés.
        Préserve les fiches manuelles, les statuts et les suppressions. Prépare un brouillon sans
        publier.</textarea
      ></label
    ><div class="iw-actions">
      <button id="vw-copy-prompt" class="iw-button iw-button--primary">Copier la demande</button
      ><button id="vw-research-close" class="iw-button">Fermer</button>
    </div><p id="vw-copy-feedback" role="status"></p>
  </dialog>
  <script src="../../../scripts/thematic-watch-client.ts"></script>
</InternalLayout>
