---
export const prerender = false
import InternalLayout from '../../layouts/InternalLayout.astro'
import { readBoardIdentity } from '../../lib/board-access'
import { privateHeaders } from '../../lib/internal-context'
const access = await readBoardIdentity(Astro.request, Astro.locals)
if (access instanceof Response) return access
for (const [key, value] of Object.entries(privateHeaders)) Astro.response.headers.set(key, value)
const spaces = [['Espace Équipe','equipe'],['Espace Organisation','organisation'],['Espace Communication','communication'],['Espace CA','ca']]
---
<InternalLayout title="Bienvenue dans votre espace" current="accueil" identity={{email: access.email, admin:false}} space="hub">
  <section aria-labelledby="spaces-title"><p class="iw-eyebrow">EUNEOS · Espace interne</p><h1 id="spaces-title">Choisissez votre espace</h1>
  <div class="iw-space-grid iw-space-grid--hub">{spaces.map(([label,path]) => <a class="iw-space-card" href={`/interne/${path}`}><strong>{label}</strong><span aria-hidden="true">Accéder →</span></a>)}</div></section>
</InternalLayout>
