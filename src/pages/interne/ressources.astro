---
export const prerender = false
import InternalLayout from '../../layouts/InternalLayout.astro'
import MissionConvention from '../../components/internal/MissionConvention.astro'
import AgendaFormateurs from '../../components/internal/AgendaFormateurs.astro'
import FichesFormateurs from '../../components/internal/FichesFormateurs.astro'
import CarteReseau from '../../components/internal/CarteReseau.astro'
import ResourceSection from '../../components/internal/ResourceSection.astro'
import { getInternalContext } from '../../lib/internal-context'
const context = await getInternalContext(Astro.request, Astro.locals, true)
if (context instanceof Response) return context
const identity = context.identity
const convention = Astro.url.searchParams.get('convention') === '1'
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0')
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')
---

<InternalLayout
  title={convention ? 'Convention de mission' : 'Ressources formateurs'}
  current="ressources"
  identity={identity}
  teamAccess={context.teamMember}
>
  {convention ? <MissionConvention /> : (
  <div id="iw-resources">
    <div class="iw-resource-intro">
      <div class="iw-intro__text">
        <p class="iw-eyebrow">Accompagner & transmettre</p><h1>Ressources formateurs</h1><p>
          Retrouvez les supports et documents partagés par EUNEOS pour préparer et animer vos
          interventions.
        </p>
      </div>
    </div>
    <div class="resource-sections">
      <ResourceSection id="fiches-pratiques" title="Fiches pratiques">
        <FichesFormateurs />
      </ResourceSection>
      <ResourceSection id="guides-pratiques" title="Guides pratiques">
        <p>Les repères pour préparer vos interventions et accompagner les établissements.</p>
        <ul>
          <li>
            <a href="https://drive.google.com/file/d/1NTK69XbQaBfqYUPADbD-o-kckdlLGq3U/view?usp=drive_link" target="_blank" rel="noopener noreferrer"
              ><strong>Guide du formateur ↗</strong></a
            > — préparation, suivi, évaluation et démarches administratives.
          </li>
          <li>
            <a href="https://drive.google.com/file/d/1TnWFc_Eam2b-CVLMIG5-FI5RVK-1qdSg/view?usp=sharing" target="_blank" rel="noopener noreferrer"
              ><strong>Guide établissement ↗</strong></a
            > — rôles et étapes du déploiement.
          </li>
          <li>
            <a href="https://docs.google.com/presentation/d/1-d_C0Xd4vB3A1VobAmo39oU1zOV5aqtK/edit?usp=sharing&ouid=117079042633330970260&rtpof=true&sd=true" target="_blank" rel="noopener noreferrer"
              ><strong>Présentation référents ↗</strong></a
            > — présenter le programme aux personnes référentes.
          </li>
        </ul>
      </ResourceSection>
      <ResourceSection id="supports-formation" title="Préparer et animer une formation">
        <p>Retrouvez les documents partagés pour préparer vos séances et animer les ateliers.</p>
        <a
          class="iw-button"
          href="https://drive.google.com/drive/folders/1cbczGNkfnvWefYno-_GXYWU70m5uEFro?usp=sharing"
          target="_blank"
          rel="noopener noreferrer">Ouvrir les supports de formation ↗</a
        >
      </ResourceSection>
      <ResourceSection id="presenter-programme" title="Présenter le programme">
        <p>Brochure et supports pour vos démarches auprès des établissements.</p>
        <ul>
          <li>
            <a href="https://euneos.fr/documents/brochure-programme-euneos.pdf?v=20260910" target="_blank" rel="noopener noreferrer"
              ><strong>Présentation du programme ↗</strong></a
            >
          </li>
        </ul>
      </ResourceSection>
      <ResourceSection id="documents-signer" title="Documents à signer">
        <ul>
          <li>
            <a href="/suivi/accord-formateur" target="_blank" rel="noopener noreferrer"
              ><strong>Accord du formateur ↗</strong></a
            > — à signer en début de formation.
          </li>
          <li>
            <a href="/interne/ressources?convention=1"><strong>Remplir la convention de mission →</strong></a> — calendrier de 16 h par établissement, vérification EUNEOS puis dépôt du PDF signé dans le même espace.
          </li>
        </ul>
        <p>
          Pour le suivi, l’évaluation et les autres démarches administratives, consultez les <a
            href="#guides-pratiques">guides pratiques</a
          >.
        </p>
      </ResourceSection>
      <ResourceSection id="agenda" title="Agenda">
        <p>Intervisions, formations complémentaires et rencontres du réseau.</p>
        <AgendaFormateurs />
      </ResourceSection>
      <ResourceSection id="etudes-publications" title="Études et publications">
        <div class="resource-direct-link" data-resource-id="465ae9f3-9fa2-4c02-84a8-76d5ea4caeb7" data-resource-label="Étude européenne WISE UP">
          <p class="iw-muted" role="status">Chargement du lien…</p>
          <noscript>Activez JavaScript pour accéder à l’étude européenne.</noscript>
        </div>
      </ResourceSection>
      <ResourceSection id="carte-reseau" title="Carte du réseau">
        <CarteReseau />
      </ResourceSection>
      <ResourceSection id="entraide" title="Partager et trouver de l’aide">
        <p>Retours d’expérience, ressources issues des intervisions et contacts utiles.</p>
        <div class="resource-direct-link" data-resource-id="bd3c90ff-b703-4036-8e8c-a952f03d3813" data-resource-label="Rejoindre le groupe WhatsApp">
          <p class="iw-muted" role="status">Chargement du lien…</p>
          <noscript>Activez JavaScript pour accéder au groupe WhatsApp.</noscript>
        </div>
      </ResourceSection>
    <ResourceSection id="catalogue" title="Catalogue des ressources">
    <noscript
      ><p class="iw-feedback">
        Activez JavaScript pour consulter le catalogue de ressources.
      </p></noscript
    >
    <section class="iw-panel" aria-label="Rechercher une ressource">
      <div class="iw-resource-controls">
        <div class="iw-field">
          <label for="iw-resource-search">Rechercher dans les ressources</label><input
            type="search"
            id="iw-resource-search"
            placeholder="Un titre, un sujet, un mot-clé…"
            autocomplete="off"
          />
        </div><div class="iw-field">
          <label for="iw-resource-category">Catégorie</label><select id="iw-resource-category"
            ><option value="">Toutes les catégories</option></select
          >
        </div><button id="iw-resource-reset" type="button" class="iw-button iw-button--plain"
          >Réinitialiser</button
        >
      </div>
    </section>
    <div class="iw-resultsbar">
      <p id="iw-resource-count" role="status" aria-live="polite">Chargement des ressources…</p><div
        class="iw-actions"
      >
        <p id="iw-resource-updated" class="iw-small iw-muted"></p><button
          type="button"
          id="iw-resource-refresh"
          class="iw-button iw-button--plain">Actualiser</button
        >
      </div>
    </div>
    <div id="iw-resource-state" class="iw-state" role="status">
      <span class="iw-loading" aria-hidden="true"></span><h2>Chargement des ressources</h2><p>
        Nous récupérons les documents disponibles pour votre compte.
      </p>
    </div>
    <section
      id="iw-resource-grid"
      class="iw-resource-grid"
      aria-label="Catalogue des ressources"
      aria-busy="true"
      hidden
    >
    </section>
    </ResourceSection>
    <ResourceSection id="replay-intervision" title="Vidéos">
      <ul>
        <li><a href="https://vimeo.com/1243737710" target="_blank" rel="noopener noreferrer">Intervision WISE UP 3 nov - Les mouvements ↗</a></li>
        <li><a href="https://vimeo.com/1243742709/49de6ff9e7" target="_blank" rel="noopener noreferrer">5 mouvements WISE UP animés par une formatrice ↗</a></li>
      </ul>
    </ResourceSection>
    </div>
    <p class="iw-footnote">
      Les documents s’ouvrent dans un nouvel onglet. Certains peuvent demander une connexion au
      service qui les héberge.
    </p>
  </div>
  )}
</InternalLayout>

<script>
  // Keep existing shared links useful when their destination is folded.
  function revealResourceHash() {
    const target = document.getElementById(location.hash.slice(1))
    if (!target?.closest('#iw-resources')) return
    let parent: HTMLElement | null = target
    while (parent) {
      if (parent instanceof HTMLDetailsElement) parent.open = true
      parent = parent.parentElement
    }
    target.scrollIntoView({ block: 'start' })
  }
  window.addEventListener('hashchange', revealResourceHash)
  revealResourceHash()
</script>

<style>
  #iw-resources .iw-resource-intro {
    background: var(--jaune);
    color: var(--noir, #000);
  }
  #iw-resources .iw-resource-intro h1,
  #iw-resources .iw-resource-intro p {
    color: var(--noir, #000);
  }
  #iw-resources .iw-resource-intro::after {
    border-top-color: var(--jaune-fold);
  }
  .resource-sections {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: .75rem;
    margin-block: var(--s-lie);
  }
  .resource-sections p + p,
  .resource-sections p + a,
  .resource-sections ul {
    margin-top: var(--s-lie);
  }
  .resource-sections ul {
    padding-left: 1.25em;
  }
  .resource-sections li + li {
    margin-top: var(--s-lie);
  }
  .resource-direct-link {
    margin-top: var(--s-lie);
  }
  .resource-sections a {
    overflow-wrap: anywhere;
  }
</style>
