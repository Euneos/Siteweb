---
import Base from '../layouts/Base.astro'
import { requireInternalAccess } from '../lib/internal-access'
import { jeton } from '../lib/nocodb'
import { lireEtatCohorte, type EtatCohorte } from '../lib/etat-candidatures'

export const prerender = false

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0')

const env = (Astro.locals as { runtime?: { env?: Record<string, string> } }).runtime?.env ?? {}
const accesRefuse = await requireInternalAccess(Astro.request, env)
if (accesRefuse) return accesRefuse

let etat: EtatCohorte | null = null
let indisponible = false
const token = jeton(Astro.locals)

if (token) {
  try {
    etat = await lireEtatCohorte(token)
  } catch (erreur) {
    indisponible = true
    console.error('[etat-candidatures]', erreur instanceof Error ? erreur.message : erreur)
  }
} else {
  indisponible = true
  console.error('[etat-candidatures] NOCODB_TOKEN absent')
}

const formatActualisation = (date: Date) =>
  new Intl.DateTimeFormat('fr-FR', {
    dateStyle: 'long',
    timeStyle: 'short',
    timeZone: 'Europe/Paris',
  }).format(date)

const colonnes = ['Candidature reçue', 'Accusé de réception', 'Analyse & décision', 'Sélectionné', 'Lettre signée', 'Fiche contact', 'Formateur désigné', 'Organisation', 'Formations & suivi', 'Ateliers & évaluation']
---

<Base
  title="État des candidatures 2026–2027 — EUNEOS"
  description="État d’avancement des candidatures des établissements pour la cohorte WISE-UP 2026–2027."
  heroSurface="bleu"
  heroFold="bl"
  noindex
>
  <section slot="hero" class="page etat-hero">
    <p class="etat-hero__sur">Espace équipe · accès réservé</p>
    <h1>État des candidatures<br />Cohorte 2026–2027</h1>
    <p class="etat-hero__lead">
      Données lues directement dans la base EUNEOS. Cette page n’effectue aucune modification.
    </p>
  </section>

  <section class="section page etat" aria-labelledby="synthese">
    <div class="etat__entete">
      <div>
        <h2 id="synthese">Vue d’ensemble</h2>
        {etat && <p class="etat__actualisation">Actualisé le {formatActualisation(etat.actualiseLe)}</p>}
      </div>
      <p class="etat__confidentialite">
        Accès réservé aux membres autorisés. Les informations sont relues à chaque ouverture ; actualisez la page pour obtenir la dernière version.
      </p>
    </div>

    {
      indisponible || !etat ? (
        <div class="etat__alerte" role="alert">
          <h3>Données momentanément indisponibles</h3>
          <p>La base EUNEOS n’a pas pu être lue. Actualisez la page dans quelques instants.</p>
        </div>
      ) : (
        <>
          <ul class="etat__indicateurs" aria-label="Indicateurs de la cohorte 2026–2027">
            <li><strong>{etat.etablissementsDistincts}</strong><span>établissements distincts</span></li>
            <li><strong>{etat.lignes.length}</strong><span>lignes de candidature</span></li>
            <li><strong>{etat.lignesAVerifier}</strong><span>lignes à vérifier</span></li>
          </ul>

          {etat.lignesAVerifier > 0 && (
            <p class="etat__note">
              « À vérifier » signale plusieurs dossiers pour un établissement, ou une liaison manquante. La vue conserve ces dossiers pour permettre leur rapprochement.
            </p>
          )}

          <p class="etat__legende">✓ Information enregistrée · ◔ Avancement partiel · — Information non renseignée. Une case vide ne signifie pas que l’action n’a pas eu lieu.</p>
          <p class="etat__scroll-aide">Faites défiler le tableau horizontalement pour consulter les dix étapes.</p>

          <div class="etat__table-wrap" tabindex="0" role="region" aria-label="Tableau des candidatures, défilement horizontal possible">
            <table class="etat__table">
              <caption>Progression des établissements — cohorte 2026–2027</caption>
              <thead>
                <tr>
                  <th class="etat__etablissement" scope="col" rowspan="2">Établissement</th>
                  <th scope="colgroup" colspan="3">Étape 1 — Candidature</th>
                  <th scope="colgroup" colspan="4">Étape 2 — Sélection & confirmation</th>
                  <th scope="colgroup" colspan="3">Étapes 3 à 9 — Déploiement → Évaluation</th>
                </tr>
                <tr>{colonnes.map(titre => <th scope="col">{titre}</th>)}</tr>
              </thead>
              <tbody>
                {etat.lignes.length === 0 && <tr><td colspan="11">Aucun dossier dans cette cohorte.</td></tr>}
                {etat.lignes.map((ligne) => (
                  <tr class:list={[ligne.aVerifier && 'is-a-verifier']}>
                    <th scope="row">
                      <span class="etat__nom">{ligne.etablissement}</span>
                      <span class="etat__meta">{[ligne.typeEtablissement, ligne.ville, ligne.region, ligne.code].filter(Boolean).join(' · ')}</span>
                      {ligne.aVerifier && <span class="etat__verification">À vérifier</span>}
                    </th>
                    {ligne.progression.map((cellule, index) => (
                      <td class:list={['etat__centre', `etat__cellule--${cellule.etat}`]}>
                        <span aria-hidden="true">{cellule.etat === 'fait' ? '✓' : cellule.etat === 'en-cours' ? '◔' : cellule.etat === 'abandon' ? '×' : '—'}</span>
                        <span class="etat__mobile-label">{colonnes[index]}</span>
                        <small>{cellule.texte}</small>
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )
    }
  </section>
</Base>

<style is:global>
  .etat-hero {
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(4rem, 9vw, 7rem);
    max-width: var(--page-max);
  }
  .etat-hero__sur {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--t-note);
    margin-bottom: 0.75rem;
  }
  .etat-hero__lead {
    max-width: 58ch;
    margin-top: 1rem;
  }
  .etat__entete {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.75fr);
    gap: var(--s-int);
    align-items: start;
    margin-bottom: var(--s-int);
  }
  .etat__actualisation {
    margin-top: 0.5rem;
    font-size: var(--t-note);
  }
  .etat__confidentialite,
  .etat__note,
  .etat__alerte {
    padding: 1rem 1.25rem;
    background: color-mix(in srgb, var(--jaune) 18%, var(--blanc));
    border-left: 0.35rem solid var(--jaune);
    font-size: var(--t-note);
  }
  .etat__alerte h3 {
    font-size: var(--t-carte);
    margin-bottom: 0.35rem;
  }
  .etat__indicateurs {
    list-style: none;
    margin: 0 0 var(--s-int);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .etat__indicateurs li {
    min-height: 8rem;
    padding: 1rem;
    display: grid;
    align-content: center;
    background: var(--bleu-clair);
    color: var(--vert);
  }
  .etat__indicateurs strong {
    font-size: var(--t-chiffre);
    line-height: 1;
  }
  .etat__indicateurs span {
    font-size: var(--t-note);
  }
  .etat__note {
    margin-bottom: 1rem;
  }
  .etat__table-wrap {
    overflow-x: auto;
    border: 1px solid color-mix(in srgb, var(--vert) 25%, transparent);
  }
  .etat__table-wrap:focus-visible {
    outline: 3px solid var(--bleu-fold);
    outline-offset: 3px;
  }
  .etat__table {
    width: 100%;
    min-width: 1500px;
    border-collapse: collapse;
    font-size: max(0.82rem, calc(var(--t-note) * 0.88));
    line-height: 1.3;
  }
  .etat__table caption {
    text-align: left;
    padding: 1rem;
    font-weight: 600;
    color: var(--vert);
  }
  .etat__table th,
  .etat__table td {
    padding: 0.8rem;
    text-align: left;
    vertical-align: top;
    border: 1px solid color-mix(in srgb, var(--vert) 18%, var(--blanc));
  }
  .etat__table thead th {
    background: #2367b9;
    color: var(--blanc);
    text-align: center;
    vertical-align: middle;
    font-weight: 700;
  }
  .etat__table thead .etat__etablissement {
    min-width: 250px;
    background: #223f6d;
    text-align: left;
    font-size: 1.08em;
  }
  .etat__mobile-label { display: none; }
  .etat__legende { font-size: var(--t-note); margin-bottom: 1rem; }
  .etat__scroll-aide { font-size: var(--t-note); margin-bottom: 0.75rem; }
  .etat__cellule--abandon { color: var(--vert); background: color-mix(in srgb, var(--orange) 12%, var(--papier)); }
  .etat__table tbody tr:nth-child(even) {
    background: color-mix(in srgb, var(--papier) 72%, var(--blanc));
  }
  .etat__table tbody tr.is-a-verifier {
    box-shadow: inset 0.3rem 0 var(--orange);
  }
  .etat__nom,
  .etat__meta,
  .etat__table small {
    display: block;
  }
  .etat__nom {
    color: var(--vert);
  }
  .etat__meta,
  .etat__table small {
    margin-top: 0.25rem;
    font-size: 0.82em;
    font-weight: 400;
    opacity: 0.72;
  }
  .etat__fait,
  .etat__centre.is-fait {
    color: var(--vert);
    font-weight: 700;
  }
  .etat__centre {
    text-align: center !important;
  }
  .etat__verification {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--orange) 18%, var(--blanc));
    color: var(--vert);
    font-weight: 600;
    white-space: nowrap;
  }
  @media (max-width: 860px) {
    .etat__scroll-aide { display: none; }
    .etat__entete,
    .etat__indicateurs {
      grid-template-columns: 1fr;
    }
    .etat__indicateurs li {
      min-height: 0;
    }
    .etat__table-wrap { overflow: visible; border: 0; }
    .etat__table { min-width: 0; }
    .etat__table caption { display: block; padding-inline: 0; }
    .etat__table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .etat__table, .etat__table tbody, .etat__table tr { display: block; width: 100%; }
    .etat__table tbody tr { border: 1px solid var(--vert); margin-bottom: 1.5rem; }
    .etat__table th, .etat__table td { display: block; border: 0; overflow-wrap: anywhere; }
    .etat__table tbody th { background: var(--bleu-clair); }
    .etat__table td { display: grid; grid-template-columns: 1.5rem minmax(0, 1fr); text-align: left !important; border-top: 1px solid var(--papier); }
    .etat__mobile-label { display: block; font-weight: 600; }
    .etat__table small { grid-column: 2; opacity: 1; }

  }
</style>
