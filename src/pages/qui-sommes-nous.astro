import photoCour from '../assets/photos/qui-sommes-nous-cour.jpeg'
import cartoucheEquipe from '../assets/brand/cartouche-equipe-indigo.svg'
import Cta from '../components/Cta.astro'
import Parcours from '../components/Parcours.astro'
import Paper from '../components/Paper.astro'
import Photo from '../components/Photo.astro'
import PictoBox from '../components/PictoBox.astro'
import Base from '../layouts/Base.astro'
import atelierEquipe from '../assets/photos/atelier-equipe.jpg'
import candice from '../assets/photos/candice.png'
import charlotte from '../assets/photos/charlotte-terouanne.jpg'
import pauline from '../assets/photos/pauline-miqueu-petit.png'
import type { ImageMetadata } from 'astro'
import sophie from '../assets/photos/sophie-lavault.jpg'
import francoise from '../assets/photos/francoise-sarrazin.jpg'
import guilain from '../assets/photos/guilain-praseuth.jpg'
import solange from '../assets/photos/solange-eon.png'
import jeanFrancois from '../assets/photos/jean-francois-mamet.jpg'
import gilles from '../assets/photos/gilles-vernet-youri-zakovitch.jpg'
