---
/**
 * Page 3 — Qui sommes-nous ?
 * Fidele a la maquette v7, page 3.
 * Deux fautes du copy fourni sont corrigees : « grandir seul » -> seuls,
 * « les educateur » -> les educateurs. A confirmer avec Candice.
 */
import Brand from '../components/Brand.astro'
import Cartouche from '../components/Cartouche.astro'
import Cta from '../components/Cta.astro'
import Paper from '../components/Paper.astro'
import Photo from '../components/Photo.astro'
import PictoBox from '../components/PictoBox.astro'
import Base from '../layouts/Base.astro'

const jalons = [
  'L’instruction interministérielle de 2022 inscrit les compétences psychosociales dans les objectifs éducatifs.',
  'La Stratégie Numérique pour l’éducation 2023-2027 fait de l’usage éclairé des outils numériques une priorité éducative nationale.',
  'En 2025, la santé mentale est déclarée Grande Cause nationale.',
]

/* Maquette v4 : les trois pictos sont NUS et colores (vert clair, orange,
   jaune), poses sur le fond — plus de cartouche. */
const actions = [
  {
    picto: 'main',
    couleur: 'var(--vert-clair)',
    titre: 'Révéler',
    texte:
      'Appréhender les dynamiques d’apprentissage individuelles et collectives pour révéler ce qui freine le développement global des jeunes et ce qui peut le développer, en s’appuyant sur la recherche internationale (neurosciences, psychologie du développement, santé publique, sciences de l’éducation).',
  },
  {
    picto: 'etoile',
    couleur: 'var(--orange)',
    titre: 'Éclairer',
    texte:
      'Sensibiliser les équipes pédagogiques à la prévention de la santé mentale, à la transmission des compétences psychosociales et au rapport au numérique, et les accompagner dans l’appropriation d’outils adaptés à leurs pratiques existantes.',
  },
  {
    picto: 'asterisque',
    couleur: 'var(--jaune)',
    titre: 'Diffuser',
    texte:
      'Mesurer l’impact des approches (questionnaires, indicateurs de suivi, évaluations) pour améliorer en continu les outils et les pratiques et les déployer à grande échelle.',
  },
] as const

const niveaux: {
  surtitre?: string
  titre: string
  texte: string
  ligne2?: string
  cta: string
  ctaSurface: 'jaune' | 'bleu-fonce' | 'rose' | 'ocre'
  href: string
}[] = [
  {
    titre: 'Sensibilisation',
    texte: 'Formats légers, conférences, ressources en ligne, webinaires.',
    cta: 'En savoir +',
    ctaSurface: 'jaune',
    href: '/contact',
  },
  {
    surtitre: 'Formation longue durée',
    titre: 'Le Programme',
    texte: '16 h pour le personnel en poste qui anime',
    ligne2: 'ensuite les ateliers auprès des jeunes.',
    cta: 'Découvrir notre programme clé',
    ctaSurface: 'bleu-fonce',
    href: '/programme',
  },
  {
    titre: 'Accompagnement au quotidien',
    texte: 'Suivi post-formation, analyse de pratiques,',
    ligne2: 'réseau de pairs entre référents.',
    cta: 'Contactez-nous',
    ctaSurface: 'rose',
    href: '/contact',
  },
  {
    titre: 'Plaidoyer',
    texte: 'Comité scientifique, groupes de travail, dialogue institutionnel, influence sur les politiques publiques.',
    cta: 'En savoir +',
    ctaSurface: 'ocre',
    href: '/contact',
  },
]

/* Fonctions corrigees le 20/08 (maquette v2 p.3). NB : la page 1 signe la
   citation de Candice « Fondatrice et Presidente » — l'ecart est dans la
   maquette elle-meme, a trancher avec elle. */
const ca = Array.from({ length: 9 }, () => ({ nom: 'À venir', fonction: 'À venir' }))

const equipe = [
  { nom: 'Candice Marro', fonction: 'Fondatrice & Directrice Générale', email: 'gouvernance@euneos.fr' },
  { nom: 'Charlotte', ligne2: 'Térouanne', fonction: 'Coordination & Développement', email: 'charlotte@euneos.fr' },
  { nom: 'Pauline', ligne2: 'Miqueu-Petit', fonction: 'Responsable communication', email: 'pauline@euneos.fr' },
]
---

<Base
  title="Qui sommes-nous ? — EUNEOS"
  description="EUNEOS, association loi 1901 fondée en avril 2026 : l’une des premières structures françaises à intégrer santé mentale, compétences psychosociales et rapport au numérique dans une approche pédagogique évaluée."
  heroSurface="vert"
>
  <!-- HERO -->
  <section slot="hero" class="hz hz--mirror">
    <div class="hz__grid">
      <div class="hz__side">
        <div class="hz__cartouche"><Cartouche surface="bleu" fig="fig1" /></div>

        <div class="hz__bubblewrap">
          <Paper outline fold="tr" class="hz__bubble">
            <h1>Inscrivons dans les parcours pédagogiques une culture durable du prendre soin.</h1>
          </Paper>
          <div class="hz__cta"><Cta href="#fondements" surface="vert-clair" fold={false}>En savoir +</Cta></div>
        </div>
      </div>

      <div class="hz__media">
        <Photo ratio="5/4" label="photo — lieu éducatif" />
      </div>

    </div>
  </section>

  <!-- FONDEMENTS -->
  <section id="fondements" class="section fond has-silo">
    <div class="silo silo--left fond__fig" aria-hidden="true"><Brand name="fig1" height="100%" /></div>
    <div class="page g16 fond__in">
      <h2 style="grid-column: 3 / 8" class="fond__t">
        Ne laissons pas les jeunes grandir seuls face aux défis du numérique, et ne laissons
        pas les éducateurs sans ressources pour les accompagner.
      </h2>
      <div style="grid-column: 8 / 17" class="fond__txt">
        <p>
          L’adolescence est une étape décisive du développement humain, marquée par des
          transitions physiques, émotionnelles et sociales majeures.<sup>*</sup>
          <strong>
            Quand cette période de vulnérabilité est saturée par le numérique, c’est
            l’équilibre global des jeunes qui peut être d’autant plus fragilisé.
          </strong>
        </p>
        <details class="fond__details">
          <summary>
            Les pouvoirs publics ont successivement reconnu et priorisé les milieux éducatifs
            comme premiers leviers pour prendre soin de la santé globale et de la réussite des
            jeunes :
          </summary>
          <ul class="fond__jalons">
            {jalons.map((j) => <li>{j}</li>)}
          </ul>
          <p class="source">
            * OMS, 2024, <em>“Securing adolescent health and well-being today is vital for
            the health of future generations”</em>.
          </p>
        </details>
      </div>
    </div>
    <div class="page fond__cta">
      <Cta href="/programme">Découvrir notre programme clé</Cta>
    </div>
  </section>

  <!-- MISSION -->
  <section class="section">
    <div class="page mission">
      <div class="mission__media">
        <Photo ratio="3/4" label="photo — jeunes" />
        <div class="mission__picto"><PictoBox picto="oiseau" surface="orange" size="md" /></div>
        <Paper surface="rose" fold="tl" class="mission__badge">
          <span class="mission__badge-mark"><Brand name="wordmark" /></span>
          <span class="mission__badge-txt">Association d’intérêt général<br />Loi 1901 fondée en avril 2026</span>
        </Paper>
      </div>

      <Paper surface="vert" fold="br" class="mission__card">
        <p>
          Alors que la santé mentale, les compétences psychosociales et l’usage éclairé du
          numérique relèvent d’un même enjeu de développement, ces priorités sont rarement
          considérées simultanément.
        </p>
        <p class="mission__strong">
          EUNEOS est l’une des 1<sup>ères</sup> structures françaises à les intégrer dans une
          approche pédagogique évaluée.
        </p>
      </Paper>
    </div>
  </section>

  <!-- COMMENT AGISSONS-NOUS -->
  <section class="section">
    <div class="page">
      <p class="surtitre a-surtitre">Notre approche</p>
      <h2 class="a-t">
        Équilibrons et préservons le parcours des jeunes et des équipes pédagogiques qui les
        accompagnent.
      </h2>
      <ul class="actions">
        {
          actions.map((a) => (
            <li class="action">
              <div class="action__head">
                <div class="action__picto" style={`color:${a.couleur}`}><Brand name={a.picto} /></div>
                <h3>{a.titre}</h3>
              </div>
              <p>{a.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- NIVEAUX D'INTERVENTION -->
  <section class="section niveaux-sec">
    <div class="page">
      <p class="surtitre a-surtitre">Nos niveaux d’intervention</p>
      <h2 class="a-t">
        C’est dans la durée que la connaissance devient pratique, et que la pratique devient
        culture.
      </h2>
      <ul class="niveaux">
        {
          niveaux.map((n) => (
            <li>
              <Paper surface="vert" fold="tl" class="niveau">
                {n.surtitre && <p class="niveau__sur">{n.surtitre}</p>}
                <h3>{n.titre}</h3>
                <p class="niveau__txt">{n.texte}{n.ligne2 && <><br />{n.ligne2}</>}</p>
                <Cta href={n.href} surface={n.ctaSurface} class="cta--sm niveau__cta">
                  {n.cta}
                </Cta>
              </Paper>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CONSEIL D'ADMINISTRATION — ajoute dans la maquette v2.
        Les 6 membres y sont encore des « ??? » : noms et portraits a fournir. -->
  <section class="section ca-sec">
    <div class="page">
      <h2 class="c-t ca__t">Notre conseil d’administration</h2>
      <div class="ca-carousel" data-carousel>
        <button class="ca-carousel__arrow" type="button" aria-label="Voir les membres précédents" data-direction="previous">
          <span aria-hidden="true">←</span>
        </button>
        <ul class="equipe equipe--ca" data-carousel-track>
          {ca.map((m) => (
            <li class="membre membre--ca">
              <Paper surface="vert-clair" fold="none" class="etiquette membre__name">{m.nom}</Paper>
              <Photo ratio="2/3" class="membre__ph" />
              <Paper surface="papier" fold="br" class="membre__card">
                <p>{m.fonction}</p>
              </Paper>
            </li>
          ))}
        </ul>
        <button class="ca-carousel__arrow" type="button" aria-label="Voir les membres suivants" data-direction="next">
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </section>

  <!-- EQUIPE -->
  <section class="section equipe-sec">
    <div class="page">
      <h2 class="c-t">Notre équipe opérationnelle</h2>
      <ul class="equipe equipe--oper">
        {
          equipe.map((m) => (
            <li class="membre membre--oper">
              <Paper surface="ocre" fold="none" class="etiquette membre__name">{m.nom}{m.ligne2 && <><br />{m.ligne2}</>}</Paper>
              <Photo ratio="2/3" class="membre__ph" />
              <Paper surface="papier" fold="br" class="membre__card">
                <p>{m.fonction}</p>
                <a href={`mailto:${m.email}`}>Contacter</a>
              </Paper>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-carousel-track]')
    if (!track) return

    carousel.querySelectorAll<HTMLButtonElement>('[data-direction]').forEach((button) => {
      button.addEventListener('click', () => {
        const direction = button.dataset.direction === 'next' ? 1 : -1
        track.scrollBy({ left: direction * track.clientWidth * 0.8, behavior: 'smooth' })
      })
    })
  })
</script>

<style is:global>
  .hero-zone .hz--mirror .hz__cta > .cta {
    --surface: #809b96 !important;
  }

  /* FONDEMENTS */
  .fond .fond__fig {
    color: var(--vert);
    top: 0 !important;
    transform: translate(-38%, 0) !important;
  }
  .fond__txt {
    display: grid;
    gap: 1rem;
  }
  .fond__details {
    display: grid;
    gap: 1rem;
  }
  .fond__details summary {
    cursor: pointer;
    line-height: var(--lh-corps);
    list-style: none;
  }
  .fond__details summary::-webkit-details-marker {
    display: none;
  }
  .fond__details summary::after {
    content: '+';
    margin-left: 0.35em;
    color: var(--orange);
    font-size: 1em;
    font-weight: 600;
    line-height: inherit;
    display: inline-block;
  }
  .fond__details[open] summary::after {
    content: '−';
  }
  @media (min-width: 861px) {
    .fond__t {
      font-size: var(--t-h3);
    }
  }
  .fond__jalons {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .fond__jalons li {
    position: relative;
    padding-left: 2.25rem;
  }
  .fond__jalons li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 1.5rem;
    height: 0.5rem;
    background: var(--vert-clair);
    clip-path: polygon(0 30%, 65% 30%, 65% 0, 100% 50%, 65% 100%, 65% 70%, 0 70%);
  }
  .fond__cta {
    position: relative;
    display: flex;
    justify-content: center;
    margin-top: var(--s-int);
    margin-bottom: calc(var(--s-bloc) * 1.5);
  }
  @media (max-width: 860px) {
    .fond__fig {
      display: none;
    }
  }

  @media (min-width: 861px) {
    .hz--mirror .hz__cartouche {
      top: auto;
      bottom: 0;
    }
  }

  /* MISSION */
  .mission {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    align-items: center;
  }
  .mission__media {
    position: relative;
    z-index: 2;
  }
    /* releve v4 : le cartouche orange est pose sur le coin haut-droit de la
     PHOTO, son bord droit contre le bord gauche du bloc vert — jamais sur le
     texte. Le bloc vert mord de 6 % sur la colonne photo : on s'arrete avant. */
  .mission__picto {
    position: absolute;
    right: 0;
    top: -8%;
    z-index: 3;
  }
  .mission__picto svg {
    transform: scaleX(-1);
  }

  /* Sur petit ecran le conteneur touche le bord de l'ecran : le decalage
     negatif ci-dessus poussait l'element hors cadre et faisait scroller
     TOUTE la page sur le cote. On rentre le debordement au point de
     bascule ; sur ordinateur rien ne change. */
  @media (max-width: 860px) {
    .mission__picto {
      right: 0;
    }
  }
  /* Le cartouche se pose au bas de la photo et rejoint le bloc de texte. */
  .mission__badge {
    position: absolute;
    left: 16%;
    bottom: 0;
    width: 105%;
    padding: clamp(1rem, 2.2vw, 1.6rem) clamp(1.1rem, 2.4vw, 1.75rem);
    z-index: 4;
    --f: clamp(1.25rem, 2.4vw, 2rem);
    color: #fff;
  }
  .mission__badge-mark {
    display: block;
    width: 72%;
    margin-bottom: 0.5rem;
  }
  .mission__badge-txt {
    font-size: var(--t-nav);
    font-weight: 600;
    line-height: 1.35;
    display: block;
  }
  .mission__card {
    /* releve v4 : bloc de 708 x 711 px, pli aplati 186 x 93, texte a 64 px
       du bord gauche et 38 px du haut */
    --fx: clamp(3rem, 12.9vw, 11.6rem);
    --fy: clamp(1.5rem, 6.5vw, 5.8rem);
    margin-left: 0;
    min-height: clamp(24rem, 40vw, 34rem);
    padding: var(--s-int);
    padding-left: clamp(2rem, 4.4vw, 4rem);
    padding-bottom: max(var(--s-int), calc(var(--fy) + 0.5rem));
    display: grid;
    gap: 0;
    z-index: 1;
  }
  /* Le texte de mission reprend le corps courant, la derniere phrase restant
     mise en valeur. */
  .mission__card > p {
    font-size: var(--t-corps);
    line-height: var(--lh-corps);
    font-weight: 400;
  }
  .mission__strong {
    font-weight: 600;
  }
  @media (max-width: 860px) {
    .mission {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .mission__card {
      margin-left: 0;
      min-height: 0;
      padding-left: clamp(1.5rem, 3vw, 2.5rem);
    }
    .mission__badge {
      left: 0;
      width: 62%;
    }
  }

  .actions {
    list-style: none;
    padding: 0;
    width: 76%;
    margin: 0 auto;
    display: grid;
    gap: 0;
  }
  .a-t + .actions {
    margin-top: calc(var(--s-titre) * -0.75);
  }
  .action {
    --action-gap: clamp(0.6rem, 1.8vw, 1.5rem);
    display: grid;
    grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.55fr);
    gap: var(--action-gap);
    align-items: start;
    padding-block: var(--action-gap);
  }
  .action:not(:last-child) {
    padding-bottom: 0;
  }
  .action:not(:last-child)::after {
    content: '';
    grid-column: 1 / -1;
    justify-self: center;
    width: 70%;
    height: 1px;
    background: color-mix(in srgb, var(--noir) 12%, transparent);
  }
  .action__head {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
  }
  /* releve v4 : picto nu de 70 px, titre au corps des titres */
  .action__picto {
    width: var(--picto-md);
    flex: none;
  }
  .action__head h3 {
    font-size: var(--t-titre);
  }
  @media (min-width: 861px) {
    .action > p {
      max-width: 100%;
    }
  }
  @media (max-width: 860px) {
    .actions {
      width: 100%;
    }
    .action {
      --action-gap: 1rem;
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  /* NIVEAUX */
  .niveaux-sec {
    background: var(--papier);
    margin-top: calc(var(--s-bloc) * 0.3);
  }
  .niveaux-sec .a-t {
    margin-bottom: calc(var(--s-titre) / 2);
  }
  .niveaux {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.5rem, 1.5vw, 1.125rem);
  }
  /* releve v4 : cartes de 552 x 316 px, titre au corps des CTA (36 px),
     petit pli aplati en haut a gauche (42 x 18), petit CTA (23 px) */
  .niveau {
    height: 100%;
    min-height: clamp(10rem, 14vw, 12rem);
    padding: calc(var(--s-int) * 0.65);
    display: grid;
    gap: 0.5rem;
    justify-items: center;
    text-align: center;
    align-content: center;
    --fx: clamp(1.5rem, 3.1vw, 2.8rem);
    --fy: clamp(0.6rem, 1.3vw, 1.2rem);
  }
  .niveau h3 {
    font-size: var(--t-cta);
  }
  .niveau__txt {
    max-width: 52ch;
    font-size: calc(var(--t-corps) * 0.75);
  }
  .niveau__cta {
    margin-top: 0.75rem;
    font-size: calc(var(--t-bouton) / 2);
    --f: calc(var(--fold-sm) / 2);
  }
  @media (max-width: 860px) {
    .niveaux {
      grid-template-columns: 1fr;
    }
    .niveau__txt {
      max-width: 34ch;
      font-size: var(--t-corps);
    }
  }

  /* CONSEIL D'ADMINISTRATION (v2) */
  .ca-sec {
    margin-top: calc(var(--s-bloc) * 0.75);
  }
  .ca__t {
    margin-bottom: clamp(2rem, 3vw, 2.5rem);
  }
  .ca-carousel {
    position: relative;
    padding-bottom: 3.5rem;
  }
  .equipe--ca {
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: minmax(14rem, 28%);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .equipe--ca::-webkit-scrollbar {
    display: none;
  }
  .equipe--ca .membre {
    scroll-snap-align: start;
  }
  .ca-carousel__arrow {
    position: absolute;
    bottom: 0;
    z-index: 3;
    width: 2.5rem;
    aspect-ratio: 1;
    border: 0;
    border-radius: 50%;
    background: var(--papier);
    color: var(--vert);
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }
  .ca-carousel__arrow[data-direction='previous'] {
    left: calc(50% - 3rem);
  }
  .ca-carousel__arrow[data-direction='next'] {
    right: calc(50% - 3rem);
  }

  /* EQUIPE */
  .equipe-sec .c-t {
    margin-bottom: clamp(2rem, 3vw, 2.5rem);
  }
  .equipe {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .membre {
    display: grid;
  }
  /* maquette : l'etiquette est large et coiffe la photo en debordant a gauche */
  .membre__name {
    --fx: clamp(1.2rem, 3.1vw, 2.9rem);
    --fy: clamp(0.3rem, 0.6vw, 0.6rem);
    justify-self: stretch;
    width: 88%;
    position: relative;
    z-index: 2;
    margin-left: 0;
    margin-bottom: -0.6rem;
  }
  .membre__ph {
    position: relative;
    z-index: 1;
    width: 78%;
    margin-left: 12%;
  }
  .membre__ph--symbol {
    display: grid;
    place-items: center;
    aspect-ratio: 302 / 330;
    padding: 16%;
    background: var(--vert-clair);
    color: var(--vert);
  }
  .membre__card {
    padding: var(--s-int);
    padding-bottom: max(var(--s-int), calc(var(--fy) + 0.75rem));
    display: grid;
    gap: 0.4rem;
    /* releve : pli aplati 32,3 x 8,8 pt, soit 26 % de la largeur de carte */
    --fx: clamp(1.6rem, 3.6vw, 3.4rem);
    --fy: clamp(0.5rem, 1vw, 0.95rem);
    width: 78%;
