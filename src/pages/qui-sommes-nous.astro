    </div>
  </section>

  <!-- CONSEIL D'ADMINISTRATION — ajoute dans la maquette v2.
        Les 6 membres y sont encore des « ??? » : noms et portraits a fournir. -->
  <section class="section ca-sec" id="conseil-administration">
    <div class="page">
      <h2 class="c-t ca__t">Notre conseil d’administration</h2>
      <p class="ca__intro">
        EUNEOS est une association loi 1901 d’intérêt général.<br />
        Notre conseil d’administration réunit des membres issus de cinq champs complémentaires :
        éducation et politiques éducatives, santé mentale des jeunes, numérique et attention,
        innovation sociale, santé publique et prévention.
      </p>
      <div class="equipe-carousel" data-carousel role="region" aria-label="Membres du conseil d’administration" aria-roledescription="carrousel">
        <button class="equipe-carousel__arrow" type="button" aria-label="Voir les membres précédents du conseil" aria-controls="conseil-membres" data-direction="previous">
          <span aria-hidden="true">←</span>
        </button>
        <ul class="equipe equipe--ca" id="conseil-membres" data-carousel-track tabindex="0" aria-label="Membres du conseil d’administration">
          {ca.map((m) => (
            <li class="membre membre--ca">
              <Paper surface="vert-clair" fold="none" class="etiquette membre__name">{m.nom}</Paper>
              <Photo src={m.photo} alt={m.photo ? m.nom : undefined} ratio="2/3" class="membre__ph" width={m.photo ? Math.min(m.photo.width, 800) : undefined} widths={m.photo ? [Math.min(240, m.photo.width), Math.min(800, m.photo.width)] : undefined} quality={85} />
              <Paper surface="papier" fold="br" class="membre__card">
                <p>{m.fonction}</p>
                {m.bio && (
                  <details class="ca__bio">
                    <summary><span class="sr-only">Afficher la biographie de {m.nom}</span></summary>
                    <p>{m.bio}</p>
                  </details>
                )}
              </Paper>
            </li>
          ))}
        </ul>
        <button class="equipe-carousel__arrow" type="button" aria-label="Voir les membres suivants du conseil" aria-controls="conseil-membres" data-direction="next">
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </section>

  <!-- EQUIPE -->
  <section class="section equipe-sec">
    <div class="page">
      <h2 class="c-t">Notre équipe opérationnelle</h2>
      <div class="equipe-carousel" data-carousel role="region" aria-label="Équipe opérationnelle" aria-roledescription="carrousel">
        <button class="equipe-carousel__arrow" type="button" aria-label="Voir les membres précédents de l’équipe" aria-controls="equipe-membres" data-direction="previous">
          <span aria-hidden="true">←</span>
        </button>
        <ul class="equipe equipe--oper" id="equipe-membres" data-carousel-track tabindex="0" aria-label="Membres de l’équipe opérationnelle">
          {
            equipe.map((m) => (
              <li class="membre membre--oper">
                <Paper surface="ocre" fold="none" class="etiquette membre__name">{m.nom}{m.ligne2 && <><br />{m.ligne2}</>}</Paper>
                <Photo src={m.photo} alt={m.photo ? `${m.nom} ${m.ligne2 ?? ''}, ${m.fonction}` : undefined} ratio="2/3" class={m.photo === candice ? 'membre__ph portrait-candice' : 'membre__ph'} width={m.photo ? Math.min(m.photo.width, 800) : undefined} widths={m.photo ? [240, Math.min(m.photo.width, 800)] : undefined} quality={m.photo ? 85 : undefined} />
                <Paper surface="papier" fold="br" class="membre__card">
                  <p>{m.fonction}</p>
                  <a href={`mailto:${m.email}`}>Contacter</a>
                </Paper>
              </li>
            ))
          }
        </ul>
        <button class="equipe-carousel__arrow" type="button" aria-label="Voir les membres suivants de l’équipe" aria-controls="equipe-membres" data-direction="next">
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </section>

  <Parcours partenariat />
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-carousel-track]')
    if (!track) return
    const previous = carousel.querySelector<HTMLButtonElement>('[data-direction="previous"]')
    const next = carousel.querySelector<HTMLButtonElement>('[data-direction="next"]')
    const updateNavigation = () => {
      const end = track.scrollWidth - track.clientWidth
      carousel.dataset.overflow = String(end > 1)
      if (previous) previous.disabled = track.scrollLeft <= 1
      if (next) next.disabled = track.scrollLeft >= end - 1
    }
    track.addEventListener('scroll', updateNavigation, { passive: true })

    // Equal closed cards, while each biography can still grow independently.
    // Measuring only the introductions avoids changing the baseline on toggle.
    const cards = [...track.querySelectorAll<HTMLElement>('.membre__card')]
    const alignClosedCards = () => {
      const height = Math.ceil(Math.max(0, ...cards.map((card) => {
        const intro = [...card.querySelectorAll<HTMLElement>(':scope > p, :scope > a')]
        const style = getComputedStyle(card)
        return intro.reduce((total, element) => total + element.getBoundingClientRect().height, 0)
          + Math.max(0, intro.length - 1) * (parseFloat(style.rowGap) || 0)
          + parseFloat(style.paddingTop) + parseFloat(style.paddingBottom)
      })))
      track.style.setProperty('--member-card-min-height', `${height}px`)
      updateNavigation()
    }
    const resize = new ResizeObserver(alignClosedCards)
    for (const card of cards) {
      for (const intro of card.querySelectorAll<HTMLElement>(':scope > p, :scope > a')) resize.observe(intro)
    }
    resize.observe(track)
    void document.fonts.ready.then(alignClosedCards)
    alignClosedCards()

    track.addEventListener('wheel', (event) => {
      if (!event.shiftKey) return
      event.preventDefault()
      track.scrollLeft += event.deltaY
    }, { passive: false })

    let dragStartX = 0
    let dragStartY = 0
    let dragStartScroll = 0
    let dragging = false
    let dragAxis: 'horizontal' | 'vertical' | null = null
    track.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return
      if ((event.target as Element).closest('summary, a, button, input, textarea, select')) return
      dragging = true
      dragAxis = null
      dragStartX = event.clientX
      dragStartY = event.clientY
      dragStartScroll = track.scrollLeft
    })
    track.addEventListener('pointermove', (event) => {
      if (!dragging) return
      if (!dragAxis) {
        const deltaX = event.clientX - dragStartX
        const deltaY = event.clientY - dragStartY
        if (Math.max(Math.abs(deltaX), Math.abs(deltaY)) < 6) return
        dragAxis = Math.abs(deltaX) > Math.abs(deltaY) ? 'horizontal' : 'vertical'
        if (dragAxis === 'horizontal') track.setPointerCapture(event.pointerId)
      }
      if (dragAxis !== 'horizontal') return
      track.scrollLeft = dragStartScroll - (event.clientX - dragStartX)
    })
    const stopDragging = () => {
      dragging = false
      dragAxis = null
    }
    window.addEventListener('pointerup', stopDragging)
    track.addEventListener('pointercancel', stopDragging)

    carousel.querySelectorAll<HTMLButtonElement>('[data-direction]').forEach((button) => {
      button.addEventListener('click', () => {
        const direction = button.dataset.direction === 'next' ? 1 : -1
        const card = track.querySelector<HTMLElement>('.membre')
        const step = (card?.getBoundingClientRect().width ?? track.clientWidth) + parseFloat(getComputedStyle(track).columnGap)
        track.scrollBy({ left: direction * step, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' })
      })
    })
  })
</script>

<style is:global>
  @media (min-width: 861px) {
    .equipe__titre-parcours { white-space: nowrap; }
  }
  .equipe__cartouche-image { display: block; width: 100%; height: auto; }
  .equipe__photo-cour img { object-position: center 60%; }
  .hero-zone .hz--mirror .hz__cta > .cta {
    --surface: #809b96 !important;
  }

  /* FONDEMENTS */
  .fond .fond__fig {
    color: var(--vert);
    top: 0 !important;
    transform: translate(-38%, 0) !important;
  }
  .fond__in {
    align-items: start;
  }
  .fond__txt {
    display: grid;
    align-content: start;
    gap: 1rem;
  }
  .fond__details {
    display: block;
  }
  .fond__details > :not(summary) {
    margin-top: 1rem;
  }
  .fond__details summary {
    cursor: pointer;
    line-height: var(--lh-corps);
    list-style: none;
  }
