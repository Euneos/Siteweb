import melissa from '../assets/photos/melissa-martinay-morgane-lombard.jpg'

const jalons = [
  'L’instruction interministérielle de 2022 inscrit les compétences psychosociales dans les objectifs éducatifs.',
  'La Stratégie Numérique pour l’éducation 2023-2027 fait de l’usage éclairé des outils numériques une priorité éducative nationale.',
  'En 2025, la santé mentale est déclarée Grande Cause nationale.',
]

/* Maquette v4 : les trois pictos sont NUS et colores (vert clair, orange,
   jaune), poses sur le fond — plus de cartouche. */
const actions = [
  {
    picto: 'main',
    couleur: 'var(--vert-clair)',
    titre: 'Révéler',
    texte: "Nous contribuons à révéler les facteurs de risque et de vulnérabilité qui pèsent sur le développement des jeunes et sur le climat des apprentissages, en nous appuyant sur la recherche internationale (neurosciences, psychologie du développement, santé publique, sciences de l'éducation).",
  },
  {
    picto: 'etoile',
    couleur: 'var(--orange)',
    titre: 'Éclairer',
    texte: "Nous sensibilisons les équipes pédagogiques à la prévention en santé mentale, à la transmission des compétences émotionnelles et relationnelles, au rapport au numérique, et les accompagnons dans l'appropriation d'outils adaptés à leurs pratiques existantes.",
  },
  {
    picto: 'asterisque',
    couleur: 'var(--jaune)',
    titre: 'Diffuser',
    texte: "Nous mesurons l'impact des approches (questionnaires, indicateurs de suivi, évaluations) pour améliorer en continu les outils et les pratiques et les déployer à grande échelle.",
  },
] as const

const niveaux: {
  surtitre?: string
  titre: string
  texte: string
  ligne2?: string
  cta: string
  ctaSurface: 'jaune' | 'bleu-fonce' | 'rose' | 'ocre'
  href: string
}[] = [
  {
    titre: 'Sensibilisation',
    texte: 'Formats légers, conférences, ressources en ligne, webinaires.',
    cta: 'En savoir +',
    ctaSurface: 'jaune',
    href: '/contact',
  },
  {
    surtitre: 'Formation longue durée',
    titre: 'Le Programme',
    texte: '16 h pour le personnel en poste qui anime',
    ligne2: 'ensuite les ateliers auprès des jeunes.',
    cta: 'Découvrir notre programme clé',
    ctaSurface: 'bleu-fonce',
    href: '/programme',
  },
  {
    titre: 'Accompagnement au quotidien',
    texte: 'Suivi post-formation, analyse de pratiques,',
    ligne2: 'réseau de pairs entre référents.',
    cta: 'Contactez-nous',
    ctaSurface: 'rose',
    href: '/contact',
  },
  {
    titre: 'Plaidoyer',
    texte: 'Comité scientifique, groupes de travail, dialogue institutionnel, influence sur les politiques publiques.',
    cta: 'En savoir +',
    ctaSurface: 'ocre',
    href: '/contact',
  },
]

/* Fonctions corrigees le 20/08 (maquette v2 p.3). NB : la page 1 signe la
   citation de Candice « Fondatrice et Presidente » — l'ecart est dans la
   maquette elle-meme, a trancher avec elle. */
