---
import Base from '../layouts/Base.astro'
import Cta from '../components/Cta.astro'
import FaqList from '../components/FaqList.astro'
import faqData from '../data/faq.json'
const publics = [
  { id: 'etablissements', titre: 'Établissements', groupes: faqData.etablissements },
  { id: 'formateurs', titre: 'Formateurs et formatrices', groupes: faqData.formateurs },
]
---
<Base title="FAQ — Programme Euneos (Wise Up)" description="Toutes les réponses sur la candidature, la formation et les ateliers du Programme Euneos (Wise Up), pour les établissements et les formateurs." heroFold="none">
  <section class="section faq-page s-vert">
    <div class="page faq-complete">
      <div>
        <h1>FAQ</h1>
        {publics.map((publicFaq) => (
          <section id={publicFaq.id} class="faq-complete__public" aria-labelledby={`${publicFaq.id}-titre`}>
            <h2 id={`${publicFaq.id}-titre`}>{publicFaq.titre}</h2>
            {publicFaq.groupes.map((groupe) => (
              <section class="faq-complete__groupe">
                <h3>{groupe.titre}</h3>
                <FaqList questions={groupe.questions} />
              </section>
            ))}
          </section>
        ))}
        <div class="faq-complete__retour"><Cta href="/programme" surface="bleu-fonce">Revenir au Programme</Cta></div>
      </div>

    </div>
  </section>
</Base>
<style>
  :global(body:has(.faq-page)) { background: var(--vert); }
  .faq-page { background: var(--vert); color: var(--blanc); --faq-rule: color-mix(in srgb, var(--blanc) 35%, transparent); --faq-toggle: var(--blanc); }
  .faq-complete { max-width: 60rem; }
  .faq-complete h1 { color: var(--blanc); }
  .faq-complete h2 { color: var(--vert-clair); }
  .faq-complete__public { margin-top: var(--s-titre); scroll-margin-top: 2rem; }
  .faq-complete__groupe { margin-top: var(--s-int); }
  .faq-complete__groupe h3 { font-size: var(--t-carte); margin-bottom: 1rem; color: var(--jaune); }
  .faq-complete__retour { margin-top: var(--s-titre); }
</style>
