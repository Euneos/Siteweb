---
/**
 * Page 404. Sans elle, Cloudflare renvoyait une page en HTTP 200 pour
 * n'importe quelle URL inconnue : les moteurs indexaient des adresses
 * inexistantes et le visiteur ne comprenait pas ou il etait.
 */
import Cta from '../components/Cta.astro'
import Paper from '../components/Paper.astro'
import Base from '../layouts/Base.astro'
---

<Base
  title="Page introuvable — EUNEOS"
  description="Cette page n’existe pas ou plus."
  heroFold="none"
  noindex
>
  <section class="section nf s-vert">
    <div class="page">
      <Paper surface="vert" outline fold="tr" foldSize="clamp(3rem, 7vw, 7rem)" class="nf__panel">
        <p class="nf__code">404</p>
        <h1>Cette page n’existe pas</h1>
        <p class="nf__txt">
          Le lien est peut-être ancien, ou l’adresse comporte une erreur.
        </p>
        <div class="nf__liens">
          <Cta href="/" surface="blanc">Retour au site</Cta>
          <div class="nf__secondaires">
            <Cta href="/programme" surface="vert" outline>Découvrir le Programme</Cta>
            <Cta href="/contact" surface="vert" outline>Nous contacter</Cta>
          </div>
        </div>
      </Paper>
    </div>
  </section>
</Base>

<style is:global>
  body:has(.nf) {
    background: var(--vert);
  }
  .nf__panel {
    --filet: var(--blanc);
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 3rem);
    text-align: center;
  }
  .nf__code {
    font-size: var(--t-chiffre-xl);
    font-weight: 700;
    line-height: 1;
    color: var(--vert-clair);
  }
  .nf__panel h1 {
    color: var(--blanc);
    font-size: var(--t-titre);
    margin-top: 0.5rem;
  }
  .nf__txt {
    color: var(--blanc);
    max-width: 44ch;
    margin: var(--s-lie) auto 0;
  }
  .nf__liens {
    display: grid;
    justify-items: center;
    gap: var(--s-int);
    margin-top: var(--s-titre);
  }
  .nf__secondaires {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
  }
</style>
