---
import Base from '../../layouts/Base.astro'
import Paper from '../../components/Paper.astro'
import { surveyTitle, surveyQuestions, surveyThanks } from '../../lib/sondage-annee2'
import { operationalHeaders } from '../../lib/operational-links'
export const prerender = false
for (const [key, value] of Object.entries(operationalHeaders))
  Astro.response.headers.set(key, value)
const sections = [...new Set(surveyQuestions.map((q) => q.section))]
---

<Base
  title={`${surveyTitle} — EUNEOS`}
  description={surveyTitle}
  noindex
  heroSurface="vert"
  heroFold="none"
>
  <section class="section cand survey">
    <div class="page">
      <Paper outline fold="none" class="cand__panel">
        <p class="survey-eyebrow">Programme clé Euneos : WISE-UP</p>
        <h1>{surveyTitle}</h1>
        <p class="cand__chapo">
          Après les 16 heures de formation de votre équipe et les quatre ateliers menés avec les
          élèves, nous souhaitons prendre de vos nouvelles et réfléchir avec vous aux suites
          possibles de WISE-UP.
          <br />
          Ce questionnaire nous aidera à identifier les activités les plus utiles pour votre établissement,
          les personnes à impliquer et l’accompagnement nécessaire. <strong
            >Vos réponses ne vous engagent pas à participer aux actions proposées.</strong
          >
        </p>
        <p class="cand__legal survey-required">
          Les champs marqués d’un astérisque sont obligatoires. Les autres réponses sont
          facultatives.
        </p>
        <noscript><p class="cand__ok">Activez JavaScript pour envoyer le sondage.</p></noscript>
        <form
          id="survey-form"
          class="cand__form"
          action="/api/questionnaires/sondage-annee2"
          method="post"
        >
          <input
            class="form-trap"
            name="website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />
          {
            sections.map((section) => (
              <Fragment>
                <div class="cand__section">
                  <h2>{section}</h2>
                </div>
                {surveyQuestions
                  .filter((q) => q.section === section)
                  .map((q) => (
                    <div
                      class:list={['cand__row', q.section !== sections[0] && 'cand__row--large']}
                      data-when={q.when}
                      data-when-value={q.whenValue}
                      hidden={!!q.when}
                    >
                      {q.type === 'ranking' ? (
                        <fieldset class="cand__choix">
                          <legend>{q.label}</legend>
                          <p class="cand__aide survey-instruction">
                            Utilisez chaque rang une seule fois. Laissez « Autre » sans rang si vous
                            n’avez pas de proposition supplémentaire.
                          </p>
                          {q.choices!.map((choice, i) => (
                            <label class="survey-rank cand__row">
                              <span>{choice}</span>
                              <span class="champ">
                                <select name={`${q.key}Rank${i}`} data-rank-choice={choice}>
                                  <option value="">Non classée</option>
                                  {q.choices!.map((_, rank) => (
                                    <option value={rank + 1}>
                                      {rank + 1}
                                      {rank === 0 ? ' — le plus d’intérêt' : ''}
                                    </option>
                                  ))}
                                </select>
                              </span>
                            </label>
                          ))}
                        </fieldset>
                      ) : q.choices ? (
                        <fieldset class="cand__choix">
                          <legend>{q.label}</legend>
                          <p class="cand__aide survey-instruction">
                            {q.type === 'checkbox'
                              ? 'Plusieurs réponses possibles.'
                              : 'Une seule réponse.'}
                          </p>
                          <ul>
                            {q.choices.map((choice, i) => (
                              <li>
                                <label>
                                  <input
                                    id={`${q.key}-${i}`}
                                    type={q.type === 'checkbox' ? 'checkbox' : 'radio'}
                                    name={q.key}
                                    value={choice}
                                    disabled={!!q.when}
                                  />
                                  <span>{choice}</span>
                                </label>
                                {q.other && choice === 'Autre' && (
                                  <div class="cand__row survey-other" data-other={q.key}>
                                    <label for={`${q.key}-other`}>Précisez votre réponse</label>
                                    <span class="champ">
                                      <textarea
                                        id={`${q.key}-other`}
                                        name={`${q.key}Other`}
                                        rows="3"
                                        maxlength="2000"
                                      />
                                    </span>
                                  </div>
                                )}
                              </li>
                            ))}
                          </ul>
                        </fieldset>
                      ) : (
                        <>
                          <label for={q.key}>
                            {q.label}
                            {q.required && <abbr title="obligatoire">&nbsp;*</abbr>}
                          </label>
                          <span class="champ">
                            {q.type === 'textarea' ? (
                              <textarea
                                id={q.key}
                                name={q.key}
                                rows="5"
                                maxlength="5000"
                                aria-describedby={
                                  q.description ? `${q.key}-description` : undefined
                                }
                              />
                            ) : (
                              <input
                                id={q.key}
                                name={q.key}
                                type={q.type}
                                required={q.required}
                                maxlength="300"
                                disabled={!!q.when}
                              />
                            )}
                          </span>
                          {q.description && (
                            <span class="cand__aide survey-instruction" id={`${q.key}-description`}>
                              {q.description}
                            </span>
                          )}
                        </>
                      )}
                      {q.other && q.type === 'ranking' && (
                        <div class="cand__row" data-other={q.key}>
                          <label for={`${q.key}-other`}>Précisez votre réponse « Autre »</label>
                          <span class="champ">
                            <textarea
                              id={`${q.key}-other`}
                              name={`${q.key}Other`}
                              rows="3"
                              maxlength="2000"
                            />
                          </span>
                        </div>
                      )}
                    </div>
                  ))}
              </Fragment>
            ))
          }
          <div class="cand__row--large">
            <p class="cand__aide">
              Sauf opposition, votre adresse sera utilisée pour vous envoyer la newsletter Euneos
              destinée aux établissements. Vous pourrez vous désabonner à tout moment.
            </p>
            <p class="cand__consent">
              <label>
                <input type="checkbox" name="newsletterOptOut" />
                <span class="cand__aide">Je ne souhaite pas m’abonner à la newsletter Euneos.</span>
              </label>
            </p>
          </div>
          <div class="cand__submit">
            <button class="cta s-vert cta--cut" type="submit">Envoyer mes réponses</button>
          </div>
          <p class="cand__row--large survey-thanks">{surveyThanks}</p>
        </form>
        <p
          id="survey-feedback"
          class="cand__ok"
          role="status"
          aria-live="polite"
          tabindex="-1"
          hidden
        >
        </p>
      </Paper>
    </div>
  </section>
</Base>
<script src="../../scripts/sondage-annee2.ts"></script>
