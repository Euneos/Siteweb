---
/**
 * Page 1 — Bienvenue (accueil).
 * Fidele a `maquette_euneos V 7 aout candice.pdf`, page 1 : 10 blocs.
 * Le copy est celui de la maquette v7 (et non du docx de structure, en retard).
 */
import Brand from '../components/Brand.astro'
import Cartouche from '../components/Cartouche.astro'
import Cta from '../components/Cta.astro'
import CtaFinal from '../components/CtaFinal.astro'
import Paper from '../components/Paper.astro'
import Photo from '../components/Photo.astro'
import classe from '../assets/photos/classe.jpg'
import PictoBox from '../components/PictoBox.astro'
import Base from '../layouts/Base.astro'

/* Textes fournis le 20/08 (« texte home dépliant.docx » + maquette v2).
   NB : le docx nomme la 2e colonne « Équipes formées », la maquette v2 dit
   « Enseignants formés » — on suit le docx, qui est le document de texte. */
const programme = [
  {
    picto: 'main',
    titre: '2 pôles de compétences',
    intro: 'Une formation pensée pour transmettre de manière complémentaire :',
    points: [
      'Des compétences psychosociales : attention, régulation émotionnelle, coopération, empathie.',
      'Des pratiques équilibrées et régulées du numérique : clarifier les habitudes, comprendre les usages.',
    ],
  },
  {
    picto: 'asterisque',
    titre: 'Équipes formées',
    intro: 'Un accompagnement qui renforce la coopération, l’attention et apaise les climats de classe :',
    points: [
      'Avec une pratique de présence attentive intégrée au quotidien professionnel ;',
      'et des outils concrets pour réguler le stress numérique et la surcharge informationnelle.',
    ],
  },
  {
    picto: 'oiseau',
    titre: 'Jeunes équilibrés',
    intro: 'Des jeunes qui développent des compétences fondamentales :',
    points: [
      'Concentration et stabilisation de leur attention.',
      'Régulation émotionnelle et une estime de soi plus solide.',
      'Des usages numériques plus conscients.',
    ],
  },
] as const

/* Resultats de la cohorte 1, fournis le 20/08 (maquette v2). */
/* Logos des partenaires — a fournir par EUNEOS (12 organisations partenaires
   d'apres la maquette). Tant que le tableau est vide, la rangee ne s'affiche pas. */
const logos: { src: string; alt: string }[] = []

const impact = [
  { valeur: '92 %', legende: 'recommanderaient le Programme sans hésiter' },
  {
    valeur: '45 %',
    legende: 'déclarent une évolution importante ou significative de leur posture professionnelle',
  },
  { valeur: '36 %', legende: 'rapportent une amélioration de l’attention des élèves' },
]

/* Maquette : le picto n'est pas blanc mais en ton sur ton avec l'etiquette —
   c'est la regle des paires de la charte (p.12). */
const parcours = [
  /* Les deux routes de candidature tranchees par Candice au call du 18/08 :
     « candidater en tant qu'etablissement et candidater en tant que formateur ».
     NB : la maquette v2 dit « devenir membre » — libelle a confirmer avec elle. */
  { surface: 'bleu-clair', label: 'Je suis un établissement', href: '/candidater/etablissement', picto: 'var(--bleu-fold)' },
  { surface: 'jaune', label: 'Je souhaite devenir formateur·rice', href: '/candidater/formateur', picto: 'var(--jaune-clair)' },
  { surface: 'vert', label: 'Je découvre EUNEOS', href: '/qui-sommes-nous', picto: 'var(--vert-clair)' },
] as const
---

<Base
  title="EUNEOS — Prévention en santé mentale dans les milieux éducatifs"
  description="EUNEOS forme les équipes éducatives à la prévention en santé mentale, à la transmission des compétences psychosociales et à l’accompagnement du rapport au numérique."
  heroSurface="vert"
>
  <!-- 1. HERO -->
  <section slot="hero" class="hz">
    <div class="hz__grid">
      <div class="hz__side">
        <div class="hz__cartouche"><Cartouche surface="ocre" fig="fig2" /></div>

        <div class="hz__bubblewrap">
          <Paper outline fold="tr" class="hz__bubble">
            <h1>
            Nous formons les équipes éducatives à prévenir les difficultés de santé
            mentale et à accompagner les jeunes à l’ère du numérique
          </h1>
          </Paper>
          <div class="hz__cta"><Cta href="/programme" surface="vert-clair">En savoir +</Cta></div>
        </div>
      </div>

      <div class="hz__media">
        <Photo
          src={classe}
          ratio="260/177.3"
          alt="Des collégiens assis en groupe, attentifs, pendant un atelier"
        />
      </div>

    </div>
  </section>

  <!-- 2. CONSTAT -->
  <section class="section constat has-silo">
    <div class="silo silo--left constat__fig" aria-hidden="true"><Brand name="fig2" height="100%" /></div>
    <div class="page g16 constat__in">
      <h2 style="grid-column: 5 / 9">Soutenons des climats de classe sereins et des éducateurs en santé</h2>
      <div style="grid-column: 10 / 17" class="constat__txt">
        <p>
          Aujourd’hui, + de 50 % des élèves de collèges et lycées présentent des plaintes
          psychologiques ou somatiques hebdomadaires, amplifiées par la saturation
          numérique… Quels outils et ressources mobiliser pour prévenir et soutenir le
          développement des jeunes ?<sup>*</sup>
        </p>
        <p class="source">
          * Ofcom (régulateur des communications britannique), données citées par le UK
          Parliament Education Committee, <em>Screen time: impacts on education and
          wellbeing</em>, 2023.
        </p>
        <Cta href="/programme">Découvrir notre programme</Cta>
      </div>
    </div>
  </section>

  <!-- 3. NOTRE APPROCHE -->
  <section class="section approche-sec">
    <div class="page approche">
      <Paper surface="orange" fold="none" class="approche__tag" as="h2">Notre approche</Paper>

      <div class="approche__media">
        <Photo ratio="3/2" label="photo — équipe éducative" />
        <div class="approche__picto">
          <PictoBox picto="asterisque" surface="jaune" size="clamp(62px, 6.2vw, 89px)" />
        </div>
      </div>

      <div class="approche__col">
        <Paper surface="vert" fold="tr" foldSize="md" class="approche__txt">
          <p>
            EUNEOS forme les équipes éducatives, premiers leviers d’apprentissage des jeunes,
            à la prévention en santé mentale, à la transmission des compétences psychosociales
            et à l’accompagnement du rapport au numérique.
          </p>
        </Paper>
        <div class="approche__cta">
          <Cta href="/qui-sommes-nous" surface="vert-clair">En savoir +</Cta>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. PREUVE -->
  <section class="section confiance">
    <div class="page">
      <h2 class="confiance__t">Merci pour leur confiance</h2>
      {
        /* Les logos des partenaires ne sont pas fournis. On n'affiche PAS six
           rectangles vides sur un site public : des que les fichiers arrivent,
           remplir ce tableau et la rangee reapparait. */
        logos.length > 0 && (
          <ul class="confiance__logos">
            {logos.map((l) => (
              <li>
                <img src={l.src} alt={l.alt} loading="lazy" />
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <!-- 5. NOTRE PROGRAMME — la famille bleue, reservee au Programme cle.
       Maquette : fond en bleu CLAIR, cartes en bleu soutenu pour qu'elles s'en
       detachent, grand pli en haut-gauche, CTA a cheval sur le bord bas. -->
  <section class="s-bleu-clair prog">
    <div class="prog__fold" aria-hidden="true"></div>
    <div class="page prog__in">
      <h2 class="prog__t">Notre Programme</h2>
      <ul class="prog__cards">
        {
          programme.map((c) => (
            <li>
              <Paper surface="bleu" fold="tr" foldSize="md" class="prog__card" as="details">
                <summary class="prog__resume">
                  <span class="prog__head">
                    <span class="prog__picto">
                      <Brand name={c.picto} />
                    </span>
                    <span class="prog__titre">{c.titre}</span>
                  </span>
                  <span class="prog__texte">
                    <span class="prog__p">{c.intro}</span>
                    {c.points.map((pt) => (
                      <span class="prog__p">{pt}</span>
                    ))}
                  </span>
                  <span class="prog__voile" aria-hidden="true" />
                  <span class="prog__fleche" aria-hidden="true">
                    <svg viewBox="0 0 24 32" fill="currentColor">
                      <path d="M9 0h6v20l6-6 2 2-11 11L1 16l2-2 6 6z" />
                    </svg>
                  </span>
                </summary>
              </Paper>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="prog__cta">
      <Cta href="/programme">Explorer notre programme</Cta>
    </div>
  </section>

  <!-- 6. NOTRE IMPACT -->
  <section class="section impact-sec">
    <div class="page">
      <h2 class="impact__t">Le résultat ?</h2>
      <p class="impact__sur">
        Retour d’expérience de 147 professionnels de l’éducation formés en 2025-2026 dans
        16 établissements pilotes
      </p>
      <ul class="impact__cards">
        {
          impact.map((s) => (
            <li>
              <Paper surface="vert" fold="tr" class="impact__card">
                <span class="impact__n">{s.valeur}</span>
                <p>{s.legende}</p>
              </Paper>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 6 bis. CANDIDATER — meme encart qu'en bas de « Notre programme ».
       Pose juste apres « Le resultat ? » : on demande l'engagement au moment
       ou la preuve vient d'etre donnee. -->
  <CtaFinal />

  <!-- 7. BLOC IMAGE -->
  <section class="section">
    <div class="page bloc-image">
      <div class="bloc-image__ph"><Photo ratio="16/10" label="photo — jeunes en situation réelle" /></div>
      <div class="bloc-image__picto">
        <PictoBox picto="asterisque" surface="orange" size="clamp(96px, 9.9vw, 143px)" paysage />
      </div>
      <div class="bloc-image__picto2">
        <PictoBox
          picto="coeur"
          surface="rose"
          size="clamp(116px, 12.1vw, 174px)"
          fold
          foldColor="var(--rose-fold)"
          class="bloc-image__rose"
        />
      </div>
    </div>
  </section>

  <!-- 8. CITATION -->
  <section class="section">
    <div class="page citation">
      <Paper surface="ocre" fold="none" class="citation__name">Candice Marro</Paper>
      <div class="citation__ph"><Photo ratio="3/4" label="portrait" /></div>
      <Paper surface="papier" fold="br" class="citation__card">
        <blockquote>
          « EUNEOS s’inscrit à l’intersection entre les enjeux éducatifs, numériques et de
          santé mentale. Le numérique agit comme un amplificateur des problématiques de
          santé mentale. L’action d’EUNEOS est d’agir en prévention, de donner des clés pour
          apprendre aux jeunes à se réguler grâce à des éducateurs formés et outillés. »
        </blockquote>
        <p class="citation__role">Fondatrice et Présidente EUNEOS</p>
      </Paper>
      <div class="citation__cta">
        <Cta href="/qui-sommes-nous">Qui sommes-nous ?</Cta>
      </div>
    </div>
  </section>

  <!-- 9. PARCOURS -->
  <section class="section parcours has-silo">
    <div class="silo silo--right parcours__fig" aria-hidden="true">
      <Brand name="fig4" height="100%" />
    </div>
    <div class="page parcours__in">
      <h2 class="parcours__t">Vous souhaitez prendre part au projet ?</h2>
      <ul class="parcours__cards">
        {
          parcours.map((p) => (
            <li>
              <a href={p.href} class="parcours__link">
                <Paper surface={p.surface} fold="br" foldSize="sm" class="parcours__card">
                  <div class="parcours__picto" style={`color:${p.picto}`}><Brand name="main" /></div>
                  <span>{p.label}</span>
                </Paper>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style is:global>
  /* --- CONSTAT : silhouette qui deborde du bord gauche --- */
  /* la maquette donne beaucoup d'air a ce bloc : la silhouette y fait toute la
     hauteur de la bande */
  .constat {
    padding-block: clamp(5rem, 14vw, 11rem);
  }
  .silo--left.constat__fig {
    color: var(--vert);
    /* releve : la silhouette occupe 0 → 25,3 % de la page. Le decalage
       negatif herite de .silo--left la faisait sortir de l'ecran. */
    height: clamp(19rem, 41vw, 36rem);
    max-width: 26%;
    transform: translate(0, -50%);
  }
  .constat__in {
    position: relative;
    align-items: start;
  }
  .constat__txt {
    display: grid;
    gap: 1.25rem;
    /* les paragraphes occupent toute la colonne ; seul le CTA se cale a gauche */
    justify-items: stretch;
  }
  .constat__txt .cta {
    justify-self: start;
  }
  @media (max-width: 860px) {
    .silo--left.constat__fig {
      display: none;
    }
  }

  /* --- APPROCHE ---
     Proportions relevees sur la maquette : l'etiquette orange coiffe la photo
     par le haut-droit, le cartouche jaune est a cheval sur son coin haut-gauche,
     le bloc vert descend a mi-hauteur et chevauche la photo, le CTA est pose a
     cheval sur le bord bas du bloc vert. */
  /* Geometrie relevee au pixel sur la maquette v2 (page 1), exprimee en % de
     la largeur de page :
       orange  35,6 → 63,1     photo  11,4 → 59,8
       vert    58,9 → 94,8     picto   5,0 → 11,0
     Le conteneur .page s'arrete a 93,06 % : le bloc vert doit donc DEBORDER
     a droite pour rejoindre le bord de la maquette. */
  .approche {
    display: grid;
    grid-template-columns: 61.4% 38.6%;
    align-items: start;
  }
  .approche__tag {
    grid-column: 1 / -1;
    justify-self: end;
    width: 31.9%;
    min-height: clamp(7.5rem, 17.5vw, 15.75rem);
    display: grid;
    place-items: center;
    margin-right: 34.8%;
    margin-bottom: -4.7rem;
    position: relative;
    z-index: 3;
    padding: clamp(1rem, 2.4vw, 1.75rem) clamp(1rem, 2.4vw, 1.75rem);
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1.2;
    font-weight: 600;
    text-align: center;
  }
  .approche__media {
    grid-column: 1;
    grid-row: 2;
    position: relative;
    /* la photo commence a 11,4 % de la page, pas au bord du conteneur */
    padding-left: 4.8%;
    z-index: 1;
  }
  .approche__picto {
    position: absolute;
    left: -7%;
    top: 8%;
    z-index: 3;
  }

  .approche__col {
    grid-column: 2;
    grid-row: 2;
    position: relative;
    align-self: start;
    /* le bloc vert commence 80 px sous le haut de la photo, et deborde de 2 %
       a droite pour atteindre le bord de la maquette */
    margin-top: 17.2%;
    margin-left: -1.1%;
    margin-right: -11.7%;
    z-index: 2;
  }
  /* releve : 214,8 x 108,6 pt */
  .approche__txt {
    max-width: none;
    min-height: clamp(9rem, 18.2vw, 16.4rem);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    padding-top: max(clamp(1.5rem, 3vw, 2.25rem), calc(var(--f) + 0.75rem));
    padding-left: clamp(2.25rem, 5vw, 4rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }
  .approche__cta {
    position: absolute;
    left: 30.7%;
    bottom: 0;
    transform: translateY(45%);
    z-index: 3;
  }
  @media (min-width: 861px) and (max-width: 1300px) {
    .approche__col {
      margin-right: 0;
    }
  }
  @media (max-width: 860px) {
    .approche {
      grid-template-columns: 1fr;
    }
    .approche__tag {
      width: auto;
      margin-right: 0;
      margin-bottom: -2rem;
      justify-self: start;
    }
    .approche__media,
    .approche__col {
      grid-column: 1;
      grid-row: auto;
    }
    .approche__col {
      margin: 1.5rem 0 0;
    }
    .approche__txt {
      padding-left: clamp(1.5rem, 3vw, 2.25rem);
    }
    .approche__cta {
      position: static;
      transform: none;
      margin-top: 1rem;
    }
  }

  /* --- CONFIANCE --- */
  .confiance__t {
    text-align: center;
    color: var(--vert);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
  }
  .confiance__logos {
    list-style: none;
    padding: 0;
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 5.75%;
  }
  .confiance__logos li {
    aspect-ratio: 60.5 / 42.8;
    background: var(--vert-clair);
    opacity: 0.85;
  }
  @media (max-width: 860px) {
    .confiance__logos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* --- PROGRAMME (famille bleue) --- */
  .prog {
    position: relative;
    background: var(--surface);
    color: var(--on-surface);
  }
  .prog__in {
    padding-block: clamp(3.5rem, 9vw, 7rem) 0;
  }
  /* releve au vecteur : pli aplati de 93,8 x 29,4 pt, soit 15,76 % x 4,94 %
     de la largeur de page — et non un triangle a 1,7:1 */
  .prog__fold {
    position: absolute;
    left: 0;
    top: 0;
    width: 15.76vw;
    max-width: 14rem;
    aspect-ratio: 93.8 / 29.4;
    background: var(--bleu);
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }
  .prog__t {
    text-align: center;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    color: var(--vert);
  }
  /* releve au vecteur : cartes de 125,6 x 166,7 pt (ratio 0,753) separees par
     des gouttieres de 71 pt, soit 13,7 % de la largeur du groupe */
  .prog__cards {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    /* 3c + 2g = largeur, avec g = 0,565 c (71 / 125,6 pt) -> gap = 13,68 % */
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 13.68%;
  }
  .prog__card.s-bleu {
    --prog-pad: 11%;
    height: 100%;
    min-height: 0;
    aspect-ratio: 125.6 / 166.7;
    padding: var(--prog-pad);
    display: grid;
    gap: 0.6rem;
    align-content: start;
    position: relative;
    /* releve : sur le bleu du Programme, le texte est BLANC. L'encre par
       defaut de la surface bleue est le vert — valable pour la navigation
       du hero, pas pour ces cartes. On surcharge la variable, pas la
       propriete : sinon la regle de .paper reprend le dessus. */
    --on-surface: var(--blanc);
  }
  .prog__card[open] {
    aspect-ratio: auto;
    padding-bottom: 14%;
  }
  .prog__card h3 {
    font-size: clamp(1rem, 1.5vw, 1.3rem);
  }
  .prog__intro {
    /* plancher mobile : jamais sous 15 px */
    font-size: max(0.95rem, 1.1vw);
    line-height: 1.45;
  }
  /* La carte est un <details> : repliee elle montre un apercu tronque et une
     fleche, depliee elle montre tout. Aucun JavaScript. */
  /* la fleche se cale en bas de la carte, comme dans la maquette */
  .prog__resume {
    display: grid;
    gap: 0.6rem;
    cursor: pointer;
    list-style: none;
  }
  .prog__resume::-webkit-details-marker {
    display: none;
  }
  .prog__head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding-right: max(0px, calc(var(--f) + 0.75rem - var(--prog-pad)));
  }
  .prog__titre {
    font-weight: 600;
    font-size: clamp(1rem, 1.5vw, 1.3rem);
    line-height: 1.15;
  }
  /* Tout le texte est present des l'etat replie : c'est la CARTE qui le coupe,
     exactement comme dans la maquette ou la phrase s'arrete en plein milieu.
     Depliee, la carte grandit et laisse tout voir. */
  .prog__texte {
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }
  .prog__p {
    font-size: max(0.95rem, 1.05vw);
    line-height: 1.45;
  }
  /* Replie : l'apercu remplit la place disponible et se fait couper par le
     bord de la carte, exactement comme dans la maquette. Un nombre de lignes
     fixe laissait un vide sous le texte. La reserve du bas laisse passer la
     fleche. */
  /* Repliee, la carte garde la hauteur de la maquette et COUPE simplement ce
     qui depasse. Un voile degrade rend la coupe volontaire et degage la
     fleche, qui sinon passerait par-dessus le texte. */
  .prog__card:not([open]) {
    overflow: hidden;
  }
  .prog__voile {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 5.5rem;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, var(--surface) 55%);
  }
  .prog__card[open] .prog__voile {
    display: none;
  }

  /* ancree en bas a droite de la carte, comme dans la maquette */
  .prog__fleche {
    position: absolute;
    right: 11%;
    bottom: 9%;
    display: block;
    width: 0.9rem;
    transition: transform 0.2s ease;
  }
  .prog__card[open] .prog__fleche {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .prog__fleche {
      transition: none;
    }
  }
  .prog__points li {
    padding-left: 0.9rem;
    position: relative;
  }
  .prog__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.35rem;
    height: 0.35rem;
    background: currentColor;
  }
  .prog__picto {
    /* largeur commune : les trois pictos n'ont pas le meme ratio, et sans
       cela les titres des trois cartes ne s'alignent pas */
    width: clamp(30px, 2.6vw, 38px);
    flex: none;
    display: flex;
    align-items: center;
    color: var(--blanc);
  }
  /* le CTA est pose a cheval sur le bord bas de la section */
  .prog__cta {
    position: relative;
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    transform: translateY(50%);
    z-index: 2;
  }
  @media (min-width: 861px) and (max-width: 1100px) {
    .prog__cards {
      /* Les gouttieres de la maquette desktop deviennent disproportionnees
         avant le passage en une colonne. */
