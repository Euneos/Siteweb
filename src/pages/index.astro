---
/**
 * Page 1 — Bienvenue (accueil).
 * Fidele a `maquette_euneos V 7 aout candice.pdf`, page 1 : 10 blocs.
 * Le copy est celui de la maquette v7 (et non du docx de structure, en retard).
 */
import Brand from '../components/Brand.astro'
import Cartouche from '../components/Cartouche.astro'
import Cta from '../components/Cta.astro'
import Paper from '../components/Paper.astro'
import Photo from '../components/Photo.astro'
import PictoBox from '../components/PictoBox.astro'
import Base from '../layouts/Base.astro'

const programme = [
  { picto: 'main', titre: 'Former les équipes', texte: 'À REDIGER — Pauline (retour le 26/08).' },
  { picto: 'asterisque', titre: 'Animer les ateliers', texte: 'À REDIGER — Pauline (retour le 26/08).' },
  { picto: 'oiseau', titre: 'Mesurer l’impact', texte: 'À REDIGER — Pauline (retour le 26/08).' },
] as const

/* Chiffres reels, releves page 2 de la maquette. Les « 86 % » de la maquette
   page 1 sont des placeholders : remplaces ici par les vrais chiffres. */
const impact = [
  { valeur: '16', legende: 'établissements pilotes engagés en 2025/2026' },
  { valeur: '6', legende: 'pays ont adhéré au Programme' },
  { valeur: '12', legende: 'organisations partenaires' },
]

const parcours = [
  { surface: 'bleu', label: 'Je suis un établissement', href: '/programme' },
  { surface: 'jaune', label: 'Je souhaite devenir partenaire', href: '/contact' },
  { surface: 'vert', label: 'Je découvre EUNEOS', href: '/qui-sommes-nous' },
] as const
---

<Base
  title="EUNEOS — Prévention en santé mentale dans les milieux éducatifs"
  description="EUNEOS forme les équipes éducatives à la prévention en santé mentale, à la transmission des compétences psychosociales et à l’accompagnement du rapport au numérique."
  heroSurface="vert"
>
  <!-- 1. HERO -->
  <section slot="hero" class="hz">
    <div class="hz__grid">
      <div class="hz__side">
        <Paper outline fold="tr" class="hz__bubble">
          <h1>
            Prévention en santé mentale et soutien du rapport au numérique
            <span class="hz__soft">dans les milieux éducatifs.</span>
          </h1>
        </Paper>
        <div class="hz__cartouche"><Cartouche surface="ocre" fig="fig2" /></div>
        <div class="hz__cta"><Cta href="/programme" surface="papier">En savoir +</Cta></div>
      </div>

      <div class="hz__media">
        <Photo ratio="5/4" label="photo — climat de classe" />
      </div>
    </div>
  </section>

  <!-- 2. CONSTAT -->
  <section class="section constat has-silo">
    <div class="silo silo--left constat__fig" aria-hidden="true"><Brand name="fig2" /></div>
    <div class="page g16 constat__in">
      <h2 style="grid-column: 4 / 9">Apaisons l’environnement éducatif</h2>
      <div style="grid-column: 10 / 17" class="constat__txt">
        <p>
          Aujourd’hui, + de 50 % des élèves de collèges et lycées présentent des plaintes
          psychologiques ou somatiques hebdomadaires, amplifiées par la saturation
          numérique… Quels outils et ressources mobiliser pour prévenir et soutenir le
          développement des jeunes ?
        </p>
        <Cta href="/programme">Découvrir notre programme</Cta>
      </div>
    </div>
  </section>

  <!-- 3. NOTRE APPROCHE -->
  <section class="section">
    <div class="page g16 approche">
      <Paper surface="orange" fold="none" class="approche__tag" as="h2">Notre approche</Paper>

      <div class="approche__media">
        <Photo ratio="4/3" label="photo — équipe éducative" />
        <div class="approche__picto">
          <PictoBox picto="asterisque" surface="jaune" size="clamp(74px, 8vw, 112px)" />
        </div>
      </div>

      <Paper surface="vert" fold="br" class="approche__txt">
        <p>
          EUNEOS forme les équipes éducatives, premiers leviers d’apprentissage des jeunes,
          à la prévention en santé mentale, à la transmission des compétences psychosociales
          et à l’accompagnement du rapport au numérique.
        </p>
        <Cta href="/qui-sommes-nous" surface="papier">En savoir +</Cta>
      </Paper>
    </div>
  </section>

  <!-- 4. PREUVE -->
  <section class="section confiance">
    <div class="page">
      <h2 class="confiance__t">Merci pour leur confiance</h2>
      <ul class="confiance__logos">
        {
          Array.from({ length: 6 }).map(() => (
            <li aria-label="Logo partenaire à fournir" />
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. NOTRE PROGRAMME — bleu, couleur reservee au Programme cle -->
  <section class="s-bleu prog">
    <div class="prog__fold" aria-hidden="true"></div>
    <div class="page section">
      <h2 class="prog__t">Notre Programme</h2>
      <ul class="prog__cards">
        {
          programme.map((c) => (
            <li>
              <Paper surface="bleu" fold="tr" class="prog__card">
                <div class="prog__picto"><Brand name={c.picto} /></div>
                <h3>{c.titre}</h3>
                <p>{c.texte}</p>
              </Paper>
            </li>
          ))
        }
      </ul>
      <div class="prog__cta">
        <Cta href="/programme">Explorer notre programme</Cta>
      </div>
    </div>
  </section>

  <!-- 6. NOTRE IMPACT -->
  <section class="section">
    <div class="page">
      <h2 class="impact__t">Notre impact</h2>
      <ul class="impact__cards">
        {
          impact.map((s) => (
            <li>
              <Paper surface="vert" fold="tr" class="impact__card">
                <span class="impact__n">{s.valeur}</span>
                <p>{s.legende}</p>
              </Paper>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. BLOC IMAGE -->
  <section class="section">
    <div class="page bloc-image">
      <div class="bloc-image__picto">
        <PictoBox picto="asterisque" surface="orange" size="clamp(74px, 8vw, 112px)" />
      </div>
      <div class="bloc-image__ph"><Photo ratio="16/10" label="photo — jeunes en situation réelle" /></div>
      <div class="bloc-image__picto2">
        <PictoBox picto="coeur" surface="rose" size="clamp(74px, 8vw, 112px)" />
      </div>
    </div>
  </section>

  <!-- 8. CITATION -->
  <section class="section">
    <div class="page citation">
      <Paper surface="ocre" fold="none" class="citation__name">Candice Marro</Paper>
      <div class="citation__ph"><Photo ratio="3/4" label="portrait" /></div>
      <Paper surface="blanc" fold="br" class="citation__card">
        <blockquote>
          « À l’intersection entre la santé globale et l’éducation, EUNEOS part d’un principe
          scientifiquement établi : le développement des jeunes s’équilibre quand ils
          apprennent à se reconnecter à eux-mêmes et aux autres. »
        </blockquote>
        <p class="citation__role">Fondatrice et Directrice Générale Euneos</p>
      </Paper>
      <div class="citation__cta">
        <Cta href="/qui-sommes-nous">Qui sommes-nous ?</Cta>
      </div>
    </div>
  </section>

  <!-- 9. PARCOURS -->
  <section class="section parcours">
    <div class="filigrane" aria-hidden="true"><div class="parcours__fig"><Brand name="fig4" /></div></div>
    <div class="page parcours__in">
      <h2 class="parcours__t">Vous souhaitez prendre part au projet ?</h2>
      <ul class="parcours__cards">
        {
          parcours.map((p) => (
            <li>
              <a href={p.href} class="parcours__link">
                <Paper surface={p.surface} fold="br" class="parcours__card">
                  <div class="parcours__picto"><Brand name="main" /></div>
                  <span>{p.label}</span>
                </Paper>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style is:global>
  /* --- CONSTAT : silhouette qui deborde du bord gauche --- */
  .constat__fig {
    color: var(--vert);
  }
  .constat__in {
    position: relative;
    align-items: center;
  }
  .constat__txt {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  @media (max-width: 860px) {
    .constat__fig {
      display: none;
    }
  }

  /* --- APPROCHE --- */
  .approche {
    align-items: start;
  }
  .approche__tag {
    grid-column: 7 / 14;
    position: relative;
    z-index: 2;
    padding: 1rem clamp(1rem, 3vw, 2rem);
    font-size: clamp(1.6rem, 3.4vw, 2.5rem);
    line-height: 1.2;
    font-weight: 600;
    margin: 0 0 -1px 0;
  }
  .approche__media {
    grid-column: 1 / 9;
    position: relative;
    margin-top: clamp(-3rem, -3vw, -1.5rem);
    z-index: 1;
  }
  .approche__picto {
    position: absolute;
    left: -6%;
    bottom: -8%;
    z-index: 3;
  }
  .approche__txt {
    grid-column: 9 / 17;
    align-self: end;
    margin-bottom: clamp(1rem, 4vw, 3rem);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  /* --- CONFIANCE --- */
  .confiance__t {
    text-align: center;
    color: var(--vert);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
  }
  .confiance__logos {
    list-style: none;
    padding: 0;
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2.5rem);
  }
  .confiance__logos li {
    aspect-ratio: 5 / 3;
    background: var(--vert-clair);
    opacity: 0.85;
  }
  @media (max-width: 860px) {
    .confiance__logos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* --- PROGRAMME (bleu) --- */
  .prog {
    position: relative;
    background: var(--surface);
    color: var(--on-surface);
  }
  .prog__fold {
    position: absolute;
    left: 0;
    top: 0;
    width: clamp(4rem, 12vw, 10rem);
    aspect-ratio: 1.6 / 1;
    background: var(--bleu-clair);
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }
  .prog__t {
    text-align: center;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .prog__cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2.25rem);
  }
  .prog__card {
    height: 100%;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    display: grid;
    gap: 1rem;
    align-content: start;
    --f: var(--fold-md);
  }
  .prog__picto {
    width: 3.25rem;
    color: var(--blanc);
  }
  .prog__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 5vw, 3rem);
  }
  @media (max-width: 860px) {
    .prog__cards {
      grid-template-columns: 1fr;
    }
  }

  /* --- IMPACT --- */
  .impact__t {
    text-align: center;
    color: var(--vert);
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .impact__cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2.25rem);
  }
  .impact__card {
    height: 100%;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    display: grid;
    gap: 0.5rem;
    align-content: start;
    --f: var(--fold-md);
  }
  .impact__n {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 600;
    line-height: 1;
  }
  @media (max-width: 860px) {
    .impact__cards {
      grid-template-columns: 1fr;
    }
  }

  /* --- BLOC IMAGE --- */
  .bloc-image {
    position: relative;
    padding-inline: clamp(1rem, 9vw, 7rem);
  }
  .bloc-image__picto,
  .bloc-image__picto2 {
    position: absolute;
    z-index: 1;
  }
  .bloc-image__picto {
    left: 0;
    bottom: 12%;
  }
  .bloc-image__picto2 {
    right: 0;
    top: -8%;
  }

  /* --- CITATION --- */
  .citation {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 2.1fr);
    grid-template-rows: auto auto auto;
    align-items: start;
    column-gap: 0;
  }
  .citation__name {
    grid-column: 1 / 2;
    grid-row: 1;
    padding: 0.85rem 1.5rem;
    font-weight: 600;
    font-size: 1.25rem;
    position: relative;
    z-index: 3;
    justify-self: start;
    margin-left: 8%;
    margin-bottom: -0.5rem;
  }
  .citation__ph {
    grid-column: 1 / 2;
    grid-row: 2;
    margin-left: 8%;
    position: relative;
    z-index: 2;
  }
  .citation__card {
    grid-column: 2 / 3;
    grid-row: 2;
    margin-left: -6%;
    z-index: 1;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    padding-left: clamp(2.5rem, 7vw, 6rem);
    align-self: center;
    display: grid;
    gap: 1.25rem;
  }
  .citation__card blockquote {
    margin: 0;
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .citation__role {
    font-style: italic;
    font-size: 0.95rem;
    opacity: 0.8;
  }
  .citation__cta {
    grid-column: 1 / 3;
    grid-row: 3;
    display: flex;
    justify-content: center;
    margin-top: -1.25rem;
    z-index: 2;
  }
  @media (max-width: 860px) {
    .citation {
      grid-template-columns: 1fr;
    }
    .citation__name,
    .citation__ph,
    .citation__card,
    .citation__cta {
      grid-column: 1 / -1;
      margin-left: 0;
    }
    .citation__name {
      grid-row: auto;
      justify-self: start;
    }
    .citation__ph,
    .citation__card,
    .citation__cta {
      grid-row: auto;
    }
    .citation__cta {
      margin-top: 1.5rem;
      justify-content: flex-start;
    }
  }

  /* --- PARCOURS --- */
  .parcours {
    position: relative;
    overflow: hidden;
  }
  .parcours__fig {
    right: -4%;
    color: var(--vert-clair);
  }
  .parcours__in {
    position: relative;
    z-index: 1;
  }
  .parcours__t {
    text-align: center;
    color: var(--vert);
    max-width: 22ch;
    margin: 0 auto clamp(2rem, 5vw, 3rem);
  }
  .parcours__cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2.5rem);
  }
  .parcours__link {
    text-decoration: none;
    display: block;
    height: 100%;
  }
  .parcours__card {
    height: 100%;
    padding: clamp(1.1rem, 2.4vw, 1.75rem);
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
    --f: var(--fold-md);
    transition: transform 0.15s ease;
  }
  .parcours__link:hover .paper {
    transform: translateY(-3px);
  }
  .parcours__picto {
    width: 2.25rem;
    flex: none;
  }
  @media (max-width: 860px) {
    .parcours__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
