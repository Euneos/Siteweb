---
/**
 * Page 1 — Bienvenue (accueil).
 * Fidele a `maquette_euneos V 7 aout candice.pdf`, page 1 : 10 blocs.
 * Le copy est celui de la maquette v7 (et non du docx de structure, en retard).
 */
import Brand from '../components/Brand.astro'
import Cartouche from '../components/Cartouche.astro'
import Cta from '../components/Cta.astro'
import Paper from '../components/Paper.astro'
import Photo from '../components/Photo.astro'
import PictoBox from '../components/PictoBox.astro'
import Base from '../layouts/Base.astro'

const programme = [
  { picto: 'main', titre: 'Former les équipes', texte: 'À REDIGER — Pauline (retour le 26/08).' },
  { picto: 'asterisque', titre: 'Animer les ateliers', texte: 'À REDIGER — Pauline (retour le 26/08).' },
  { picto: 'oiseau', titre: 'Mesurer l’impact', texte: 'À REDIGER — Pauline (retour le 26/08).' },
] as const

/* Chiffres reels, releves page 2 de la maquette. Les « 86 % » de la maquette
   page 1 sont des placeholders : remplaces ici par les vrais chiffres. */
const impact = [
  { valeur: '16', legende: 'établissements pilotes engagés en 2025/2026' },
  { valeur: '6', legende: 'pays ont adhéré au Programme' },
  { valeur: '12', legende: 'organisations partenaires' },
]

/* Maquette : le picto n'est pas blanc mais en ton sur ton avec l'etiquette —
   c'est la regle des paires de la charte (p.12). */
const parcours = [
  { surface: 'bleu-clair', label: 'Je suis un établissement', href: '/programme', picto: 'var(--bleu-fold)' },
  { surface: 'jaune', label: 'Je souhaite devenir partenaire', href: '/contact', picto: 'var(--jaune-clair)' },
  { surface: 'vert', label: 'Je découvre EUNEOS', href: '/qui-sommes-nous', picto: 'var(--vert-clair)' },
] as const
---

<Base
  title="EUNEOS — Prévention en santé mentale dans les milieux éducatifs"
  description="EUNEOS forme les équipes éducatives à la prévention en santé mentale, à la transmission des compétences psychosociales et à l’accompagnement du rapport au numérique."
  heroSurface="vert"
>
  <!-- 1. HERO -->
  <section slot="hero" class="hz">
    <div class="hz__grid">
      <div class="hz__side">
        <Paper outline fold="tr" class="hz__bubble">
          <h1>
            Prévention en santé mentale et soutien du rapport au numérique
            <span class="hz__soft">dans les milieux éducatifs.</span>
          </h1>
        </Paper>
        <div class="hz__cta"><Cta href="/programme" surface="papier">En savoir +</Cta></div>
      </div>

      <div class="hz__media">
        <Photo ratio="5/4" label="photo — climat de classe" />
      </div>

      <div class="hz__cartouche"><Cartouche surface="ocre" fig="fig2" /></div>
    </div>
  </section>

  <!-- 2. CONSTAT -->
  <section class="section constat has-silo">
    <div class="silo silo--left constat__fig" aria-hidden="true"><Brand name="fig2" height="100%" /></div>
    <div class="page g16 constat__in">
      <h2 style="grid-column: 4 / 9">Apaisons l’environnement éducatif</h2>
      <div style="grid-column: 10 / 15" class="constat__txt">
        <p>
          Aujourd’hui, + de 50 % des élèves de collèges et lycées présentent des plaintes
          psychologiques ou somatiques hebdomadaires, amplifiées par la saturation
          numérique… Quels outils et ressources mobiliser pour prévenir et soutenir le
          développement des jeunes ?
        </p>
        <Cta href="/programme">Découvrir notre programme</Cta>
      </div>
    </div>
  </section>

  <!-- 3. NOTRE APPROCHE -->
  <section class="section approche-sec">
    <div class="page approche">
      <Paper surface="orange" fold="none" class="approche__tag" as="h2">Notre approche</Paper>

      <div class="approche__media">
        <Photo ratio="3/2" label="photo — équipe éducative" />
        <div class="approche__picto">
          <PictoBox picto="asterisque" surface="jaune" size="clamp(64px, 5.5vw, 80px)" />
        </div>
      </div>

      <div class="approche__col">
        <Paper surface="vert" fold="tr" class="approche__txt">
          <p>
            EUNEOS forme les équipes éducatives, premiers leviers d’apprentissage des jeunes,
            à la prévention en santé mentale, à la transmission des compétences psychosociales
            et à l’accompagnement du rapport au numérique.
          </p>
        </Paper>
        <div class="approche__cta">
          <Cta href="/qui-sommes-nous" surface="papier">En savoir +</Cta>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. PREUVE -->
  <section class="section confiance">
    <div class="page">
      <h2 class="confiance__t">Merci pour leur confiance</h2>
      <ul class="confiance__logos">
        {
          Array.from({ length: 6 }).map(() => (
            <li aria-label="Logo partenaire à fournir" />
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. NOTRE PROGRAMME — la famille bleue, reservee au Programme cle.
       Maquette : fond en bleu CLAIR, cartes en bleu soutenu pour qu'elles s'en
       detachent, grand pli en haut-gauche, CTA a cheval sur le bord bas. -->
  <section class="s-bleu-clair prog">
    <div class="prog__fold" aria-hidden="true"></div>
    <div class="page prog__in">
      <h2 class="prog__t">Notre Programme</h2>
      <ul class="prog__cards">
        {
          programme.map((c) => (
            <li>
              <Paper surface="bleu" fold="tr" foldSize="md" class="prog__card">
                <div class="prog__picto"><Brand name={c.picto} /></div>
                <h3>{c.titre}</h3>
                <p>{c.texte}</p>
              </Paper>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="prog__cta">
      <Cta href="/programme">Explorer notre programme</Cta>
    </div>
  </section>

  <!-- 6. NOTRE IMPACT -->
  <section class="section impact-sec">
    <div class="page">
      <h2 class="impact__t">Notre impact</h2>
      <ul class="impact__cards">
        {
          impact.map((s) => (
            <li>
              <Paper surface="vert" fold="tr" class="impact__card">
                <span class="impact__n">{s.valeur}</span>
                <p>{s.legende}</p>
              </Paper>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. BLOC IMAGE -->
  <section class="section">
    <div class="page bloc-image">
      <div class="bloc-image__ph"><Photo ratio="16/10" label="photo — jeunes en situation réelle" /></div>
      <div class="bloc-image__picto">
        <PictoBox picto="asterisque" surface="orange" size="clamp(70px, 6.5vw, 96px)" />
      </div>
      <div class="bloc-image__picto2">
        <PictoBox picto="coeur" surface="rose" size="clamp(84px, 8vw, 118px)" fold />
      </div>
    </div>
  </section>

  <!-- 8. CITATION -->
  <section class="section">
    <div class="page citation">
      <Paper surface="ocre" fold="none" class="citation__name">Candice Marro</Paper>
      <div class="citation__ph"><Photo ratio="3/4" label="portrait" /></div>
      <Paper surface="blanc" fold="br" class="citation__card">
        <blockquote>
          « À l’intersection entre la santé globale et l’éducation, EUNEOS part d’un principe
          scientifiquement établi : le développement des jeunes s’équilibre quand ils
          apprennent à se reconnecter à eux-mêmes et aux autres. »
        </blockquote>
        <p class="citation__role">Fondatrice et Directrice Générale Euneos</p>
      </Paper>
      <div class="citation__cta">
        <Cta href="/qui-sommes-nous">Qui sommes-nous ?</Cta>
      </div>
    </div>
  </section>

  <!-- 9. PARCOURS -->
  <section class="section parcours has-silo">
    <div class="silo silo--right parcours__fig" aria-hidden="true">
      <Brand name="fig4" height="100%" />
    </div>
    <div class="page parcours__in">
      <h2 class="parcours__t">Vous souhaitez prendre part au projet ?</h2>
      <ul class="parcours__cards">
        {
          parcours.map((p) => (
            <li>
              <a href={p.href} class="parcours__link">
                <Paper surface={p.surface} fold="br" foldSize="md" class="parcours__card">
                  <div class="parcours__picto" style={`color:${p.picto}`}><Brand name="main" /></div>
                  <span>{p.label}</span>
                </Paper>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style is:global>
  /* --- CONSTAT : silhouette qui deborde du bord gauche --- */
  /* la maquette donne beaucoup d'air a ce bloc : la silhouette y fait toute la
     hauteur de la bande */
  .constat {
    padding-block: clamp(5rem, 14vw, 11rem);
  }
  .constat__fig {
    color: var(--vert);
    height: clamp(19rem, 36vw, 32rem);
    max-width: 30vw;
  }
  .constat__in {
    position: relative;
    align-items: center;
  }
  .constat__txt {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  @media (max-width: 860px) {
    .constat__fig {
      display: none;
    }
  }

  /* --- APPROCHE ---
     Proportions relevees sur la maquette : l'etiquette orange coiffe la photo
     par le haut-droit, le cartouche jaune est a cheval sur son coin haut-gauche,
     le bloc vert descend a mi-hauteur et chevauche la photo, le CTA est pose a
     cheval sur le bord bas du bloc vert. */
  .approche {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: start;
  }
  .approche__tag {
    grid-column: 1 / -1;
    justify-self: end;
    width: min(32%, 22rem);
    margin-right: 22%;
    margin-bottom: -3.5rem;
    position: relative;
    z-index: 3;
    padding: clamp(1rem, 2.4vw, 1.75rem) clamp(1rem, 2.4vw, 1.75rem);
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1.2;
    font-weight: 600;
    text-align: center;
  }
  .approche__media {
    grid-column: 1;
    grid-row: 2;
    position: relative;
    z-index: 1;
  }
  .approche__picto {
    position: absolute;
    left: -7%;
    top: 8%;
    z-index: 3;
  }
  .approche__col {
    grid-column: 2;
    grid-row: 2;
    position: relative;
    align-self: center;
    margin-top: 18%;
    margin-left: -18%;
    z-index: 2;
  }
  .approche__txt {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    padding-left: clamp(2.25rem, 5vw, 4rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }
  .approche__cta {
    position: absolute;
    left: clamp(2.25rem, 5vw, 4rem);
    bottom: 0;
    transform: translateY(45%);
    z-index: 3;
  }
  @media (max-width: 860px) {
    .approche {
      grid-template-columns: 1fr;
    }
    .approche__tag {
      width: auto;
      margin-right: 0;
      margin-bottom: -2rem;
      justify-self: start;
    }
    .approche__media,
    .approche__col {
      grid-column: 1;
      grid-row: auto;
    }
    .approche__col {
      margin: 1.5rem 0 0;
    }
    .approche__txt {
      padding-left: clamp(1.5rem, 3vw, 2.25rem);
    }
    .approche__cta {
      position: static;
      transform: none;
      margin-top: 1rem;
    }
  }

  /* --- CONFIANCE --- */
  .confiance__t {
    text-align: center;
    color: var(--vert);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
  }
  .confiance__logos {
    list-style: none;
    padding: 0;
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(1.25rem, 4vw, 3.25rem);
  }
  .confiance__logos li {
    aspect-ratio: 3 / 2;
    background: var(--vert-clair);
    opacity: 0.85;
  }
  @media (max-width: 860px) {
    .confiance__logos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* --- PROGRAMME (famille bleue) --- */
  .prog {
    position: relative;
    background: var(--surface);
    color: var(--on-surface);
  }
  .prog__in {
    padding-block: clamp(3.5rem, 9vw, 7rem) 0;
  }
  /* le grand pli en haut-gauche, en bleu soutenu sur le fond clair */
  .prog__fold {
    position: absolute;
    left: 0;
    top: 0;
    width: clamp(5rem, 14vw, 12rem);
    aspect-ratio: 1.7 / 1;
    background: var(--bleu);
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }
  .prog__t {
    text-align: center;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    color: var(--vert);
  }
  .prog__cards {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    width: min(100%, 62rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3.5vw, 3rem);
  }
  /* format portrait, comme dans la maquette */
  .prog__card {
    height: 100%;
    min-height: clamp(14rem, 24vw, 19rem);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    display: grid;
    gap: 0.85rem;
    align-content: start;
  }
  .prog__picto {
    width: 2.75rem;
    color: var(--blanc);
    margin-bottom: 0.5rem;
  }
  /* le CTA est pose a cheval sur le bord bas de la section */
  .prog__cta {
    position: relative;
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    transform: translateY(50%);
    z-index: 2;
  }
  @media (max-width: 860px) {
    .prog__cards {
      grid-template-columns: 1fr;
    }
    .prog__card {
      min-height: 0;
    }
  }

  /* --- IMPACT --- */
  .impact-sec {
    padding-top: clamp(4rem, 10vw, 8rem);
  }
  .impact__t {
    text-align: center;
    color: var(--vert);
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .impact__cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2.5rem);
  }
  /* maquette : cartes paysage, chiffre imposant, pli large et net */
  .impact__card {
    height: 100%;
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    display: grid;
    gap: 0.35rem;
    align-content: start;
    --f: clamp(2rem, 3.4vw, 3.25rem);
  }
  .impact__n {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 600;
    line-height: 1;
  }
  .impact__card p {
    font-size: 0.95rem;
    max-width: 30ch;
  }
  @media (max-width: 860px) {
    .impact__cards {
      grid-template-columns: 1fr;
    }
  }

  /* --- BLOC IMAGE --- */
  /* maquette : la photo est centree et ne fait qu'un peu plus de la moitie de la
     largeur ; le cartouche rose deborde a droite en haut, l'orange en bas a
     gauche. Le rose porte un coin plie. */
  .bloc-image {
    position: relative;
    width: min(100%, 54rem);
    margin-inline: auto;
  }
  .bloc-image__picto,
  .bloc-image__picto2 {
    position: absolute;
    z-index: 1;
  }
  .bloc-image__picto {
    left: 0;
    bottom: 0;
    transform: translate(-46%, 34%);
  }
  .bloc-image__picto2 {
    right: 0;
    top: 0;
    transform: translate(58%, 8%);
  }

  /* --- CITATION --- */
  .citation {
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 2.38fr);
    grid-template-rows: auto auto auto;
    align-items: start;
    column-gap: 0;
  }
  /* l'etiquette coiffe la CARTE, decalee a droite de la photo */
  .citation__name {
    grid-column: 1 / 3;
    grid-row: 1;
    padding: 0.85rem 1.6rem;
    font-weight: 600;
    font-size: 1.25rem;
    position: relative;
    z-index: 3;
    justify-self: start;
    margin-left: 20%;
    margin-bottom: -0.6rem;
  }
  .citation__ph {
    grid-column: 1 / 2;
    grid-row: 2;
    margin-left: 8%;
    position: relative;
    z-index: 2;
  }
  .citation__card {
    grid-column: 2 / 3;
    grid-row: 2;
    margin-left: -12%;
    z-index: 1;
    --f: clamp(2.5rem, 5vw, 4.5rem);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    padding-left: clamp(3rem, 10vw, 9.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    align-self: center;
    display: grid;
    gap: 1.25rem;
  }
  .citation__card blockquote {
    margin: 0;
    font-style: italic;
    font-size: 1rem;
    line-height: 1.6;
    max-width: 62ch;
  }
  .citation__role {
    font-style: italic;
    font-size: 0.95rem;
    opacity: 0.8;
  }
  .citation__cta {
    grid-column: 1 / 3;
    grid-row: 3;
    display: flex;
    justify-content: center;
    margin-top: -1.25rem;
    z-index: 2;
  }
  @media (max-width: 860px) {
    .citation {
      grid-template-columns: 1fr;
    }
    .citation__name,
    .citation__ph,
    .citation__card,
    .citation__cta {
      grid-column: 1 / -1;
      margin-left: 0;
    }
    .citation__name {
      grid-row: auto;
      justify-self: start;
    }
    .citation__ph,
    .citation__card,
    .citation__cta {
      grid-row: auto;
    }
    .citation__cta {
      margin-top: 1.5rem;
      justify-content: flex-start;
    }
  }

  /* --- PARCOURS ---
     Maquette : grande silhouette vert-gris a droite, PLEINE (elle passe derriere
     les etiquettes, qui sont opaques), et trois etiquettes d'un quart de largeur
     alignees a gauche. */
  .parcours {
    padding-block: clamp(4rem, 10vw, 8rem);
  }
  .parcours__fig {
    color: var(--vert-clair);
    height: clamp(20rem, 40vw, 34rem);
    max-width: 40vw;
  }
  .parcours__in {
    position: relative;
    z-index: 1;
  }
  .parcours__t {
    text-align: center;
    color: var(--vert);
    max-width: 22ch;
    margin: 0 auto clamp(2rem, 5vw, 3.5rem);
  }
  .parcours__cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 4vw, 3.25rem);
  }
  .parcours__link {
    text-decoration: none;
    display: block;
    height: 100%;
  }
  .parcours__card {
    height: 100%;
    padding: clamp(1.1rem, 2.2vw, 1.5rem);
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.25;
    transition: transform 0.15s ease;
  }
  .parcours__link:hover .paper {
    transform: translateY(-3px);
  }
  .parcours__picto {
    width: 2rem;
    flex: none;
  }
  @media (max-width: 860px) {
    .parcours__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
