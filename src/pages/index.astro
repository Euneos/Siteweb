---
/**
 * Page 1 — Bienvenue (accueil).
 * Fidele a `maquette_euneos V 7 aout candice.pdf`, page 1 : 10 blocs.
 * Le copy est celui de la maquette v7 (et non du docx de structure, en retard).
 */
import Brand from '../components/Brand.astro'
import Cartouche from '../components/Cartouche.astro'
import Cta from '../components/Cta.astro'
import CtaFinal from '../components/CtaFinal.astro'
import Paper from '../components/Paper.astro'
import Photo from '../components/Photo.astro'
import classe from '../assets/photos/classe.jpg'
import PictoBox from '../components/PictoBox.astro'
import Base from '../layouts/Base.astro'

/* Textes fournis le 20/08 (« texte home dépliant.docx » + maquette v2).
   NB : le docx nomme la 2e colonne « Équipes formées », la maquette v2 dit
   « Enseignants formés » — on suit le docx, qui est le document de texte. */
const programme = [
  {
    picto: 'main',
    titre: '2 pôles de compétences',
    intro: 'Une formation pensée pour transmettre de manière complémentaire :',
    points: [
      'Des compétences psychosociales : attention, régulation émotionnelle, coopération, empathie.',
      'Des pratiques équilibrées et régulées du numérique : clarifier les habitudes, comprendre les usages.',
    ],
  },
  {
    picto: 'asterisque',
    titre: 'Enseignants formés',
    intro: 'Un accompagnement qui renforce la coopération, l’attention et apaise les climats de classe :',
    points: [
      'Avec une pratique de présence attentive intégrée au quotidien professionnel ;',
      'et des outils concrets pour réguler le stress numérique et la surcharge informationnelle.',
    ],
  },
  {
    picto: 'oiseau',
    titre: 'Jeunes équilibrés',
    intro: 'Des jeunes qui développent des compétences fondamentales :',
    points: [
      'Concentration et stabilisation de leur attention.',
      'Régulation émotionnelle et une estime de soi plus solide.',
      'Des usages numériques plus conscients.',
    ],
  },
] as const

/* Resultats de la cohorte 1, fournis le 20/08 (maquette v2). */
/* Logos des partenaires — a fournir par EUNEOS (12 organisations partenaires
   d'apres la maquette). Tant que le tableau est vide, la rangee ne s'affiche pas. */
const logos: { src: string; alt: string }[] = []

const impact = [
  { valeur: '92 %', legende: 'recommanderaient le Programme sans hésiter' },
  {
    valeur: '45 %',
    legende: 'déclarent une évolution importante ou significative de leur posture professionnelle',
  },
  { valeur: '36 %', legende: 'rapportent une amélioration de l’attention des élèves' },
]

/* Maquette : le picto n'est pas blanc mais en ton sur ton avec l'etiquette —
   c'est la regle des paires de la charte (p.12). */
const parcours = [
  /* Les deux routes de candidature tranchees par Candice au call du 18/08 :
     « candidater en tant qu'etablissement et candidater en tant que formateur ».
     NB : la maquette v2 dit « devenir membre » — libelle a confirmer avec elle. */
  { surface: 'bleu', label: 'Je suis un établissement', href: '/candidater/etablissement', picto: 'var(--bleu-fold)' },
  { surface: 'jaune', label: 'Je souhaite devenir formateur·rice', href: '/candidater/formateur', picto: 'var(--jaune-clair)' },
  { surface: 'vert', label: 'Je découvre EUNEOS', href: '/qui-sommes-nous', picto: 'var(--vert-clair)' },
] as const
---

<Base
  title="EUNEOS — Prévention en santé mentale dans les milieux éducatifs"
  description="EUNEOS forme les équipes éducatives à la prévention en santé mentale, à la transmission des compétences psychosociales et à l’accompagnement du rapport au numérique."
  heroSurface="vert"
>
  <!-- 1. HERO -->
  <section slot="hero" class="hz">
    <div class="hz__grid">
      <div class="hz__side">
        <div class="hz__cartouche"><Cartouche surface="ocre" fig="fig2" /></div>

        <div class="hz__bubblewrap">
          <Paper outline fold="tr" class="hz__bubble">
            <h1>
            Nous formons les équipes éducatives à prévenir les difficultés de santé
            mentale et à accompagner les jeunes à l’ère du numérique
          </h1>
          </Paper>
          <div class="hz__cta"><Cta href="/programme" surface="vert-clair">En savoir +</Cta></div>
        </div>
      </div>

      <div class="hz__media">
        <Photo
          src={classe}
          ratio="260/177.3"
          alt="Des collégiens assis en groupe, attentifs, pendant un atelier"
        />
      </div>

    </div>
  </section>

  <!-- 2. CONSTAT -->
  <section class="section constat has-silo">
    <div class="silo silo--left constat__fig" aria-hidden="true"><Brand name="fig2" height="100%" /></div>
    <div class="page g16 constat__in">
      <h2 style="grid-column: 5 / 9">Soutenons des climats de classe sereins et des éducateurs en santé</h2>
      <div style="grid-column: 10 / 17" class="constat__txt">
        <p>
          Aujourd’hui, + de 50 % des élèves de collèges et lycées présentent des plaintes
          psychologiques ou somatiques hebdomadaires, amplifiées par la saturation
          numérique… Quels outils et ressources mobiliser pour prévenir et soutenir le
          développement des jeunes ?<sup>*</sup>
        </p>
        <p class="source">
          * Santé publique France, 2024, <em>« La santé mentale et le bien-être des
          collégiens et lycéens en France hexagonale »</em>, résultats de l’enquête
          EnCLASS 2022.
        </p>
        <Cta href="/programme">Découvrir notre programme</Cta>
      </div>
    </div>
  </section>

  <!-- 3. NOTRE APPROCHE -->
  <section class="section approche-sec">
    <div class="page approche">
      <Paper surface="orange" fold="none" class="approche__tag" as="h2">Notre approche</Paper>

      <div class="approche__media">
        <Photo ratio="3/2" label="photo — équipe éducative" />
        <div class="approche__picto">
          <PictoBox picto="asterisque" surface="jaune" size="sm" />
        </div>
      </div>

      <div class="approche__col">
        <Paper surface="vert" fold="tr" foldSize="md" class="approche__txt">
          <p>
            EUNEOS forme les équipes éducatives, premiers leviers d’apprentissage des jeunes,
            à la prévention en santé mentale, à la transmission des compétences psychosociales
            et à l’accompagnement du rapport au numérique.
          </p>
        </Paper>
        <div class="approche__cta">
          <Cta href="/qui-sommes-nous" surface="vert-clair">En savoir +</Cta>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. PREUVE -->
  <section class="section confiance">
    <div class="page">
      <h2 class="confiance__t">Merci pour leur confiance</h2>
      {
        /* Les logos des partenaires ne sont pas fournis. On n'affiche PAS six
           rectangles vides sur un site public : des que les fichiers arrivent,
           remplir ce tableau et la rangee reapparait. */
        logos.length > 0 && (
          <ul class="confiance__logos">
            {logos.map((l) => (
              <li>
                <img src={l.src} alt={l.alt} loading="lazy" />
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <!-- 5. NOTRE PROGRAMME — la famille bleue, reservee au Programme cle.
       Maquette : fond en bleu CLAIR, cartes en bleu soutenu pour qu'elles s'en
       detachent, grand pli en haut-gauche, CTA a cheval sur le bord bas.

       Chaque carte est un <details> : la partie visible (<summary>) porte le
       picto, le titre, l'introduction et le premier point — ce que la maquette
       montre carte repliee (le texte s'y arrete a « attention, regulation »,
       suivi d'une fleche vers le bas) ; les autres points sont en dehors du
       summary, donc caches tant que la carte est repliee. La fleche a ainsi
       TOUJOURS quelque chose a derouler. Avant, tout le texte etait dans le
       summary et seule la hauteur de la carte le coupait : sur un grand ecran
       tout tenait, et la fleche ne faisait rien (retour de Pauline). -->
  <section class="s-bleu-clair prog">
    <div class="prog__fold" aria-hidden="true"></div>
    <div class="page prog__in">
      <h2 class="prog__t">Notre Programme</h2>
      <ul class="prog__cards">
        {
          programme.map((c) => (
            <li>
              <Paper surface="bleu" fold="tr" foldSize="md" class="prog__card" as="details">
                <summary class="prog__resume">
                  <span class="prog__head">
                    <span class="prog__picto">
                      <Brand name={c.picto} />
                    </span>
                    <span class="prog__titre">{c.titre}</span>
                  </span>
                  <span class="prog__p">{c.intro}</span>
                  <span class="prog__p">{c.points[0]}</span>
                  <span class="prog__voile" aria-hidden="true" />
                  <span class="prog__fleche" aria-hidden="true">
                    <svg viewBox="0 0 24 32" fill="currentColor">
                      <path d="M9 0h6v20l6-6 2 2-11 11L1 16l2-2 6 6z" />
                    </svg>
                  </span>
                </summary>
                <div class="prog__texte">
                  {c.points.slice(1).map((pt) => (
                    <p class="prog__p">{pt}</p>
                  ))}
                </div>
              </Paper>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="prog__cta">
      <Cta href="/programme">Explorer notre programme</Cta>
    </div>
  </section>

  <!-- 6. NOTRE IMPACT -->
  <section class="section impact-sec">
    <div class="page">
      <h2 class="impact__t">Les premiers résultats</h2>
      <p class="impact__sur">
        Retour d’expérience de 147 professionnels de l’éducation formés en 2025-2026 dans
        16 établissements pilotes
      </p>
      <ul class="impact__cards">
        {
          impact.map((s) => (
            <li>
              <Paper surface="vert" fold="tr" class="impact__card">
                <span class="chiffre">{s.valeur}</span>
                <p>{s.legende}</p>
              </Paper>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 6 bis. CANDIDATER — meme encart qu'en bas de « Notre programme ».
       Pose juste apres « Le resultat ? » : on demande l'engagement au moment
       ou la preuve vient d'etre donnee. -->
  <CtaFinal />

  <!-- 7. CITATION — dans la maquette p.1, la citation de Candice vient AVANT le
       bloc image (l'ordre etait inverse sur le site). -->
  <section class="section">
    <div class="page citation">
      <Paper surface="ocre" fold="none" class="etiquette citation__name">Candice Marro</Paper>
      <div class="citation__ph"><Photo ratio="3/4" label="portrait" /></div>
      <Paper surface="papier" fold="br" class="citation__card">
        <blockquote>
          « EUNEOS s’inscrit à l’intersection entre les enjeux éducatifs, numériques et de
          santé mentale. Le numérique agit comme un amplificateur des problématiques de
          santé mentale. L’action d’EUNEOS est d’agir en prévention, de donner des clés pour
          apprendre aux jeunes à se réguler grâce à des éducateurs formés et outillés. »
        </blockquote>
        <p class="citation__role">Fondatrice et Directrice Générale EUNEOS</p>
      </Paper>
      <div class="citation__cta">
        <Cta href="/qui-sommes-nous">Qui sommes-nous ?</Cta>
      </div>
    </div>
  </section>

  <!-- 8. BLOC IMAGE -->
  <section class="section">
    <div class="page bloc-image">
      <div class="bloc-image__ph"><Photo ratio="16/10" label="photo — jeunes en situation réelle" /></div>
      <div class="bloc-image__picto">
        <PictoBox picto="asterisque" surface="orange" size="lg" paysage />
      </div>
      <div class="bloc-image__picto2">
        <PictoBox picto="coeur" surface="rose" size="lg" fold foldColor="var(--rose-fold)" class="bloc-image__rose" />
      </div>
    </div>
  </section>

  <!-- 9. PARCOURS -->
  <section class="section parcours has-silo">
    <div class="silo silo--right parcours__fig" aria-hidden="true">
      <Brand name="fig4" height="100%" />
    </div>
    <div class="page parcours__in">
      <h2 class="parcours__t">Vous souhaitez prendre part au projet ?</h2>
      <ul class="parcours__cards">
        {
          parcours.map((p) => (
            <li>
              <a href={p.href} class="parcours__link">
                <Paper surface={p.surface} fold="br" foldSize="sm" class="parcours__card">
                  <div class="parcours__picto" style={`color:${p.picto}`}><Brand name="main" /></div>
                  <span>{p.label}</span>
                </Paper>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style is:global>
  /* --- CONSTAT : silhouette qui deborde du bord gauche --- */
  /* La section garde le rythme commun (--s-bloc) ; elle est juste assez
     haute pour la silhouette, et le texte se centre dessus. Avant, elle
     avait son propre padding (jusqu'a 11 rem) : c'est un des espaces qui
     « variaient d'un bloc a l'autre ». */
  .constat {
    display: grid;
    align-content: center;
    min-height: clamp(20rem, 42vw, 37rem);
  }
  .silo--left.constat__fig {
    color: var(--vert);
    /* releve : la silhouette occupe 0 → 25,3 % de la page. Le decalage
       negatif herite de .silo--left la faisait sortir de l'ecran. */
    height: clamp(19rem, 41vw, 36rem);
    max-width: 26%;
    transform: translate(0, -50%);
  }
  .constat__in {
    position: relative;
    align-items: start;
  }
  .constat__txt {
    display: grid;
    gap: 1.1rem;
    /* les paragraphes occupent toute la colonne ; seul le CTA se cale a gauche */
    justify-items: stretch;
  }
  .constat__txt .cta {
    justify-self: start;
    margin-top: 0.75rem;
  }
  @media (max-width: 860px) {
    .silo--left.constat__fig {
      display: none;
    }
  }

  /* --- APPROCHE ---
     Proportions relevees sur la maquette : l'etiquette orange coiffe la photo
     par le haut-droit, le cartouche jaune est a cheval sur son coin haut-gauche,
     le bloc vert descend a mi-hauteur et chevauche la photo, le CTA est pose a
     cheval sur le bord bas du bloc vert. */
  /* Geometrie relevee au pixel sur la maquette v2 (page 1), exprimee en % de
     la largeur de page :
       orange  35,6 → 63,1     photo  11,4 → 59,8
       vert    58,9 → 94,8     picto   5,0 → 11,0
     Le conteneur .page s'arrete a 93,06 % : le bloc vert doit donc DEBORDER
     a droite pour rejoindre le bord de la maquette. */
  .approche {
    display: grid;
    grid-template-columns: 61.4% 38.6%;
    align-items: start;
  }
  .approche__tag {
    grid-column: 1 / -1;
    justify-self: end;
    width: 31.9%;
    min-height: clamp(7.5rem, 17.5vw, 15.75rem);
    display: grid;
    place-items: center;
    margin-right: 34.8%;
    margin-bottom: -4.7rem;
    position: relative;
    z-index: 3;
    padding: clamp(1rem, 2.4vw, 1.75rem) clamp(1rem, 2.4vw, 1.75rem);
    /* c'est un H2 : il herite du corps des titres (47 px), comme les autres */
    text-align: center;
  }
  .approche__media {
    grid-column: 1;
    grid-row: 2;
    position: relative;
    /* la photo commence a 11,4 % de la page, pas au bord du conteneur */
    padding-left: 4.8%;
    z-index: 1;
  }
  .approche__picto {
    position: absolute;
    left: -7%;
    top: 8%;
    z-index: 3;
  }

  .approche__col {
    grid-column: 2;
    grid-row: 2;
    position: relative;
    align-self: start;
    /* le bloc vert commence 80 px sous le haut de la photo, et deborde de 2 %
       a droite pour atteindre le bord de la maquette */
    margin-top: 17.2%;
    margin-left: -1.1%;
    margin-right: -11.7%;
    z-index: 2;
  }
  /* releve : 214,8 x 108,6 pt ; texte a 45 px du bord (--s-int), et sous
     le pli pour que la premiere ligne ne passe pas dessus */
  .approche__txt {
    max-width: none;
    /* maquette : ce bloc est compose un peu plus gras que le corps courant */
    font-weight: 600;
    min-height: clamp(9rem, 18.2vw, 16.4rem);
    padding: var(--s-int);
    padding-top: max(var(--s-int), calc(var(--f) + 0.5rem));
    padding-bottom: calc(var(--s-int) + 0.75rem);
  }
  /* le CTA est a cheval sur le bord bas du bloc vert : un tiers dedans */
  .approche__cta {
    position: absolute;
    left: 30.4%;
    bottom: 0;
    transform: translateY(65%);
    z-index: 3;
  }
  @media (min-width: 861px) and (max-width: 1300px) {
    .approche__col {
      margin-right: 0;
    }
  }
  @media (max-width: 860px) {
    .approche {
      grid-template-columns: 1fr;
    }
    .approche__tag {
      width: auto;
      margin-right: 0;
      margin-bottom: -2rem;
      justify-self: start;
    }
    .approche__media,
    .approche__col {
      grid-column: 1;
      grid-row: auto;
    }
    .approche__col {
      margin: 1.5rem 0 0;
    }
    .approche__txt {
      padding-left: clamp(1.5rem, 3vw, 2.25rem);
    }
    .approche__cta {
      position: static;
      transform: none;
      margin-top: 1rem;
    }
  }

  /* --- CONFIANCE --- */
  .confiance__t {
    text-align: center;
  }
  .confiance__logos {
    list-style: none;
    padding: 0;
    margin: var(--s-titre) 0 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 5.75%;
  }
  .confiance__logos li {
    aspect-ratio: 60.5 / 42.8;
    background: var(--vert-clair);
    opacity: 0.85;
  }
  @media (max-width: 860px) {
    .confiance__logos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* --- PROGRAMME (famille bleue) --- */
  /* releve au vecteur : pli aplati de 93,8 x 29,4 pt, soit 15,76 % x 4,94 %
     de la largeur de page. Dimensions partagees par l'entaille et le rabat. */
  .prog {
    position: relative;
    color: var(--on-surface);
    --pf-w: min(15.76vw, 14rem);
    --pf-h: calc(var(--pf-w) / 3.190);
    /* le CTA deborde du bandeau de la moitie de sa hauteur : la section
       suivante commence apres lui, a distance normale */
    margin-bottom: calc(var(--s-bloc) / 2 + var(--t-cta) * 0.9);
  }
  /* Le fond de la bande vit sur ::before pour qu'on puisse ENTAILLER son coin
     haut-gauche. Sans cette entaille, le triangle du pli se posait sur un coin
     intact : il se lisait comme un triangle colle, pas comme un coin replie
     (« le pli ne se replie pas », retour Charly). */
  .prog::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--surface);
    clip-path: polygon(var(--pf-w) 0, 100% 0, 100% 100%, 0 100%, 0 var(--pf-h));
  }
  /* releve v4 : 94 px entre le haut du bandeau et le titre */
  .prog__in {
    position: relative;
    z-index: 1;
    padding-block: calc(var(--s-bloc) * 0.77) 0;
  }
  /* Le rabat : le dessous de la feuille (bleu moyen) qui remplit l'entaille,
     avec un lisere de pli plus fonce le long de la diagonale (le crease). */
  .prog__fold {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    width: var(--pf-w);
    /* le rabat descend un peu SOUS la pliure : c'est ce debord qui fait
       « coin qui retombe » et non « triangle colorie » */
    height: calc(var(--pf-h) * 1.15);
    /* dessous de la feuille = bleu moyen (releve maquette : les cartes ont un
       rabat plus fonce, mais le grand bandeau est en bleu moyen) */
    background: var(--bleu);
    /* rabat mince pose SOUS la pliure. Son bord haut suit la diagonale de
       l'entaille — (100% 0) sur le bord haut, (0 87%) sur le bord gauche — puis
       il retombe en pointe. Le triangle AU-DESSUS de la pliure reste blanc (le
       fond), ce qui donne la vraie lecture d'un coin replie. */
    clip-path: polygon(100% 0, 0 87%, 68% 100%);
  }
  .prog__t {
    text-align: center;
    margin-bottom: var(--s-titre);
  }
  /* releve v4 (p.1 a 1440 px) : trois cartes de 304 x 404 (ratio 0,753) de
     189 a 1264 px, gouttieres de 82 px. Le rang fait donc 1075 px, soit
     91,1 % de la zone de contenu (1180 px), et la gouttiere 7,6 % du rang. La v2 avait des
     gouttieres de 172 px : les cartes etaient trop etroites et le texte s'y
     coupait une ligne plus tot que dans la maquette. */
  .prog__cards {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    width: 91.1%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 7.6%;
    /* une carte qui s'ouvre grandit seule : ses voisines ne bougent pas */
    align-items: start;
  }
  /* releve v4 : texte a 39 px du bord d'une carte de 304 px (12,8 %).
     PAS de height: 100 % ici : avec un aspect-ratio, une hauteur imposee par
     la rangee faisait recalculer la LARGEUR des cartes fermees quand une
     voisine s'ouvrait — elles s'elargissaient et sortaient de la grille
     (« ca fait n'importe quoi », retour de Charly). */
  .prog__card.s-bleu {
    --prog-pad: 12.8%;
    /* la reserve du bas loge la fleche, sous la derniere ligne */
    --prog-reserve: calc(var(--prog-pad) * 0.7 + 2.6rem);
    min-height: 0;
    aspect-ratio: 125.6 / 166.7;
    padding: var(--prog-pad);
    padding-bottom: var(--prog-reserve);
    display: grid;
    /* minmax(0, 1fr) et non auto : une piste auto s'elargit sur la largeur
       min-content de son contenu (ici l'en-tete picto + titre) et faisait
       deborder le texte a droite de la carte, hors de la zone de texte */
    grid-template-columns: minmax(0, 1fr);
    gap: 0.8rem;
    align-content: start;
    position: relative;
    /* releve : sur le bleu du Programme, le texte est BLANC. L'encre par
       defaut de la surface bleue est le vert — valable pour la navigation
       du hero, pas pour ces cartes. On surcharge la variable, pas la
       propriete : sinon la regle de .paper reprend le dessus. */
    --on-surface: var(--blanc);
  }
  .prog__card[open] {
    aspect-ratio: auto;
  }
  /* Repliee, la carte garde la hauteur de la maquette : le resume remplit
     la place disponible (une rangee 1fr) et ce qui depasse est coupe par le
     bord de la zone de texte, comme dans la maquette ou la phrase s'arrete
     en plein milieu. La fleche vit dans la reserve du bas, jamais sur le
     texte. Depliee, la carte grandit et laisse tout voir. */
  .prog__card:not([open]) {
    grid-template-rows: minmax(0, 1fr);
  }
  .prog__resume {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.8rem;
    cursor: pointer;
    list-style: none;
    min-height: 0;
    overflow: hidden;
  }
  .prog__card[open] .prog__resume {
    overflow: visible;
  }
  /* voile sur la derniere ligne coupee ; positionne par rapport a la carte,
     il echappe a l'overflow du resume */
  .prog__voile {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--prog-reserve);
    height: 1.6rem;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, var(--surface));
  }
  .prog__card[open] .prog__voile {
    display: none;
  }
  .prog__resume:focus-visible {
    outline: 3px solid var(--blanc);
    outline-offset: -3px;
  }
  .prog__resume::-webkit-details-marker {
    display: none;
  }
  .prog__head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding-right: max(0px, calc(var(--f) + 0.75rem - var(--prog-pad)));
  }
  /* 27 px dans la maquette : le seul titre de carte plus petit qu'un titre */
  .prog__titre {
    font-weight: 600;
    font-size: var(--t-carte);
    line-height: var(--lh-titre);
    min-width: 0;
  }
  .prog__texte {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.8rem;
    align-content: start;
    margin-top: 0.8rem;
  }
  .prog__p {
    line-height: var(--lh-corps);
  }

  /* ancree en bas a droite de la carte, dans la reserve du bas, comme dans
     la maquette (24 x 32 px a 28 px du bord) */
  .prog__fleche {
    position: absolute;
    right: var(--prog-pad);
    bottom: calc(var(--prog-pad) * 0.7);
    display: block;
    width: clamp(0.9rem, 1.65vw, 1.5rem);
    transition: transform 0.2s ease;
  }
  .prog__card[open] .prog__fleche {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .prog__fleche {
      transition: none;
    }
  }
  .prog__picto {
    /* largeur commune : les trois pictos n'ont pas le meme ratio, et sans
       cela les titres des trois cartes ne s'alignent pas */
    width: var(--picto-sm);
    flex: none;
    display: flex;
    align-items: center;
    color: var(--blanc);
  }
  /* le CTA est pose a cheval sur le bord bas de la section (releve v4 :
     132 px entre le bas des cartes et le bas du bandeau) */
  .prog__cta {
    position: relative;
    display: flex;
    justify-content: center;
    margin-top: calc(var(--s-bloc) * 0.55);
    transform: translateY(50%);
    z-index: 2;
  }
  @media (min-width: 861px) and (max-width: 1100px) {
    .prog__cards {
      /* Les gouttieres de la maquette desktop deviennent disproportionnees
         avant le passage en une colonne. */
      gap: clamp(1rem, 3vw, 2rem);
    }
  }
  @media (max-width: 860px) {
    .prog__cards {
      width: 100%;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .prog__card.s-bleu {
      --prog-pad: clamp(1.25rem, 5vw, 2rem);
      aspect-ratio: auto;
      padding: var(--prog-pad);
      padding-bottom: var(--prog-reserve);
    }
    /* en une colonne la carte prend la hauteur de son texte : rien n'est coupe */
    .prog__voile {
      display: none;
    }
  }

  /* --- IMPACT --- */
  .impact__t {
    text-align: center;
    margin-bottom: 0.75rem;
  }
  /* surtitre de provenance des chiffres (maquette v2) */
  /* Une seule ligne dans la maquette, de 11,8 % a 87,7 % de la page.
     Le max-width de 62ch la coupait en deux. */
  .impact__sur {
    text-align: center;
    margin: 0 auto var(--s-int);
  }
  /* releve : 3 cartes de 172,2 pt = 86,8 % de la page, gouttieres tres fines */
  /* La rangee va de 5,0 % a 94,8 % : elle deborde du padding de .page des
     DEUX cotes. On la centre donc sur la fenetre, pas sur le conteneur. */
  .impact__cards {
    list-style: none;
    padding: 0;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: 89.8vw;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6%;
  }
  /* maquette : cartes paysage, chiffre imposant, pli large et net */
  /* releve : 172,2 x 103,2 pt, pli 27,5 */
  .impact__card {
    height: 100%;
    min-height: clamp(8.5rem, 15vw, 13.5rem);
    padding: var(--s-int);
    display: grid;
    gap: 0.35rem;
    align-content: start;
    --f: var(--fold-md);
  }
  .impact__card p {
    max-width: 30ch;
  }
  @media (max-width: 860px) {
    .impact__cards {
      grid-template-columns: 1fr;
    }
  }

  /* --- BLOC IMAGE --- */
  /* maquette : la photo est centree et ne fait qu'un peu plus de la moitie de la
     largeur ; le cartouche rose deborde a droite en haut, l'orange en bas a
     gauche. Le rose porte un coin plie. */
  .bloc-image {
    position: relative;
    width: min(100%, 54rem);
    margin-inline: auto;
  }
  .bloc-image__picto,
  .bloc-image__picto2 {
    position: absolute;
    z-index: 1;
  }
  .bloc-image__picto {
    left: 0;
    bottom: 0;
    transform: translate(-46%, 34%);
  }
  /* releve : pli etire 11,1 x 19,6 pt sur le cartouche rose */
  .bloc-image__rose {
    --fx: clamp(1rem, 1.9vw, 1.7rem);
    --fy: clamp(1.7rem, 3.3vw, 3rem);
  }
  .bloc-image__picto2 {
    right: 0;
    top: 0;
    transform: translate(58%, 8%);
  }

  /* Sur petit ecran, les deux pictos debordaient hors de l'ecran : le rose
     poussait la page de 67 px et TOUTE la page d'accueil scrollait sur le
     cote. Les pictos ne retrecissent pas (clamp plancher a 96 et 116 px), donc
     on retrecit le bloc et on rentre le debordement. L'effet de debordement
     reste, il devient juste proportionne a l'ecran. */
  @media (max-width: 900px) {
    .bloc-image {
      width: 84%;
    }
    .bloc-image__picto {
      transform: translate(-20%, 34%);
    }
    .bloc-image__picto2 {
      transform: translate(18%, 8%);
    }
  }

  /* --- CITATION ---
     Releve v4 (page 1, a 1440 px) : photo 280 x 400 de 97 a 377 ; carte de
     421 a 1346 (925 x 320), pli carre de 146 ; etiquette 303 x 94 posee sur
     le bord haut de la carte, sans chevauchement ; citation en romain, role
     en italique, les deux au corps de texte. */
  .citation {
    display: grid;
    /* la carte demarre a 25,9 % du conteneur */
    grid-template-columns: 25.9% 74.1%;
    grid-template-rows: auto auto auto;
    align-items: start;
    column-gap: 0;
  }
  /* l'etiquette coiffe la CARTE, decalee a droite de la photo */
  .citation__name {
    grid-column: 1 / 3;
    grid-row: 1;
    position: relative;
    z-index: 3;
    justify-self: start;
    margin-left: 16.8%;
  }
  .citation__ph {
    grid-column: 1 / 2;
    grid-row: 2;
    width: 87%;
    position: relative;
    z-index: 2;
  }
  .citation__card {
    grid-column: 2 / 3;
    grid-row: 2;
    min-height: clamp(11rem, 22.2vw, 20rem);
    max-width: none;
    margin: 0;
    z-index: 1;
    --fx: clamp(2.5rem, 10.1vw, 9.5rem);
    --fy: clamp(2.5rem, 9.9vw, 9.25rem);
    padding: var(--s-int);
    padding-left: clamp(2rem, 5vw, 4.6rem);
    padding-bottom: max(var(--s-int), calc(var(--fy) * 0.55));
    align-self: start;
    display: grid;
    gap: 1.1em;
  }
  .citation__card blockquote {
    margin: 0;
    max-width: 64ch;
  }
  .citation__role {
    font-style: italic;
  }
  .citation__cta {
    grid-column: 1 / 3;
    grid-row: 3;
    display: flex;
    justify-content: center;
    margin-top: -1.125rem;
    z-index: 2;
  }
  @media (max-width: 860px) {
    .citation {
      grid-template-columns: 1fr;
    }
    .citation__name,
    .citation__ph,
    .citation__card,
    .citation__cta {
      grid-column: 1 / -1;
      margin-left: 0;
    }
    .citation__ph {
      width: 60%;
    }
    .citation__name {
      grid-row: auto;
      justify-self: start;
    }
    .citation__ph,
    .citation__card,
    .citation__cta {
      grid-row: auto;
    }
    .citation__cta {
      margin-top: 1.5rem;
      justify-content: flex-start;
    }
  }

  /* --- PARCOURS ---
     Maquette : grande silhouette vert-gris a droite, PLEINE (elle passe derriere
     les etiquettes, qui sont opaques), et trois etiquettes d'un quart de largeur
     alignees a gauche. */
  /* meme mecanique que le constat : rythme commun, hauteur mini pour la
     silhouette, contenu centre dessus */
  .parcours {
    display: grid;
    align-content: center;
    min-height: clamp(20rem, 42vw, 37rem);
  }
  .parcours__fig {
    color: var(--vert-clair);
    height: clamp(20rem, 40vw, 34rem);
    max-width: 40vw;
  }
  .parcours__in {
    position: relative;
    z-index: 1;
  }
  .parcours__t {
    text-align: center;
    max-width: 22ch;
    margin: 0 auto var(--s-titre);
  }
  /* Releve : les trois cartes vont de 5,2 % a 95,5 % de la page — donc au-dela
     du padding de .page. Centrees sur la fenetre, pas sur le conteneur. */
  .parcours__cards {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: 90.3vw;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    /* releve v4 : cartes de 368 px separees par 80 px, soit 6,5 % du rang */
    gap: 6.5%;
  }
  .parcours__link {
    text-decoration: none;
    display: block;
    height: 100%;
  }
  /* releve v4 : 368 x 196 px, libelle au corps des CTA (36 px), picto de
     70 px, pli d'etiquette (12,9 pt) et non de carte */
  .parcours__card {
    height: 100%;
    min-height: clamp(7rem, 13.6vw, 12.25rem);
    padding: var(--s-int);
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--t-cta);
    font-weight: 600;
    line-height: 1.15;
    --f: var(--fold-sm);
    /* maquette p.1 : le libelle est BLANC sur les trois cartes (bleu, jaune,
       vert). Contraste faible sur le jaune, assume — demande de Charly. */
    --on-surface: var(--blanc);
    color: var(--blanc);
    transition: transform 0.15s ease;
  }
  .parcours__link:hover .paper {
