---
/**
 * /newsletter — l'adresse dediee a l'inscription a la newsletter.
 *
 * Demandee par Pauline (retour sur la maquette v4, 1/09) : une URL a partager
 * telle quelle (LinkedIn, signature de mail, QR code) sans renvoyer vers le
 * pied de page. C'est le MEME formulaire que le pied de page : memes champs,
 * meme segmentation en trois profils, meme traitement (`POST /api/newsletter`
 * -> `inscrireNewsletter`, double confirmation Brevo). Une seule mecanique a
 * entretenir ; seule la page d'arrivee change, via le champ cache `retour`.
 *
 * Rendue a la demande (`prerender = false`) pour afficher le resultat de
 * l'envoi (`?nl=...`) sans JavaScript, comme la page Nous contacter.
 * Même présentation que les candidatures : fond vert, panneau et champs
 * rectangulaires à contour blanc, bouton blanc centré sur le bord bas.
 */
import Paper from '../components/Paper.astro'
import Base from '../layouts/Base.astro'
import { isNewsletterState, newsletterMessages, newsletterSuccess } from '../lib/newsletter-feedback'

export const prerender = false

const etat = Astro.url.searchParams.get('nl')
const succes = newsletterSuccess(etat)
const message = etat ? (isNewsletterState(etat) ? newsletterMessages[etat] : 'Une erreur est survenue.') : null

const profils = [
  { valeur: 'etablissement', label: 'Je suis un établissement' },
  { valeur: 'formateur', label: 'Je souhaite devenir formateur-ice' },
  { valeur: 'partenaire', label: 'Je souhaite être partenaire' },
]
---

<Base
  title="Newsletter — EUNEOS"
  description="Rejoignez la newsletter EUNEOS pour recevoir nos ressources et dernières actualités sur la prévention en santé mentale dans les milieux éducatifs."
  heroSurface="vert"
  heroFold="none"
>
  <div class="candidature-page s-vert">
  <section class="section cand nl" data-newsletter-page>
    <div class="page">
    <Paper outline fold="none" foldSize="clamp(3rem, 7vw, 7rem)" class="cand__panel">
      <h1 id="inscription">Notre newsletter</h1>
      <p class="cand__chapo">
        Rejoignez notre newsletter pour recevoir nos ressources et dernières actualités :
      </p>

      {
        !succes && (
          <form class="cand__form" id="nl-form" data-newsletter-form data-newsletter-status="nl-page-status" method="POST" action="/api/newsletter">
            <input class="form-trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <input type="hidden" name="retour" value="/newsletter" />

            <p class="cand__row">
              <label for="nlp-nom">Nom/Prénom</label>
              <span class="champ">
                <input id="nlp-nom" name="nom" type="text" autocomplete="name" maxlength="160" required />
              </span>
            </p>
            <p class="cand__row">
              <label for="nlp-mail">Email</label>
              <span class="champ">
                <input id="nlp-mail" name="email" type="email" autocomplete="email" maxlength="254" required />
              </span>
            </p>

            <fieldset class="cand__row cand__row--large cand__choix">
              <legend>Vous êtes</legend>
              <ul>
              {
                profils.map((p, i) => (
                  <li><label>
                    <input type="radio" name="profil" value={p.valeur} checked={i === 0} /> <span>{p.label}</span>
                  </label></li>
                ))
              }
              </ul>
            </fieldset>

            <p class="cand__legal">
              En envoyant ce formulaire, vous acceptez de recevoir la newsletter EUNEOS. Vous pourrez
              vous désinscrire à tout moment. <a href="/politique-de-confidentialite">En savoir plus</a>.
            </p>
          </form>
        )
      }
      <p id="nl-page-status" class:list={['nl__status', message && (succes ? 'is-ok' : 'is-error')]}
        role={message ? (succes ? 'status' : 'alert') : 'status'} aria-live={message && !succes ? 'assertive' : 'polite'} tabindex="-1">{message}</p>
      {
        !succes && (
          <div class="cand__submit">
            <button type="submit" form="nl-form" class="cta s-blanc cta--cut">Envoyer</button>
          </div>
        )
      }
    </Paper>
    </div>
  </section>
  </div>
</Base>

<style>
  .nl__status:empty { display: none; }
  .nl__status:not(:empty) {
    max-width: 46rem;
    margin: var(--s-lie) auto 0;
    padding: 0.9rem 1.1rem;
    border: 1.5px solid currentColor;
    font-weight: 600;
  }
  .nl__status.is-error {
    border-color: var(--orange);
    background: color-mix(in srgb, var(--orange) 10%, transparent);
  }
  button:disabled { cursor: wait; opacity: 0.65; }
</style>
