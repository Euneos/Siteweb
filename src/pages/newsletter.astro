---
/**
 * /newsletter — l'adresse dediee a l'inscription a la newsletter.
 *
 * Demandee par Pauline (retour sur la maquette v4, 1/09) : une URL a partager
 * telle quelle (LinkedIn, signature de mail, QR code) sans renvoyer vers le
 * pied de page. C'est le MEME formulaire que le pied de page : memes champs,
 * meme segmentation en trois profils, meme traitement (`POST /api/newsletter`
 * -> `inscrireNewsletter`, double confirmation Brevo). Une seule mecanique a
 * entretenir ; seule la page d'arrivee change, via le champ cache `retour`.
 *
 * Rendue a la demande (`prerender = false`) pour afficher le resultat de
 * l'envoi (`?nl=...`) sans JavaScript, comme la page Nous contacter.
 * Meme composition que Nous contacter (maquette v4 p.4) : page verte, panneau
 * a filet et coin plie, champs a coin coupe, bouton a cheval sur le bord bas.
 */
import Paper from '../components/Paper.astro'
import Base from '../layouts/Base.astro'

export const prerender = false

const etat = Astro.url.searchParams.get('nl')
const MESSAGES: Record<string, string> = {
  ok: 'Inscription confirmée. Bienvenue dans la newsletter EUNEOS.',
  confirmation: 'Vérifiez votre boîte e-mail et cliquez sur le lien reçu pour confirmer votre inscription.',
  confirme: 'Inscription confirmée. Bienvenue dans la newsletter EUNEOS.',
  erreur: 'Renseignez votre nom et votre adresse e-mail.',
  email: 'L’adresse e-mail ne semble pas valide.',
  profil: 'Choisissez le profil qui vous correspond.',
  indisponible: 'L’inscription est momentanément indisponible. Réessayez plus tard.',
  technique: 'Une erreur technique empêche l’inscription. Réessayez plus tard.',
}
const succes = ['ok', 'confirmation', 'confirme'].includes(etat ?? '')
const message = etat ? (MESSAGES[etat] ?? 'Une erreur est survenue.') : null

const profils = [
  { valeur: 'etablissement', label: 'Je suis un établissement' },
  { valeur: 'partenaire', label: 'Je suis partenaire' },
  { valeur: 'curieux', label: 'Je suis curieuse/curieux' },
]
---

<Base
  title="Newsletter — EUNEOS"
  description="Rejoignez la newsletter EUNEOS pour recevoir nos ressources et dernières actualités sur la prévention en santé mentale dans les milieux éducatifs."
  heroSurface="vert"
  heroFold="none"
>
  <section slot="hero" class="page nl" data-newsletter-page>
    <Paper outline fold="tr" foldSize="clamp(3rem, 7vw, 7rem)" class="nl__panel">
      <h1 id="inscription">Notre newsletter</h1>
      <p class="nl__chapo">
        Rejoignez notre newsletter pour recevoir nos ressources et dernières actualités :
      </p>

      {
        message && (
          <p class:list={['nl__status', succes ? 'nl__status--ok' : 'nl__status--err']} role={succes ? 'status' : 'alert'}>
            {message}
          </p>
        )
      }

      {
        !succes && (
          <form class="nl__form" id="nl-form" method="POST" action="/api/newsletter">
            <input class="form-trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <input type="hidden" name="retour" value="/newsletter" />

            <p class="nl__row">
              <label for="nlp-nom">Nom/Prénom</label>
              <span class="champ">
                <input id="nlp-nom" name="nom" type="text" autocomplete="name" maxlength="160" required />
              </span>
            </p>
            <p class="nl__row">
              <label for="nlp-mail">Email</label>
              <span class="champ">
                <input id="nlp-mail" name="email" type="email" autocomplete="email" maxlength="254" required />
              </span>
            </p>

            <fieldset class="nl__radios">
              <legend>Vous êtes</legend>
              {
                profils.map((p, i) => (
                  <label>
                    <input type="radio" name="profil" value={p.valeur} checked={i === 0} /> <span>{p.label}</span>
                  </label>
                ))
              }
            </fieldset>

            <p class="nl__privacy">
              En envoyant ce formulaire, vous acceptez de recevoir la newsletter EUNEOS. Vous pourrez
              vous désinscrire à tout moment. <a href="/politique-de-confidentialite">En savoir plus</a>.
            </p>
          </form>
        )
      }
      {
        !succes && (
          <div class="nl__submit">
            <button type="submit" form="nl-form" class="cta s-vert-clair">Envoyer</button>
          </div>
        )
      }
    </Paper>
  </section>
</Base>

<style is:global>
  .nl {
    width: 100%;
    padding-top: clamp(1rem, 3vw, 2.5rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  .nl__panel {
    position: relative;
    z-index: 3;
    width: min(100%, 44rem);
    margin-inline: auto;
    padding: var(--s-int);
    padding-top: max(var(--s-int), calc(var(--f) * 0.5));
    padding-bottom: calc(var(--s-int) + 1rem);
  }
  .nl__panel h1 {
    text-align: center;
  }
  .nl__chapo {
    text-align: center;
    max-width: 30ch;
    margin: 0.75rem auto var(--s-int);
  }
  .nl__status {
    max-width: 32rem;
    margin: 0 auto 1.5rem;
    padding: 0.85rem 1rem;
    border: 1.5px solid currentColor;
  }
  .nl__status--ok {
    background: color-mix(in srgb, var(--vert-clair) 24%, transparent);
  }
  .nl__status--err {
    background: color-mix(in srgb, var(--orange) 18%, transparent);
  }
  .nl__form {
    display: grid;
    gap: clamp(1.25rem, 2.8vw, 2.5rem);
    max-width: 32rem;
    margin-inline: auto;
  }
  .nl__row {
    display: grid;
    gap: 0.5rem;
  }
  .nl__row label,
  .nl__radios legend {
    font-weight: 600;
  }
  /* les champs sont des .champ (global.css), comme sur Nous contacter */
  .nl__radios input:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  .nl__radios {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.4rem;
  }
  .nl__radios legend {
    padding: 0;
    margin-bottom: 0.35rem;
  }
  .nl__radios label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
  }
  .nl__radios input {
    accent-color: var(--jaune);
    width: 1rem;
    height: 1rem;
  }
  .nl__privacy {
    font-size: var(--t-note);
    opacity: 0.85;
  }
  .nl__privacy a {
    color: inherit;
  }
  .nl__submit {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translate(-50%, 75%);
    z-index: 4;
  }
  @media (max-width: 480px) {
    .nl__panel {
      padding-top: max(var(--s-int), calc(var(--f) + 1rem));
    }
  }
</style>
