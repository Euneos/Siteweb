---
import Base from '../layouts/Base.astro'
import '../styles/operational-forms.css'
import { postformationDefinition, type PostformationSlug } from '../lib/postformation-definition'
interface Props {
  slug: PostformationSlug
  ready: boolean
  preview: boolean
}
const { ready, preview } = Astro.props
const def = postformationDefinition(Astro.props.slug)!
const sections = [...new Set(def.questions.map((q) => q.section))]
---

<Base
  title={`${def.title} — EUNEOS`}
  description={def.title}
  noindex
  heroSurface="vert"
  heroFold="none"
>
  <section class="page of-page">
    <div class="of-intro">
      <p class="of-eyebrow">Programme WISE-UP</p>
      <h1>{def.title}</h1>
      {def.introduction.split('\n\n').map((p) => <p class="pf-introduction">{p}</p>)}
    </div>
    {
      !ready ? (
        <p class="of-feedback" role="alert">
          Ce formulaire est momentanément indisponible. Réessayez plus tard ou contactez l’équipe
          EUNEOS.
        </p>
      ) : (
        <div class="of-panel">
          {preview && (
            <aside class="of-feedback">
              <strong>Aperçu de démonstration.</strong> Utilisez uniquement des informations
              fictives. Aucun enregistrement dans le suivi réel et aucun e-mail ne seront effectués.
            </aside>
          )}
          <p class="of-note">Les champs marqués d’un astérisque sont obligatoires.</p>
          <noscript>
            <p class="of-feedback" role="alert">
              Activez JavaScript pour envoyer ce formulaire. Votre saisie restera sur cette page en
              cas d’erreur.
            </p>
          </noscript>
          <form
            id="postformation-form"
            class="of-stack"
            method="post"
            action={`/api/questionnaires/${def.slug}`}
            data-version={def.version}
          >
            <div hidden aria-hidden="true">
              <label>
                Site web
                <input name="website" tabindex="-1" autocomplete="off" />
              </label>
            </div>
            {sections.map((section) => (
              <fieldset class="of-section">
                <legend>{section}</legend>
                {def.questions
                  .filter((q) => q.section === section)
                  .map((q) =>
                    q.type === 'radio' || q.type === 'checkbox' ? (
                      <fieldset
                        class="pf-choice"
                        data-multiple-required={
                          q.type === 'checkbox' && q.required ? 'true' : undefined
                        }
                      >
                        <legend>
                          {q.label}
                          {q.required ? ' *' : ''}
                        </legend>
                        {q.description && <p class="of-note">{q.description}</p>}
                        {q.choices.map((choice, i) => (
                          <label class="pf-option">
                            <input
                              type={q.type === 'checkbox' ? 'checkbox' : 'radio'}
                              name={q.key}
                              value={choice}
                              required={q.required && q.type === 'radio'}
                              id={`pf-${q.key}-${i}`}
                            />
                            <span>{choice}</span>
                          </label>
                        ))}
                        {q.other && (
                          <label class="of-field" for={`pf-${q.key}-other`}>
                            Autre réponse
                            <input
                              id={`pf-${q.key}-other`}
                              name={`${q.key}Other`}
                              data-other-for={q.key}
                              maxlength="5000"
                            />
                          </label>
                        )}
                      </fieldset>
                    ) : (
                      <label class="of-field" for={`pf-${q.key}`}>
                        <span class="pf-introduction">
                          {q.label}
                          {q.required ? ' *' : ''}
                        </span>
                        {q.description && <small id={`pf-${q.key}-help`}>{q.description}</small>}
                        {q.type === 'textarea' ? (
                          <textarea
                            id={`pf-${q.key}`}
                            name={q.key}
                            required={q.required}
                            maxlength={q.maxLength}
                            rows="4"
                          />
                        ) : (
                          <input
                            id={`pf-${q.key}`}
                            type={q.type}
                            name={q.key}
                            required={q.required}
                            maxlength={q.maxLength}
                            pattern={q.key === 'year' ? '20[0-9]{2}[-–—]20[0-9]{2}' : undefined}
                            autocomplete={
                              q.key === 'name' ? 'name' : q.key === 'email' ? 'email' : 'off'
                            }
                            aria-describedby={q.description ? `pf-${q.key}-help` : undefined}
                          />
                        )}
                      </label>
                    ),
                  )}
              </fieldset>
            ))}
            <p class="of-note">
              <a href="/politique-de-confidentialite">Politique de confidentialité</a>
            </p>
            <div class="of-actions">
              <button type="submit" class="cta s-vert cta--sm">
                Envoyer
              </button>
            </div>
            <p
              id="postformation-feedback"
              class="of-feedback"
              role="status"
              aria-live="polite"
              tabindex="-1"
              hidden
            />
          </form>
        </div>
      )
    }
  </section>
  <script src="../scripts/postformation.ts"></script>
</Base>
<style is:global>
  .pf-introduction {
    white-space: pre-line;
  }
  .pf-choice {
    min-width: 0;
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .pf-choice legend {
    font-size: var(--t-note);
    margin-bottom: 0.75rem;
  }
  .pf-option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    font-size: var(--t-corps);
    cursor: pointer;
    overflow-wrap: anywhere;
  }
  .pf-option input {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--vert);
  }
  .pf-option:focus-within {
    outline: 2px solid var(--vert);
    outline-offset: 3px;
  }
</style>
