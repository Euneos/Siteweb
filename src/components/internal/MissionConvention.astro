    overview.scrollIntoView({ behavior: 'smooth' })
  })
  newButton.addEventListener('click', () => {
    if (!form.hidden && !confirm('Ouvrir un nouveau formulaire ? Les modifications non enregistrées seront perdues.')) return
    editing = undefined; draftId = undefined; draftRevision = 0
    form.reset(); draftNote.value = ''; ownerInput.readOnly = false
    if (!teamAdmin) (form.elements.namedItem('email') as HTMLInputElement).value = accountEmail
    document.querySelector('#cm-form-title')!.textContent = teamAdmin ? 'Préparer un brouillon pour un formateur' : 'Nouvelle mission — aucun brouillon à reprendre'
    document.querySelector<HTMLButtonElement>('#cm-save-draft')!.hidden = false
    schools.replaceChildren(); add(); form.hidden = false
    form.scrollIntoView({ behavior: 'smooth' })
  })
  async function upload(id: string, kind: 'trainer_signed' | 'complete') {
    const input = document.createElement('input')
    input.type = 'file'; input.accept = 'application/pdf,.pdf'
    input.addEventListener('change', async () => {
      const file = input.files?.[0]
      if (!file) return
      if (file.size > 750_000) { message('PDF trop volumineux : 750 Ko maximum.'); return }
      if (!confirm(kind === 'complete' ? 'Avez-vous vérifié la signature du formateur et la contresignature EUNEOS sur ce PDF final ?' : 'Déposer le PDF signé pour vérification par EUNEOS ?')) return
      try {
        message('Dépôt en cours…')
        const response = await fetch(apiUrl(`id=${encodeURIComponent(id)}&kind=${kind}`), { method: 'PUT', headers: { 'Content-Type': 'application/pdf' }, body: file })
        const result = await response.json()
        if (!response.ok) throw new Error(result.error || 'Dépôt non confirmé.')
        await reload()
        message(`Document déposé et vérifié dans votre espace.${kind === 'trainer_signed' ? ` ${notificationMessage(result.notification)}` : ''}`)
      } catch (error) { message(error instanceof Error ? error.message : 'Dépôt non confirmé. Rechargez la page.') }
    })
    input.click()
  }
