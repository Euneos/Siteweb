      if (approved) card.append(link(record.id, 'approved', 'Télécharger le PDF validé'))
      if (data.team && record.state === 'trainer_signed') card.append(link(record.id, 'trainer_signed', 'Vérifier le PDF signé'))
      if (record.state === 'complete') card.append(link(record.id, 'complete', 'Télécharger l’exemplaire contresigné'))
      index.append(card)
    }
    // Les conventions reçues et leurs PDF passent avant les anciens brouillons.
    for (const card of index.querySelectorAll<HTMLElement>('[data-stage="draft"]')) index.append(card)
    applyFilters()
    message(`${data.conventions.length} convention(s) et ${(data.drafts || []).length} brouillon(s) dans cet espace.`)
    if (/^#(?:convention|brouillon)-[a-f0-9-]{36}$/.test(location.hash)) openPanel(location.hash.slice(1))
  }
  document.querySelector<HTMLButtonElement>('#cm-save-draft')!.addEventListener('click', async event => {
    if (teamAdmin && !ownerInput.reportValidity()) return
    const button = event.currentTarget as HTMLButtonElement
    button.disabled = true
    draftId ||= crypto.randomUUID()
    try {
      await send({ action: 'save-draft', id: draftId, revision: draftRevision, ownerEmail: teamAdmin ? ownerInput.value : undefined, payload: payload(), note: draftNote.value })
      const response = await fetch(endpoint)
      if (!response.ok) throw new Error('Relecture du brouillon impossible. Rechargez la page.')
      const data = await response.json()
      const saved = data.drafts.find((d: ListedDraft) => d.id === draftId)
      if (!saved) throw new Error('Brouillon non retrouvé. Rechargez la page.')
      edit(saved, true)
      await reload()
      message('Brouillon enregistré et relu. Il n’est pas encore soumis à EUNEOS. Cliquez sur « Vérifier la saisie » pour contrôler les champs et le calendrier, puis sur « Soumettre à la vérification EUNEOS » lorsque vous êtes prêt·e.')
    } catch (error) { message(error instanceof Error ? error.message : 'Enregistrement incertain. Rechargez la page avant tout nouvel envoi.') }
    finally { button.disabled = false }
  })
  form.addEventListener('submit', async event => {
    event.preventDefault()
    if (!valid()) return
    if (!confirm('Envoyer cette convention à EUNEOS pour vérification ?')) return
    const submit = document.querySelector<HTMLButtonElement>('#cm-submit')!
    submit.disabled = true
    try {
      const result = await send({ action: draftId ? 'submit-draft' : 'submit', id: draftId || editing, revision: draftRevision, ownerEmail: teamAdmin ? ownerInput.value : undefined, payload: payload() })
      editing = undefined
      draftId = undefined
      draftRevision = 0
      draftNote.value = ''
      document.querySelector<HTMLButtonElement>('#cm-save-draft')!.hidden = false
      form.reset()
      await reload()
      message(`${teamAdmin ? 'Convention enregistrée pour le compte formateur indiqué, en attente de validation EUNEOS.' : 'Convention reçue dans votre espace, en attente de vérification par EUNEOS.'} ${notificationMessage(result.notification)}`)
    } catch (error) { message(error instanceof Error ? error.message : 'Enregistrement incertain. Rechargez la page avant tout nouvel envoi.') }
    finally { submit.disabled = false }
  })
  reload().catch(error => message(error instanceof Error ? error.message : 'Service indisponible.'))
</script>
