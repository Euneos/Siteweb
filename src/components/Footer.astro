---
/**
 * Footer — identique sur les 4 pages (maquette v7).
 * Fond vert, silhouette en filigrane, newsletter avec segmentation en 3
 * (etablissement / formateur / partenaire — decision produit prise par le
 * design : c'est la donnee d'entree du portail de candidature), colonne de
 * contact, puis le mot « euneos » en geant et les liens legaux.
 */
import Brand from './Brand.astro'
---

<footer class="ftr s-vert">
  <div class="filigrane" aria-hidden="true">
    <div class="filigrane__fig"><Brand name="fig3" height="100%" /></div>
  </div>

  <div class="page ftr__in">
    <form class="ftr__news" id="newsletter" method="POST" action="/api/newsletter">
      <input class="form-trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <p class="ftr__lead">
        Rejoignez notre newsletter pour recevoir nos ressources et dernières actualités :
      </p>

      <div class="ftr__fields">
        <label class="sr-only" for="nl-nom">Nom et prénom</label>
        <input id="nl-nom" name="nom" type="text" placeholder="Nom/Prénom" autocomplete="name" maxlength="160" required />
        <label class="sr-only" for="nl-mail">Adresse e-mail</label>
        <input id="nl-mail" name="email" type="email" placeholder="Email" autocomplete="email" maxlength="254" required />
      </div>

      <fieldset class="ftr__radios">
        <legend class="sr-only">Vous êtes</legend>
        <label><input type="radio" name="profil" value="etablissement" checked /> <span>Je suis un établissement</span></label>
        <label><input type="radio" name="profil" value="formateur" /> <span>Je souhaite devenir formateur-ice</span></label>
        <label><input type="radio" name="profil" value="partenaire" /> <span>Je souhaite être partenaire</span></label>
      </fieldset>

      <p class="ftr__privacy">
        En envoyant ce formulaire, vous acceptez de recevoir la newsletter EUNEOS. Vous pourrez
        vous désinscrire à tout moment. <a href="/politique-de-confidentialite">En savoir plus</a>.
      </p>

      <p class="ftr__status" id="newsletter-status" aria-live="polite"></p>

      <button type="submit" class="ftr__submit">Envoyer</button>
    </form>

    <ul class="ftr__links">
      <li>
        <a href="/contact">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"
            ><rect x="2" y="5" width="20" height="14"></rect><path d="M2 6l10 7 10-7"></path></svg
          >
          Formulaire de contact
        </a>
      </li>
      <li>
        <a href="https://www.linkedin.com/company/euneos" rel="noopener noreferrer" target="_blank">
          <svg class="ftr__linkedin" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"
            ><path
              d="M5.1 3.5a2.3 2.3 0 110 4.6 2.3 2.3 0 010-4.6zM3 9.8h4.2V21H3V9.8zm6.8 0h4v1.5h.1c.6-1.1 1.9-1.9 4-1.9 4.2 0 5 2.8 5 6.3V21h-4.2v-4.7c0-1.1 0-2.6-1.6-2.6s-1.9 1.2-1.9 2.5V21H11V9.8z"
            ></path></svg
          >
          Suivez nos actualités sur Linkedin !
        </a>
      </li>
    </ul>
  </div>

  <div class="page ftr__mark" aria-hidden="true">
    <div class="ftr__mark-in"><Brand name="wordmark" /></div>
  </div>

  <div class="page ftr__legal">
    <a href="/mentions-legales">Mentions légales</a>
    <a href="/politique-de-confidentialite">Politique de confidentialité</a>
    <a href="/cookies">Cookies</a>
  </div>
</footer>

<script>
  const params = new URLSearchParams(window.location.search)
  const state = params.get('nl')
  const status = document.querySelector<HTMLElement>('#newsletter-status')
  // sur /newsletter, c'est la page qui affiche le resultat, pas le pied de page
  const pageDediee = document.querySelector('[data-newsletter-page]')

  if (state && status && !pageDediee) {
    const messages: Record<string, string> = {
      ok: 'Inscription confirmée. Bienvenue dans la newsletter EUNEOS.',
      confirmation: 'Vérifiez votre boîte e-mail et cliquez sur le lien reçu pour confirmer votre inscription.',
      confirme: 'Inscription confirmée. Bienvenue dans la newsletter EUNEOS.',
      erreur: 'Renseignez votre nom et votre adresse e-mail.',
      email: 'L’adresse e-mail ne semble pas valide.',
      profil: 'Choisissez le profil qui vous correspond.',
      indisponible: 'L’inscription est momentanément indisponible. Réessayez plus tard.',
      technique: 'Une erreur technique empêche l’inscription. Réessayez plus tard.',
    }
    status.textContent = messages[state] ?? 'Une erreur est survenue.'
    const success = ['ok', 'confirmation', 'confirme'].includes(state)
    status.classList.add(success ? 'is-ok' : 'is-error')
    if (!success) status.setAttribute('role', 'alert')
  }
</script>

<style>
  .ftr {
    position: relative;
    overflow: hidden;
    margin-top: var(--s-bloc);
    background: var(--surface);
    color: var(--on-surface);
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: 1.5rem;
  }
  .filigrane__fig {
    left: 34%;
  }
  .ftr__in {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
  }
  .ftr__lead {
    max-width: 26ch;
    margin-bottom: 1.1rem;
  }
  .ftr__fields {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .ftr__fields input {
    flex: 1 1 12rem;
    background: transparent;
    border: 1.5px solid color-mix(in srgb, currentColor 55%, transparent);
    color: inherit;
    padding: 0.6rem 0.8rem;
  }
  .ftr__fields input::placeholder {
    color: color-mix(in srgb, currentColor 60%, transparent);
  }
  .ftr__fields input:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 1px;
  }
  .ftr__radios {
    border: 0;
    padding: 0;
    margin: 0 0 1.25rem;
    display: grid;
    gap: 0.4rem;
  }
  .ftr__radios label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
  }
  .ftr__radios input {
    accent-color: var(--jaune);
    width: 1rem;
    height: 1rem;
  }
  .ftr__privacy {
    max-width: 42rem;
    margin: 0 0 1rem;
    font-size: var(--t-note);
    opacity: 0.85;
  }
  .ftr__privacy a {
    color: inherit;
  }
  .ftr__status:not(:empty) {
    margin: 0 0 1rem;
    padding: 0.75rem;
    border: 1.5px solid currentColor;
    font-weight: 600;
  }
  /* releve v4 : 121 x 57 px pour un libelle de 24 px — rectangle blanc, sans pli */
  .ftr__submit {
    background: var(--blanc);
    color: var(--vert);
    border: 0;
    font-weight: 600;
    line-height: 1.1;
    padding: 0.6em 0.6em;
    cursor: pointer;
  }
  .ftr__submit:hover {
    background: var(--jaune);
    color: var(--noir);
  }
  .ftr__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .ftr__links a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }
  .ftr__links a:hover {
    text-decoration: underline;
  }
  .ftr__links svg {
    width: 22px;
    height: 22px;
    flex: none;
  }
  .ftr__linkedin {
    overflow: visible;
  }
  .ftr__mark {
    position: relative;
    z-index: 1;
    margin-top: clamp(2rem, 6vw, 4.5rem);
  }
  .ftr__mark-in {
    width: 100%;
  }
  .ftr__legal {
    position: relative;
    z-index: 1;
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
    justify-content: flex-end;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }
  .ftr__legal a {
    text-decoration: none;
    opacity: 0.85;
  }
  .ftr__legal a:hover {
    opacity: 1;
    text-decoration: underline;
  }
  @media (max-width: 860px) {
    .ftr__in {
      grid-template-columns: 1fr;
    }
    .ftr__lead {
      max-width: none;
      font-size: 1rem;
    }
    .ftr__privacy {
      font-size: 0.72rem;
    }
    .ftr__legal {
      width: 100%;
      justify-content: space-between;
      flex-wrap: nowrap;
      gap: 0;
      font-size: 0.7rem;
      margin-top: 2.5rem;
    }
  }
</style>
