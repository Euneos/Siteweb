---
/**
 * Cta — etiquette a coin plie. « Style : Body SemiBold » (charte p.15).
 * Deux variantes : pleine et contour.
 */
import type { Surface } from './Paper.astro'

interface Props {
  href?: string
  newTab?: boolean
  surface?: Surface
  outline?: boolean
  /** Conserve le coin coupe sans dessiner le rabat. */
  fold?: boolean
  type?: 'button' | 'submit'
  class?: string
}

const { href, newTab, surface = 'vert', outline = false, fold = true, type, class: cls = '' } = Astro.props
const classes = ['cta', `s-${surface}`, outline ? 'cta-outline' : '', !fold ? 'cta--cut' : '', cls].filter(Boolean).join(' ')
const Tag = href ? 'a' : 'button'
const destination = href ? new URL(href, 'https://euneos.fr') : undefined
const external = destination && ['http:', 'https:'].includes(destination.protocol) &&
  destination.hostname !== 'euneos.fr' && !destination.hostname.endsWith('.euneos.fr')
---

<Tag class={classes} href={href} target={href && (newTab ?? external) ? '_blank' : undefined} rel={href && (newTab ?? external) ? 'noopener noreferrer' : undefined} type={href ? undefined : (type ?? 'button')}>
  <slot />
</Tag>
