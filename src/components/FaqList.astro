---
interface Props {
  questions: { id: string; q: string; paragraphes: string[] }[]
}
const { questions } = Astro.props
---
<div class="faq-list">
  {questions.map((item) => (
    <details class="faq-list__item" id={item.id}>
      <summary>{item.q}</summary>
      <div class="faq-list__answer">
        {item.paragraphes.map((p) => <p>{p}</p>)}
      </div>
    </details>
  ))}
</div>
<style>
  .faq-list__item { border-bottom: 1px solid var(--faq-rule, color-mix(in srgb, var(--noir) 14%, transparent)); padding: 1rem 0; }
  summary { cursor: pointer; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-size: 1.2em; line-height: 1; color: var(--faq-toggle, var(--vert)); flex: none; }
  details[open] summary::after { content: '–'; }
  .faq-list__answer p { margin-top: .75rem; max-width: 60ch; }
</style>
