---
import { dateFormationFr, trierProgression, type EtatCandidature } from '../lib/etat-candidatures'
import { statutCandidature } from '../lib/statut-candidature'
import { dateContactFr } from '../lib/dernier-contact'
import DetailSuivi from './DetailSuivi.astro'
interface Props { lignes: EtatCandidature[]; colonnes: string[]; recherche?: string; viewerEmail?: string }
const { lignes, colonnes, recherche = '', viewerEmail = '' } = Astro.props
const progressionAffichee = trierProgression(lignes.filter(l => !['Abandonne', 'Refuse'].includes(statutCandidature(l.statut).code ?? '')))
const etapes = [0, 2, 3, 4, 5, 7, 8, 9]
---

<details class="etat__progression" open>
  <summary>Tableau de suivi des établissements</summary>
  <p class="etat__legende">
    ✓ Information enregistrée · ◔ Avancement partiel · — Information non renseignée.
    Une case vide ne signifie pas que l’action n’a pas eu lieu.
    Les dates passées apparaissent d’abord, puis les débuts à venir, du plus proche au plus éloigné ;
    les dossiers sans date sont regroupés à la fin. Une date passée ne prouve pas le démarrage réel.
    Rouge : aucune affectation renseignée. Les personnes pressenties ne sont pas des affectations.
    Les abandons et refus sont exclus de ce tableau opérationnel.
  </p>
  <div class="etat__table-actions">
    <p class="etat__scroll-aide">Cliquez sur un établissement pour le détail. Faites défiler vers la droite pour les étapes ; le nom reste visible.</p>
    <button class="iw-button" type="button" data-suivi-expand hidden>Agrandir le tableau</button>
  </div>
  <details class="etat__legende"><summary>Comprendre le dernier contact et les informations manquantes</summary><p>
    Dernier contact / relance : dernier e-mail envoyé retrouvé dans la boîte de Charlotte,
    y compris les envois collectifs et les échanges avec les formateurs concernant le dossier.
    La date de vérification indique la dernière consultation de la messagerie, sans synchronisation automatique.
    « Voir le mail » ouvre le webmail de Charlotte ; un message déplacé peut nécessiter une nouvelle recherche.
    Blocage et aide nécessaire : non renseignés séparément dans le suivi actuel ; consultez le point de situation complet.
  </p></details>
  <label class="etat__filtre-rapide" hidden data-suivi-filter-label>
    Repérer les dossiers
    <select data-suivi-filter>
      <option value="tous">Tous les dossiers</option>
      <option value="sans-formateur">Sans affectation renseignée</option>
      <option value="organisation">Réception du formulaire à vérifier</option>
    </select>
  </label>
  <p data-suivi-count role="status" aria-live="polite"></p>
  <div data-suivi-inline>
  <div class="etat__table-wrap" tabindex="0" role="region" aria-label="Tableau des candidatures">
    <table class="etat__table">
      <caption>Progression des établissements — cohorte 2026–2027 · {progressionAffichee.length} dossiers actifs · tri par début de formation</caption>
      <colgroup>
        <col style="width:14rem" />
        <col style="width:14rem" />
        <col style="width:11rem" />
        <col style="width:11rem" />
        <col style="width:11rem" />
        <col style="width:12rem" />
        {etapes.map(() => <col style="width:10rem" />)}
      </colgroup>
      <thead>
        <tr>
          <th class="etat__etablissement" scope="col" rowspan="2">Établissement</th>
          <th scope="col" rowspan="2">Où en est-on ?</th>
          <th scope="col" rowspan="2">Blocage</th>
          <th scope="col" rowspan="2">Aide nécessaire</th>
          <th scope="col" rowspan="2">Référent</th>
          <th scope="col" rowspan="2">Formateur</th>
          <th scope="colgroup" colspan="3">Étape 1 — Candidature</th>
          <th scope="colgroup" colspan="2">Pièces d’engagement</th>
          <th scope="colgroup" colspan="3">Étapes 3 à 9 — Déploiement → Évaluation</th>
        </tr>
        <tr>{etapes.map(index => <th scope="col">{colonnes[index]}</th>)}</tr>
      </thead>
      <tbody>
        {progressionAffichee.length === 0 && <tr><td colspan="14">{recherche ? 'Aucun établissement ne correspond à cette recherche.' : 'Aucun dossier actif dans cette cohorte.'}</td></tr>}
        {progressionAffichee.map(ligne => (
          <tr data-suivi-row data-sans-formateur={!ligne.formateurs.length} data-organisation={!ligne.suiviVerifie?.organisationRecue} class:list={[ligne.aVerifier && 'is-a-verifier', statutCandidature(ligne.statut).code === 'Abandonne' && 'is-abandon']}>
            <th scope="row">
              <a class="etat__nom" href={`#dossier-${ligne.id}`} data-detail-open={`suivi-detail-${ligne.id}`} data-dossier-id={ligne.id}>{ligne.etablissement}</a>
              <span class="etat__meta">{[ligne.typeEtablissement, ligne.ville, ligne.region, ligne.code].filter(Boolean).join(' · ')}</span>
              <span class="etat__meta">Dernier contact : {ligne.dernierContact?.status === 'found' ? dateContactFr(ligne.dernierContact.sentAt!) : 'Non vérifié'}</span>
              <span class:list={['etat__debut', !ligne.dateDebutFormation && 'etat__sans-date']}>
                {ligne.dateDebutFormation ? `Début : ${dateFormationFr(ligne.dateDebutFormation)}` : '⚠ AUCUNE DATE DE DÉBUT RENSEIGNÉE'}
              </span>
              {ligne.dateDebutFormation && <small>{ligne.suiviVerifie?.qualification || (ligne.anomaliesDates.length ? 'à vérifier' : 'date renseignée · confirmation à vérifier')}</small>}
              {ligne.aVerifier && <span class="etat__verification">Dossier à rapprocher</span>}
            </th>
            <td class="etat__situation">
              <span class="etat__mobile-label">Où en est-on ?</span>
              <strong>{statutCandidature(ligne.statut).label}</strong>
              <small>{ligne.statutFormation || 'Avancement de formation non renseigné'}</small>
              <a href={`#dossier-${ligne.id}`} data-detail-open={`suivi-detail-${ligne.id}`} data-dossier-id={ligne.id}>Point de situation complet</a>
            </td>
            <td><span class="etat__mobile-label">Blocage</span><span>Non renseigné</span></td>
            <td><span class="etat__mobile-label">Aide nécessaire</span><span>Non renseignée</span></td>
            <td><span class="etat__mobile-label">Référent</span><span>{ligne.suiviVerifie?.referent || ligne.referent || 'Non renseigné'}</span></td>
            <td class:list={[!ligne.formateurs.length && 'etat__sans-affectation']}><span class="etat__mobile-label">Formateur</span><span>{ligne.formateurs.length ? ligne.formateurs.map(f => f.nom).join(' · ') : 'Aucune affectation renseignée'}</span></td>
            {etapes.map(index => { const cellule = ligne.progression[index]; return (
              <td class:list={['etat__centre', `etat__cellule--${cellule.etat}`]}>
                <span aria-hidden="true">{index === 7 ? (ligne.suiviVerifie?.organisationRecue ? '✓' : '—') : cellule.etat === 'fait' ? '✓' : cellule.etat === 'en-cours' ? '◔' : cellule.etat === 'abandon' ? '×' : '—'}</span>
                <span class="etat__mobile-label">{colonnes[index]}</span>
                <small>{index === 7 ? (ligne.suiviVerifie?.organisationRecue ? 'Formulaire reçu' : 'Réception non vérifiée')
                  : index === 8 ? (ligne.anomaliesDates.length ? 'Calendrier à vérifier' : ligne.statutFormation || 'Non renseigné')
                  : index === 9 ? (cellule.etat === 'fait' ? 'Suivi enregistré' : cellule.etat === 'en-cours' ? 'Suivi partiel' : 'Non renseigné')
                  : cellule.texte}</small>
                {index === 8 && ligne.dateFinFormation && <small>Fin prévue : {dateFormationFr(ligne.dateFinFormation)}</small>}
              </td>
            )})}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  </div>
  <dialog class="etat__plein-ecran" aria-labelledby="titre-suivi-agrandi">
    <header class="etat__table-actions">
      <h2 id="titre-suivi-agrandi">Suivi des établissements</h2>
      <button class="iw-button" type="button" data-suivi-close>Fermer la vue agrandie</button>
    </header>
    <p class="etat__legende">Tri par début de formation ; dossiers sans date à la fin. Rouge : aucune affectation renseignée. Appuyez sur Échap pour revenir à la page.</p>
    <div data-suivi-slot></div>
  </dialog>
  {progressionAffichee.map(ligne => <DetailSuivi ligne={ligne} viewerEmail={viewerEmail} />)}
</details>

<script>
  const filter = document.querySelector<HTMLSelectElement>('[data-suivi-filter]')
  const filterLabel = document.querySelector<HTMLElement>('[data-suivi-filter-label]')
  if (filter && filterLabel) {
    filterLabel.hidden = false
    filter.addEventListener('change', () => {
      const rows = [...document.querySelectorAll<HTMLElement>('[data-suivi-row]')]
      rows.forEach(row => { row.hidden = filter.value === 'sans-formateur' ? row.dataset.sansFormateur !== 'true' : filter.value === 'organisation' ? row.dataset.organisation !== 'true' : false })
      const count = document.querySelector('[data-suivi-count]')
      if (count) count.textContent = `${rows.filter(row => !row.hidden).length} dossier(s) affiché(s)`
    })
  }
  document.querySelectorAll<HTMLAnchorElement>('[data-detail-open]').forEach(link => {
    const detail = document.getElementById(link.dataset.detailOpen!) as HTMLDialogElement | null
    if (!detail || typeof detail.showModal !== 'function') return
    link.setAttribute('aria-haspopup', 'dialog')
    link.addEventListener('click', event => {
      event.preventDefault()
      const card = document.getElementById(`dossier-${link.dataset.dossierId}`)?.closest('.etat__dossier')
      const marker = document.createComment('Position de la fiche')
      if (card) { card.before(marker); detail.querySelector('[data-dossier-slot]')?.append(card) }
      detail.addEventListener('close', () => {
        if (card) marker.replaceWith(card)
        link.focus({ preventScroll: true })
      }, { once: true })
      detail.showModal()
    })
  })
  document.querySelectorAll('[data-detail-close]').forEach(button => button.addEventListener('click', () => button.closest('dialog')?.close()))
  const root = document.querySelector<HTMLElement>('.etat__progression')
  const trigger = root?.querySelector<HTMLButtonElement>('[data-suivi-expand]')
  const dialog = root?.querySelector<HTMLDialogElement>('.etat__plein-ecran')
  const inline = root?.querySelector<HTMLElement>('[data-suivi-inline]')
  const slot = dialog?.querySelector<HTMLElement>('[data-suivi-slot]')
  const table = inline?.querySelector<HTMLElement>('.etat__table-wrap')
  if (trigger && dialog && inline && slot && table && typeof dialog.showModal === 'function') {
    trigger.hidden = false
    trigger.addEventListener('click', () => {
      slot.append(table)
      dialog.showModal()
    })
    dialog.querySelector('[data-suivi-close]')?.addEventListener('click', () => dialog.close())
    dialog.addEventListener('close', () => {
      inline.append(table)
      trigger.focus()
    })
  }
</script>

<style is:global>
  .etat__debut { display: block; margin-block: .5rem; font-weight: 700; }
  .etat__sans-date { background: #fff3cc; color: #533b00; padding: .35rem; border-left: 3px solid #8a6100; }
  .etat__table td.etat__sans-affectation { background: #fff0f0; color: #a11919; font-weight: 700; }
  .etat__situation details { margin-block-start: .5rem; }
  .etat__situation ul { padding-inline-start: 1rem; }
  .etat__table-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block: 1rem;
  }
  .etat__plein-ecran {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1rem;
    border: 0;
    background: var(--papier);
    color: var(--vert);
    overflow: auto;
  }
  .etat__plein-ecran .etat__table-actions {
    margin-top: 0;
  }
  .etat__plein-ecran h2 {
    font-size: var(--t-carte);
  }
  .etat__plein-ecran::backdrop {
    background: var(--vert);
  }
  html:has(.etat__plein-ecran[open]) {
    overflow: hidden;
  }
  .etat__situation {
    line-height: 1.5;
  }
</style>
