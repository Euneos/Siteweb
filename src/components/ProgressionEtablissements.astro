---
import { dateFormationFr, etapeEnVert, trierProgression, type EtatCandidature } from '../lib/etat-candidatures'
import { statutCandidature } from '../lib/statut-candidature'
import { lienDernierContact, dateContactFr } from '../lib/dernier-contact'
import { pointSituation, situationCourante } from '../lib/point-situation'
interface Props { lignes: EtatCandidature[]; colonnes: string[]; recherche?: string; viewerEmail?: string }
const { lignes, colonnes, recherche = '', viewerEmail = '' } = Astro.props
const progressionAffichee = trierProgression(lignes.filter(l => !['Abandonne', 'Refuse'].includes(statutCandidature(l.statut).code ?? '')))
---

<details class="etat__progression" open>
  <summary>Tableau de suivi des établissements — les dix étapes</summary>
  <p class="etat__legende">
    ✓ Information enregistrée · ◔ Avancement partiel · — Information non renseignée.
    Une case vide ne signifie pas que l’action n’a pas eu lieu.
    Vert : pièce reçue ; lorsque la lettre signée et la fiche contact sont reçues,
    les six premières étapes sont colorées en vert. Ce repère visuel ne modifie pas
    la décision ni la preuve d’envoi d’un accusé de réception.
    Les dates passées apparaissent d’abord, puis les débuts à venir, du plus proche au plus éloigné ;
    les dossiers sans date sont regroupés à la fin. Une date passée ne prouve pas le démarrage réel.
    Rouge : aucune affectation renseignée. Les personnes pressenties ne sont pas des affectations.
    Les abandons et refus sont exclus de ce tableau opérationnel.
  </p>
  <div class="etat__table-actions">
    <p class="etat__scroll-aide">Toutes les colonnes sont visibles dans la largeur de l’écran sur ordinateur.</p>
    <button class="iw-button" type="button" data-suivi-expand hidden>Agrandir le tableau</button>
  </div>
  <p class="etat__legende">
    Dernier contact / relance : dernier e-mail envoyé retrouvé dans la boîte de Charlotte,
    y compris les envois collectifs et les échanges avec les formateurs concernant le dossier.
    La date de vérification indique la dernière consultation de la messagerie, sans synchronisation automatique.
    « Voir le mail » ouvre le webmail de Charlotte ; un message déplacé peut nécessiter une nouvelle recherche.
  </p>
  <div data-suivi-inline>
  <div class="etat__table-wrap" tabindex="0" role="region" aria-label="Tableau des candidatures">
    <table class="etat__table">
      <caption>Progression des établissements — cohorte 2026–2027 · {progressionAffichee.length} dossiers actifs · tri par début de formation</caption>
      <colgroup>
        <col style="width:12%" />
        <col style="width:15%" />
        <col style="width:13%" />
        {colonnes.map(() => <col style="width:6%" />)}
      </colgroup>
      <thead>
        <tr>
          <th class="etat__etablissement" scope="col" rowspan="2">Établissement</th>
          <th scope="col" rowspan="2">Point de situation</th>
          <th scope="col" rowspan="2">Dernier contact / relance</th>
          <th scope="colgroup" colspan="3">Étape 1 — Candidature</th>
          <th scope="colgroup" colspan="4">Étape 2 — Sélection & confirmation</th>
          <th scope="colgroup" colspan="3">Étapes 3 à 9 — Déploiement → Évaluation</th>
        </tr>
        <tr>{colonnes.map(titre => <th scope="col">{titre}</th>)}</tr>
      </thead>
      <tbody>
        {progressionAffichee.length === 0 && <tr><td colspan="13">{recherche ? 'Aucun établissement ne correspond à cette recherche.' : 'Aucun dossier actif dans cette cohorte.'}</td></tr>}
        {progressionAffichee.map(ligne => (
          <tr class:list={[ligne.aVerifier && 'is-a-verifier', statutCandidature(ligne.statut).code === 'Abandonne' && 'is-abandon']}>
            <th scope="row">
              <span class="etat__nom">{ligne.etablissement}</span>
              <span class="etat__meta">{[ligne.typeEtablissement, ligne.ville, ligne.region, ligne.code].filter(Boolean).join(' · ')}</span>
              <span class="etat__meta">{statutCandidature(ligne.statut).label}</span>
              <span class="etat__meta"><strong>Référent :</strong> {ligne.suiviVerifie?.referent || ligne.referent || 'Non renseigné'}</span>
              <span class:list={['etat__debut', !ligne.dateDebutFormation && 'etat__sans-date']}>
                {ligne.dateDebutFormation ? `Début : ${dateFormationFr(ligne.dateDebutFormation)}` : '⚠ AUCUNE DATE DE DÉBUT RENSEIGNÉE'}
              </span>
              {ligne.dateDebutFormation && <small>{ligne.suiviVerifie?.qualification || (ligne.anomaliesDates.length ? 'à vérifier' : 'date renseignée · confirmation à vérifier')}</small>}
              {ligne.aVerifier && <span class="etat__verification">Dossier à rapprocher</span>}
            </th>
            <td class="etat__situation">
              <span class="etat__mobile-label">Point de situation</span>
              <span>{ligne.suiviVerifie?.situation || pointSituation(ligne)}</span>
              {ligne.suiviVerifie ? <>
                <small>Vérification croisée le {dateContactFr(ligne.suiviVerifie.checkedAt)}</small>
                <details><summary>Sources de vérification</summary><ul>{ligne.suiviVerifie.sources.map(source => <li>{source}</li>)}</ul></details>
              </> : situationCourante(ligne) && <small>
                {situationCourante(ligne)!.sourceKind === 'echange-interne' ? 'Point interne du ' : 'Mail envoyé le '}
                {dateContactFr(situationCourante(ligne)!.sourceAt)}
              </small>}
            </td>
            <td class="etat__dernier-contact">
              <span class="etat__mobile-label">Dernier contact / relance</span>
              {ligne.dernierContact?.status === 'found' ? (
                <>
                  <time datetime={ligne.dernierContact.sentAt}>{dateContactFr(ligne.dernierContact.sentAt!)}</time>
                  <small>{ligne.dernierContact.via === 'formateur' ? 'Échange avec le formateur' : ligne.dernierContact.via === 'collectif' ? 'Envoi collectif' : 'E-mail à l’établissement'}</small>
                  <small>{ligne.dernierContact.subject}</small>
                  {lienDernierContact(ligne.dernierContact, viewerEmail) ? (
                    <a href={lienDernierContact(ligne.dernierContact, viewerEmail)!} target="_blank" rel="noopener noreferrer">Voir le mail</a>
                  ) : <small>Message dans la boîte de Charlotte</small>}
                </>
              ) : (
                <span>{ligne.dernierContact?.status === 'ambiguous' ? 'À vérifier : contact partagé entre établissements' : ligne.dernierContact?.status === 'not_found' ? 'Aucun envoi retrouvé' : 'Messagerie non vérifiée'}</span>
              )}
              {ligne.dernierContact && <small>Vérifié le {dateContactFr(ligne.dernierContact.checkedAt)}</small>}
            </td>
            {ligne.progression.map((cellule, index) => (
              <td class:list={['etat__centre', `etat__cellule--${cellule.etat}`, etapeEnVert(ligne, index) && !(index === 8 && ligne.anomaliesDates.length) && 'etat__piece-recue', index === 6 && !ligne.formateurs.length && 'etat__sans-affectation']}>
                <span aria-hidden="true">{index === 7 ? (ligne.suiviVerifie?.organisationRecue ? '✓' : '—') : cellule.etat === 'fait' ? '✓' : cellule.etat === 'en-cours' ? '◔' : cellule.etat === 'abandon' ? '×' : '—'}</span>
                <span class="etat__mobile-label">{colonnes[index]}</span>
                <small>{index === 6 && ligne.formateurs.length
                  ? ligne.formateurs.map(formateur => formateur.nom).join(' · ')
                  : index === 6 ? 'AUCUNE AFFECTATION RENSEIGNÉE'
                  : index === 7 ? (ligne.suiviVerifie?.organisation || 'Réception du questionnaire non vérifiée')
                  : index === 8 && ligne.statutFormation?.trim().toLocaleLowerCase('fr') === 'en cours' ? 'Formation en cours'
                  : index === 8 && ligne.anomaliesDates.length ? 'Calendrier à vérifier — voir le point de situation'
                  : cellule.texte}</small>
                {index === 8 && ligne.suiviVerifie?.formationPrecision && <small>{ligne.suiviVerifie.formationPrecision}</small>}
                {index === 8 && ligne.dateFinFormation && <small>Fin prévue : {dateFormationFr(ligne.dateFinFormation)}</small>}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  </div>
  <dialog class="etat__plein-ecran" aria-labelledby="titre-suivi-agrandi">
    <header class="etat__table-actions">
      <h2 id="titre-suivi-agrandi">Suivi des établissements</h2>
      <button class="iw-button" type="button" data-suivi-close>Fermer la vue agrandie</button>
    </header>
    <p class="etat__legende">Tri par début de formation ; dossiers sans date à la fin. Rouge : aucune affectation renseignée. Appuyez sur Échap pour revenir à la page.</p>
    <div data-suivi-slot></div>
  </dialog>
</details>

<script>
  const root = document.querySelector<HTMLElement>('.etat__progression')
  const trigger = root?.querySelector<HTMLButtonElement>('[data-suivi-expand]')
  const dialog = root?.querySelector<HTMLDialogElement>('.etat__plein-ecran')
  const inline = root?.querySelector<HTMLElement>('[data-suivi-inline]')
  const slot = dialog?.querySelector<HTMLElement>('[data-suivi-slot]')
  const table = inline?.querySelector<HTMLElement>('.etat__table-wrap')
  if (trigger && dialog && inline && slot && table && typeof dialog.showModal === 'function') {
    trigger.hidden = false
    trigger.addEventListener('click', () => {
      slot.append(table)
      dialog.showModal()
    })
    dialog.querySelector('[data-suivi-close]')?.addEventListener('click', () => dialog.close())
    dialog.addEventListener('close', () => {
      inline.append(table)
      trigger.focus()
    })
  }
</script>

<style is:global>
  .etat__debut { display: block; margin-block: .5rem; font-weight: 700; }
  .etat__sans-date { background: #fff3cc; color: #533b00; padding: .35rem; border-left: 3px solid #8a6100; }
  .etat__table td.etat__sans-affectation { background: #fff0f0; color: #a11919; font-weight: 700; }
  .etat__situation details { margin-block-start: .5rem; }
  .etat__situation ul { padding-inline-start: 1rem; }
  .etat__table-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block: 1rem;
  }
  .etat__plein-ecran {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1rem;
    border: 0;
    background: var(--papier);
    color: var(--vert);
    overflow: auto;
  }
  .etat__plein-ecran .etat__table-actions {
    margin-top: 0;
  }
  .etat__plein-ecran h2 {
    font-size: var(--t-carte);
  }
  .etat__plein-ecran::backdrop {
    background: var(--vert);
  }
  html:has(.etat__plein-ecran[open]) {
    overflow: hidden;
  }
  .etat__situation {
    line-height: 1.5;
  }
</style>
