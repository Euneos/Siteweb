---
/**
 * Portail de candidature — gabarit partage par les deux routes
 * (« Je suis un etablissement » et « Je souhaite devenir formateur·rice »).
 *
 * Remplace les Google Forms : les reponses partent directement dans NocoDB.
 *
 * IMPORTANT — les questions, leur ordre, leur libelle et leurs choix sont
 * repris a l'identique des deux Google Forms d'origine, releves le 28/08/2026
 * sur les formulaires en ligne. Candice a demande le 27/08 que les deux
 * versions soient identiques : ne rien reformuler ici sans le lui demander.
 *
 * Principe repris du systeme d'Elsa, volontairement conserve : AUCUN email
 * automatique vers l'exterieur. La candidature est enregistree et l'equipe
 * la traite ; l'accuse de reception part quand elle passe le statut.
 */
import Paper from './Paper.astro'

export interface Champ {
  id: string
  label: string
  /** `section` ouvre un bloc ; `consentement` est la case unique de fin. */
  type?:
    | 'text' | 'email' | 'tel' | 'url' | 'textarea' | 'select'
    | 'radio' | 'checkbox' | 'section' | 'consentement'
  requis?: boolean
  autocomplete?: string
  options?: readonly string[]
  aide?: string
  large?: boolean
}

interface Props {
  titre: string
  chapo: string
  action: string
  champs: readonly Champ[]
  ok?: string | null
  erreur?: string | null
  manquants?: string | null
}

const { titre, chapo, action, champs, ok, erreur, manquants } = Astro.props
const absents = (manquants ?? '').split(',').filter(Boolean)

const MESSAGES: Record<string, string> = {
  champs: 'Il manque des informations obligatoires.',
  email: 'L’adresse e-mail ne semble pas valide.',
  consentement: 'Vous devez confirmer l’autorisation de recontact pour envoyer la candidature.',
  indisponible:
    'Le service d’enregistrement est momentanément indisponible. Votre candidature n’a pas été enregistrée — merci de réessayer dans quelques minutes ou de nous écrire à contact@euneos.fr.',
  technique:
    'Une erreur technique est survenue. Votre candidature n’a pas été enregistrée — merci de réessayer ou de nous écrire à contact@euneos.fr.',
}

/** Les listes de choix et les zones de texte prennent toute la largeur. */
const pleineLargeur = (c: Champ) =>
  c.large ||
  c.type === 'section' ||
  c.type === 'textarea' ||
  c.type === 'radio' ||
  c.type === 'checkbox' ||
  c.type === 'consentement'
---

<section class="section cand">
  <div class="page">
    <Paper outline fold="tr" foldSize="clamp(3rem, 7vw, 7rem)" class="cand__panel">
      <h1>{titre}</h1>
      <p class="cand__chapo" set:html={chapo} />

      {
        ok && (
          <p class="cand__ok" role="status">
            <strong>Candidature bien reçue.</strong> Notre équipe l’étudie et revient vers vous dans
            les prochaines semaines. Vous ne recevrez pas d’e-mail automatique : c’est une personne
            qui vous répondra.
          </p>
        )
      }
      {
        erreur && (
          <p class="cand__err" role="alert">
            {MESSAGES[erreur] ?? 'Une erreur est survenue.'}
            {absents.length > 0 && <> Champs manquants : {absents.join(', ')}.</>}
          </p>
        )
      }

      <form class="cand__form" id="cand-form" method="POST" action={action}>
        {
          champs.map((c) =>
            c.type === 'section' ? (
              <div class="cand__section">
                <h2>{c.label}</h2>
                {c.aide && <p>{c.aide}</p>}
              </div>
            ) : c.type === 'radio' || c.type === 'checkbox' ? (
              <fieldset class="cand__row cand__row--large cand__choix">
                <legend>
                  {c.label}
                  {c.requis && <abbr title="obligatoire">&nbsp;*</abbr>}
                </legend>
                {c.aide && <span class="cand__aide">{c.aide}</span>}
                <ul>
                  {(c.options ?? []).map((o, i) => (
                    <li>
                      <label>
                        <input
                          type={c.type === 'checkbox' ? 'checkbox' : 'radio'}
                          name={c.id}
                          value={o}
                          required={c.requis && c.type === 'radio' && i === 0}
                        />
                        <span>{o}</span>
                      </label>
                    </li>
                  ))}
                </ul>
              </fieldset>
            ) : c.type === 'consentement' ? (
              <p class="cand__row cand__row--large cand__consent">
                <label>
                  <input type="checkbox" name={c.id} value="Oui, je confirme" required />
                  <span>
                    {c.label}
                    <abbr title="obligatoire">&nbsp;*</abbr>
                  </span>
                </label>
              </p>
            ) : (
              <p class:list={['cand__row', pleineLargeur(c) && 'cand__row--large']}>
                <label for={c.id}>
                  {c.label}
                  {c.requis && <abbr title="obligatoire">&nbsp;*</abbr>}
                </label>
                <span
                  class:list={[
                    'cand__field',
                    'paper',
                    'fold-br',
                    c.type === 'textarea' && 'cand__field--area',
                  ]}
                >
                  {c.type === 'textarea' ? (
                    <textarea id={c.id} name={c.id} rows="5" required={c.requis} />
                  ) : c.type === 'select' ? (
                    <select id={c.id} name={c.id} required={c.requis}>
                      <option value="">— choisir —</option>
                      {(c.options ?? []).map((o) => (
                        <option value={o}>{o}</option>
                      ))}
                    </select>
                  ) : (
                    <input
                      id={c.id}
                      name={c.id}
                      type={c.type === 'url' ? 'url' : (c.type ?? 'text')}
                      autocomplete={c.autocomplete}
                      required={c.requis}
                    />
                  )}
                </span>
                {c.aide && <span class="cand__aide">{c.aide}</span>}
              </p>
            )
          )
        }
        <p class="cand__legal">
          Les informations recueillies servent uniquement à instruire votre candidature au Programme
          WISE-UP. Elles ne sont ni cédées ni revendues. Vous pouvez demander leur suppression à
          <a href="mailto:contact@euneos.fr">contact@euneos.fr</a>.
        </p>
      </form>

      <div class="cand__submit">
        <button type="submit" form="cand-form" class="cta s-papier">Envoyer ma candidature</button>
      </div>
    </Paper>
  </div>
</section>
