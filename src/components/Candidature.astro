---
/**
 * Portail de candidature — gabarit partage par les deux routes
 * (« Je suis un etablissement » et « Je souhaite devenir formateur·rice »).
 *
 * Remplace les Google Forms : les reponses partent directement dans NocoDB.
 *
 * IMPORTANT — les questions, leur ordre, leur libelle et leurs choix sont
 * repris a l'identique des deux Google Forms d'origine, releves le 28/08/2026
 * sur les formulaires en ligne. Candice a demande le 27/08 que les deux
 * versions soient identiques : ne rien reformuler ici sans le lui demander.
 *
 * Un accuse de reception Brevo est envoye apres l'enregistrement, conformement
 * a la decision client du 27/08. La decision de fond reste humaine : l'equipe
 * etudie la candidature et repond lorsqu'elle fait avancer son statut.
 */
import Paper from './Paper.astro'

export interface Champ {
  id: string
  label: string
  /** `section` ouvre un bloc ; `consentement` est la case unique de fin. */
  type?:
    | 'text' | 'email' | 'tel' | 'url' | 'textarea' | 'select'
    | 'radio' | 'checkbox' | 'section' | 'consentement'
  requis?: boolean
  autocomplete?: string
  options?: readonly string[]
  aide?: string
  large?: boolean
}

interface Props {
  titre: string
  chapo: string
  action: string
  champs: readonly Champ[]
  ok?: string | null
  emailEnvoye?: string | null
  erreur?: string | null
  manquants?: string | null
}

const { titre, chapo, action, champs, ok, emailEnvoye, erreur, manquants } = Astro.props
const absents = (manquants ?? '').split(',').filter(Boolean)
const libelles = Object.fromEntries(champs.map((c) => [c.id, c.label]))

const MESSAGES: Record<string, string> = {
  champs: 'Il manque des informations obligatoires.',
  email: 'L’adresse e-mail ne semble pas valide.',
  consentement: 'Vous devez confirmer l’autorisation de recontact pour envoyer la candidature.',
  indisponible:
    'Le service d’enregistrement est momentanément indisponible. Votre candidature n’a pas été enregistrée — merci de réessayer dans quelques minutes ou de nous écrire à contact@euneos.fr.',
  technique:
    'Une erreur technique est survenue. Votre candidature n’a pas été enregistrée — merci de réessayer ou de nous écrire à contact@euneos.fr.',
}

/** Les listes de choix et les zones de texte prennent toute la largeur. */
const pleineLargeur = (c: Champ) =>
  c.large ||
  c.type === 'section' ||
  c.type === 'textarea' ||
  c.type === 'radio' ||
  c.type === 'checkbox' ||
  c.type === 'consentement'
---

<section class="section cand" data-form-action={action}>
  <div class="page">
    <Paper outline fold="tr" foldSize="clamp(3rem, 7vw, 7rem)" class="cand__panel">
      <h1>{titre}</h1>
      <p class="cand__chapo" set:html={chapo} />

      {
        ok && (
          <p class="cand__ok" role="status">
            <strong>Candidature bien reçue.</strong> Notre équipe l’étudie et revient vers vous dans
            les prochaines semaines. {emailEnvoye
              ? 'Un accusé de réception vient de vous être envoyé par e-mail.'
              : 'Une personne de l’équipe vous répondra.'}
          </p>
        )
      }
      {
        erreur && (
          <p class="cand__err" role="alert">
            {MESSAGES[erreur] ?? 'Une erreur est survenue.'}
            {absents.length > 0 && <> Champs manquants : {absents.map((id) => libelles[id] ?? id).join(', ')}.</>}
          </p>
        )
      }

      {!ok && <form class="cand__form" id="cand-form" method="POST" action={action}>
        <input class="form-trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        {
          champs.map((c) =>
            c.type === 'section' ? (
              <div class="cand__section">
                <h2>{c.label}</h2>
                {c.aide && <p>{c.aide}</p>}
              </div>
            ) : c.type === 'radio' || c.type === 'checkbox' ? (
              <fieldset class="cand__row cand__row--large cand__choix">
                <legend>
                  {c.label}
                  {c.requis && <abbr title="obligatoire">&nbsp;*</abbr>}
                </legend>
                {c.aide && <span class="cand__aide">{c.aide}</span>}
                <ul>
                  {(c.options ?? []).map((o, i) => (
                    <li>
                      <label>
                        <input
                          type={c.type === 'checkbox' ? 'checkbox' : 'radio'}
                          name={c.id}
                          value={o}
                          required={c.requis && c.type === 'radio' && i === 0}
                        />
                        <span>{o}</span>
                      </label>
                    </li>
                  ))}
                </ul>
              </fieldset>
            ) : c.type === 'consentement' ? (
              <p class="cand__row cand__row--large cand__consent">
                <label>
                  <input type="checkbox" name={c.id} value="Oui, je confirme" required />
                  <span>
                    {c.label}
                    <abbr title="obligatoire">&nbsp;*</abbr>
                  </span>
                </label>
              </p>
            ) : (
              <p class:list={['cand__row', pleineLargeur(c) && 'cand__row--large']}>
                <label for={c.id}>
                  {c.label}
                  {c.requis && <abbr title="obligatoire">&nbsp;*</abbr>}
                </label>
                <span class="champ">
                  {c.type === 'textarea' ? (
                    <textarea id={c.id} name={c.id} rows="5" maxlength="5000" required={c.requis} />
                  ) : c.type === 'select' ? (
                    <select id={c.id} name={c.id} required={c.requis}>
                      <option value="">— choisir —</option>
                      {(c.options ?? []).map((o) => (
                        <option value={o}>{o}</option>
                      ))}
                    </select>
                  ) : (
                    <input
                      id={c.id}
                      name={c.id}
                      type={c.type === 'url' ? 'url' : (c.type ?? 'text')}
                      autocomplete={c.autocomplete}
                      maxlength={c.type === 'email' ? 254 : c.type === 'url' ? 2000 : c.type === 'tel' ? 50 : 500}
                      required={c.requis}
                    />
                  )}
                </span>
                {c.aide && <span class="cand__aide">{c.aide}</span>}
              </p>
            )
          )
        }
        <p class="cand__legal">
          Les informations recueillies servent uniquement à instruire votre candidature au Programme
          WISE-UP. Elles ne sont ni cédées ni revendues. Vous pouvez demander leur suppression à
          <a href="mailto:contact@euneos.fr">contact@euneos.fr</a>.
        </p>
      </form>}

      {
        !ok && (
          <div class="cand__submit">
            <button type="submit" form="cand-form" class="cta s-papier">Envoyer ma candidature</button>
          </div>
        )
      }
    </Paper>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.cand[data-form-action]')
  const form = document.querySelector<HTMLFormElement>('#cand-form')
  const action = root?.dataset.formAction
  const storageKey = action ? `euneos-candidature:${new URL(action, window.location.origin).href}` : null
  const params = new URLSearchParams(window.location.search)

  if (storageKey && params.has('ok')) sessionStorage.removeItem(storageKey)

  if (form && storageKey) {
    if (params.has('erreur')) {
      try {
        const values = JSON.parse(sessionStorage.getItem(storageKey) ?? '{}') as Record<string, string[]>
        for (const [name, saved] of Object.entries(values)) {
          const controls = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
            `[name="${CSS.escape(name)}"]`,
          )
          controls.forEach((control) => {
            if (control instanceof HTMLInputElement && (control.type === 'checkbox' || control.type === 'radio')) {
              control.checked = saved.includes(control.value)
            } else {
              control.value = saved[0] ?? ''
            }
          })
        }
      } catch {
        sessionStorage.removeItem(storageKey)
      }
    }

    const checkboxGroups = [...form.querySelectorAll<HTMLFieldSetElement>('.cand__choix')].filter(
      (fieldset) => fieldset.querySelector('input[type="checkbox"]')?.closest('fieldset') === fieldset,
    )

    const validateCheckboxGroup = (fieldset: HTMLFieldSetElement) => {
      const boxes = [...fieldset.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')]
      const first = boxes[0]
      if (!first || !fieldset.querySelector('abbr[title="obligatoire"]')) return true
      const valid = boxes.some((box) => box.checked)
      first.setCustomValidity(valid ? '' : 'Sélectionnez au moins une réponse.')
      return valid
    }

    checkboxGroups.forEach((fieldset) => {
      fieldset.addEventListener('change', () => validateCheckboxGroup(fieldset))
    })

    form.addEventListener('submit', (event) => {
      const invalidGroup = checkboxGroups.find((fieldset) => !validateCheckboxGroup(fieldset))
      if (invalidGroup) {
        event.preventDefault()
        const first = invalidGroup.querySelector<HTMLInputElement>('input[type="checkbox"]')
        first?.reportValidity()
        first?.focus()
        return
      }

      const values: Record<string, string[]> = {}
      for (const [name, value] of new FormData(form)) {
        if (typeof value !== 'string') continue
        values[name] ??= []
        values[name].push(value)
      }
      sessionStorage.setItem(storageKey, JSON.stringify(values))
    })
  }
</script>
