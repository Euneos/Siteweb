---
/**
 * Header — commun aux 4 pages (structure du docx client).
 * Logo cliquable a gauche, menu a droite. Transparent : il herite de la
 * couleur du hero (vert sur 3 pages, bleu sur la page Programme).
 *
 * NB : sur les maquettes des pages « Qui sommes-nous ? » et « Nous contacter »,
 * l'entree surlignee restait « Notre Programme ». Corrige ici : l'etat actif
 * suit la page courante (et porte aria-current).
 */
import Brand from './Brand.astro'

const nav = [
  { href: '/', label: 'Bienvenue' },
  { href: '/programme', label: 'Notre Programme' },
  { href: '/qui-sommes-nous', label: 'Qui sommes-nous ?' },
  { href: '/contact', label: 'Nous contacter' },
]

const path = Astro.url.pathname.replace(/\/+$/, '') || '/'
---

<header class="hdr">
  <div class="page hdr__in">
    <a href="/" class="hdr__logo" aria-label="Euneos — accueil">
      <Brand name="wordmark" height="2rem" />
    </a>

    <button type="button" class="hdr__burger" aria-expanded="false" aria-controls="menu-principal">
      <span class="sr-only">Ouvrir le menu</span>
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>

    <nav class="hdr__nav" id="menu-principal" aria-label="Navigation principale">
      {
        nav.map((item) => {
          const active = path === item.href
          return (
            <a href={item.href} class:list={['hdr__link', active && 'is-active']} aria-current={active ? 'page' : undefined}>
              {item.label}
            </a>
          )
        })
      }
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.hdr__burger')
  const menu = document.querySelector<HTMLElement>('#menu-principal')

  const fermer = () => {
    if (!button || !menu) return
    button.setAttribute('aria-expanded', 'false')
    button.querySelector('.sr-only')!.textContent = 'Ouvrir le menu'
    menu.classList.remove('is-open')
  }

  button?.addEventListener('click', () => {
    if (!menu) return
    const ouvert = button.getAttribute('aria-expanded') === 'true'
    button.setAttribute('aria-expanded', String(!ouvert))
    button.querySelector('.sr-only')!.textContent = ouvert ? 'Ouvrir le menu' : 'Fermer le menu'
    menu.classList.toggle('is-open', !ouvert)
  })
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', fermer))
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      fermer()
      button.focus()
    }
  })
</script>

<style>
  .hdr {
    position: relative;
    z-index: 10;
    padding-block: clamp(1.25rem, 2.6vw, 2rem);
  }
  .hdr__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .hdr__logo {
    display: block;
    flex: none;
    color: color-mix(in srgb, currentColor 82%, transparent);
  }
  .hdr__logo:hover {
    color: currentColor;
  }
  .hdr__nav {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2.25rem);
    align-items: baseline;
  }
  /* Maquette : les entrees inactives sont en teinte claire, l'active en blanc.
     Pas de soulignement (l'etat actif se lit a la couleur et a la graisse). */
  .hdr__link {
    text-decoration: none;
    font-size: 1rem;
    color: color-mix(in srgb, currentColor 75%, transparent);
    padding-block: 0.25rem;
  }
  .hdr__link:hover {
    color: currentColor;
  }
  .hdr__link.is-active {
    color: currentColor;
    font-weight: 600;
  }
  .hdr__burger {
    display: none;
    color: inherit;
    background: transparent;
    border: 0;
  }
  .hdr__burger:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media (max-width: 860px) {
    .hdr__burger {
      display: grid;
      gap: 5px;
      cursor: pointer;
      padding: 0.5rem;
      margin-right: -0.5rem;
    }
    .hdr__burger > span:not(.sr-only) {
      display: block;
      width: 26px;
      height: 2px;
      background: currentColor;
    }
    .hdr__nav {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      flex-direction: column;
      gap: 0;
      background: var(--surface);
      padding: 0.5rem 0;
      display: none;
    }
    .hdr__nav.is-open {
      display: flex;
    }
    .hdr__link {
      padding: 0.85rem clamp(1rem, 4vw, 2rem);
      border-bottom: none;
    }
    .hdr__link.is-active {
      border-bottom: none;
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }
</style>
