---
/**
 * Photo — emplacement photographique.
 * Direction imposee par la charte p.18 : « Humaine · Authentique · Lumineuse ·
 * Saturation douce · Couleurs naturelles » et trois interdits : « pas de photos
 * studio · pas de detourage · pas de pose ».
 *
 * Par defaut le composant affiche la photo de la maquette, pour que le rendu
 * ressemble a ce que Candice a valide. Elle est en 816 x 552 : suffisant pour la
 * demo, insuffisant pour la production — il faudra les originaux du client (et
 * verifier la licence de celle-ci).
 * Passer `src` pour une autre image, ou `empty` pour revenir au cadre vide.
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import jeunes from '../assets/photos/jeunes.jpg'

interface Props {
  src?: ImageMetadata
  alt?: string
  /** ratio du cadre, ex '3/4' (format A portrait) ou '4/3' */
  ratio?: string
  class?: string
  label?: string
  /** true = cadre vide (aucune photo) */
  empty?: boolean
}

const {
  src,
  alt = 'Trois adolescentes rient, bras dessus bras dessous, en extérieur',
  ratio = '4/3',
  class: cls = '',
  label = 'photo',
  empty = false,
} = Astro.props

const image = src ?? jeunes
---

{
  empty ? (
    <div
      class:list={['ph', 'ph--empty', cls]}
      style={`aspect-ratio:${ratio}`}
      role="img"
      aria-label={`Emplacement ${label}`}
    >
      <span>{label}</span>
    </div>
  ) : (
    <div class:list={['ph', cls]} style={`aspect-ratio:${ratio}`}>
      <Image src={image} alt={alt} widths={[480, 816]} sizes="(max-width: 860px) 100vw, 50vw" loading="lazy" decoding="async" />
    </div>
  )
}

<style>
  .ph {
    width: 100%;
    overflow: hidden;
    background: var(--vert-clair);
  }
  .ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ph--empty {
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(
        135deg,
        color-mix(in srgb, var(--vert-clair) 55%, transparent) 0 2px,
        transparent 2px 9px
      ),
      var(--vert-clair);
    color: var(--vert);
  }
  .ph--empty span {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
  }
</style>
