---
import { Image } from 'astro:assets'
import unionEuropeenne from '../assets/logos/cofinance-union-europeenne.png'
import nouveauMonde from '../assets/logos/nouveau-monde.png'

const logos = [
  { src: unionEuropeenne, alt: 'Cofinancé par l’Union européenne', href: undefined },
  { src: nouveauMonde, alt: 'Nouveau Monde — Fonds de dotation', href: 'https://www.fonds-nouveau-monde.org/' },
]
---

  <section class="section confiance" data-section="soutiens">
    <div class="page">
      <h2 class="confiance__t">Merci pour leur soutien</h2>
      <ul class="confiance__logos">
        {logos.map((logo) => {
          const LogoContainer = logo.href ? 'a' : 'div'
          return (
          <li>
            <LogoContainer href={logo.href} class="confiance__logo" target={logo.href ? '_blank' : undefined} rel={logo.href ? 'noopener noreferrer' : undefined}>
            <Image src={logo.src} alt={logo.alt} width={640} widths={[320, 640]} sizes="(max-width: 700px) 43vw, 300px" format="png" loading="lazy" />
            </LogoContainer>
          </li>
        )})}
      </ul>
    </div>
  </section>

<style>
  /* --- CONFIANCE --- */
  .confiance__t {
    text-align: center;
  }
  .confiance__logos {
    list-style: none;
    padding: 0;
    margin: var(--s-titre) auto 0;
    max-width: 42rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: clamp(1rem, 4vw, 4.5rem);
  }
  .confiance__logos li {
    min-width: 0;
    max-width: 300px;
    width: 100%;
    justify-self: center;
  }
  .confiance__logo { display: block; }
  a.confiance__logo:focus-visible { outline: 3px solid var(--vert); outline-offset: 6px; }
  .confiance__logos :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

</style>
