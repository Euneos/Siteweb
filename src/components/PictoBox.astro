---
/**
 * PictoBox — le petit cartouche de couleur a picto blanc, pose en debord d'une
 * photo ou en tete de carte. Present partout dans la maquette.
 *
 * Attention : un padding en % se resout sur la largeur du CONTENEUR, pas sur
 * celle de la boite. La taille est donc passee en variable CSS et le padding
 * calcule a partir d'elle.
 */
import Brand from './Brand.astro'
import type { BrandName } from './Brand.astro'
import type { Surface } from './Paper.astro'

interface Props {
  picto: BrandName
  surface?: Surface
  /** largeur du cartouche ; la hauteur suit le format A.
      'sm' (92 px) · 'md' (108 px) · 'lg' (180 px) : les trois calibres releves
      dans la maquette v4, definis dans global.css (--pbox-*). Une longueur CSS
      reste acceptee pour un cas particulier. */
  size?: 'sm' | 'md' | 'lg' | string
  /** coin plie, comme le cartouche rose de la page d'accueil */
  fold?: boolean
  /** couleur du rabat : la maquette ne prend PAS toujours la variante foncee de
      la teinte du bloc (le cartouche rose du bloc image a un rabat #DD83DA) */
  foldColor?: string
  /** format A en paysage (le cartouche orange du bloc image : 59,1 x 41,8 pt) */
  paysage?: boolean
  class?: string
}

const { picto, surface = 'jaune', size = 'md', fold = false, foldColor, paysage = false, class: cls } = Astro.props
const CALIBRES: Record<string, string> = { sm: 'var(--pbox-sm)', md: 'var(--pbox-md)', lg: 'var(--pbox-lg)' }
const largeur = CALIBRES[size] ?? size
---

<div
  class:list={['pbox', `s-${surface}`, paysage && 'pbox--paysage', fold && 'paper fold-br', cls]}
  style={[
    `--pbox:${largeur}`,
    fold ? '--f:calc(var(--pbox) * 0.28)' : '',
    foldColor ? `--fold-color:${foldColor}` : '',
  ]
    .filter(Boolean)
    .join(';')}
>
  <div class="pbox__in"><Brand name={picto} /></div>
</div>

<style>
  /* Releve au vecteur : les cartouches font 71,9 x 100,3 pt en portrait
     (format A) et 59,1 x 41,8 pt en paysage. */
  .pbox {
    width: var(--pbox);
    padding: calc(var(--pbox) * 0.17);
    box-sizing: border-box;
    aspect-ratio: 71.9 / 100.3;
    display: grid;
    grid-template-columns: 1fr;
    align-content: center;
    background: var(--surface);
    color: var(--blanc);
    flex: none;
  }
  .pbox--paysage {
    aspect-ratio: 59.1 / 41.8;
  }
  /* « Les textes comme le logo ne s'utilisent qu'en noir ou blanc » : sur les
     surfaces claires, le picto passe en noir pour rester lisible. */
  .pbox.s-papier,
  .pbox.s-blanc,
  .pbox.s-bleu-clair {
    color: var(--noir);
  }
  .pbox__in {
    width: 100%;
    line-height: 0;
  }
  .pbox__in :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
