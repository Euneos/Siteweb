    "astro": "^5.16.6",
    "jose": "^6.2.12",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
